---
extends: default

ignore: |
  .venv/
  vendor/
  .ansible/

rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: disable
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 220
    level: warning
