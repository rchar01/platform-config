    raise SystemExit("podman_host_package_nevra must be an exact x86_64 NEVRA")
volumes = values.get("gitlab_runner_docker_volumes", ["/cache"])
if not isinstance(volumes, list) or not volumes or any(not isinstance(item, str) or not item.startswith("/") or ":" in item for item in volumes):
    raise SystemExit("runner Docker volumes must be container-only absolute paths")
keys = values.get("users_ansible_authorized_keys", [])
if not isinstance(keys, list):
    raise SystemExit("users_ansible_authorized_keys must be a list")
selected = {
    "address": address,
    "become": True,
    "ca_path": values.get("gitlab_runner_tls_ca_cert_src", "") or "",
    "cloud_template": values.get("platform_host_aliases_cloud_init_template", "/etc/cloud/templates/hosts.redhat.tmpl"),
    "connection": connection,
    "environment": values.get("platform_environment", ""),
    "gitlab_url": url,
    "identity_file": values.get("ansible_ssh_private_key_file", "") or "",
    "keys_count": len(keys),
    "package_nevra": package,
    "port": port,
    "storage_member": target in data.get("storage_volume_hosts", {}).get("hosts", []),
    "storage_volumes": values.get("storage_volumes", []),
    "storage_layouts": values.get("storage_volume_layouts", []),
    "ssh_args": values.get("ansible_ssh_args", "") or "",
    "ssh_common_args": values.get("ansible_ssh_common_args", "") or "",
    "ssh_extra_args": values.get("ansible_ssh_extra_args", "") or "",
    "token_path": token,
    "user": user,
    "users_manage": values.get("users_manage_ansible_user", False) is True,
