  storage_member=$(json_value storage_member <"$selected_file")
  if [[ $storage_member == true ]]; then
    if ! storage_rows=$(python3 - "$selected_file" <<'PY'
import json, re, sys

with open(sys.argv[1], encoding="utf-8") as stream:
    selected = json.load(stream)
volumes = selected.get("storage_volumes", [])
layouts = selected.get("storage_layouts", [])
if not isinstance(volumes, list) or not volumes or not isinstance(layouts, list):
    raise SystemExit(1)
layout_map = {}
for layout in layouts:
    if not isinstance(layout, dict) or not isinstance(layout.get("name"), str):
        raise SystemExit(1)
    layout_map[layout["name"]] = layout
for layout in layouts:
    capacity = layout.get("capacity_gib", 0)
    required_free = layout.get("required_free_gib", 0)
    requested = [volume for volume in volumes if isinstance(volume, dict) and volume.get("layout") == layout["name"]]
    sizes = [volume.get("size_gib", 0) for volume in requested]
    if not requested or type(capacity) is not int or capacity <= 0 or type(required_free) is not int or required_free < 0:
        raise SystemExit(1)
    if any(type(size) is not int or size <= 0 for size in sizes) or sum(sizes) + required_free > capacity:
        raise SystemExit(1)
for volume in volumes:
    if not isinstance(volume, dict):
        raise SystemExit(1)
    if "layout" not in volume:
        raise SystemExit(1)
    layout = layout_map.get(volume["layout"])
    if layout is None:
        raise SystemExit(1)
    device = volume.get("device", layout.get("device", ""))
    mountpoint = volume.get("mountpoint", "")
    vg = volume.get("vg_name", layout.get("vg_name", ""))
    lv = volume.get("lv_name", "")
    initialize = volume.get("initialize", layout.get("initialize", False))
    reuse = layout.get("reuse_existing_vg", False)
    partition = volume.get("partition_number", layout.get("partition_number", 1))
    pv = volume.get("pv_device", layout.get("pv_device", f"{device}-part{partition}"))
    fstype = volume.get("fstype", "xfs")
    capacity = layout.get("capacity_gib", 0)
    size = volume.get("size_gib", 0)
    required_free = layout.get("required_free_gib", 0)
    values = (device, mountpoint, vg, lv, pv, fstype)
    if any(not isinstance(item, str) or not item or any(character in item for character in "\t\n\r") for item in values):
        raise SystemExit(1)
    if not re.match(r"^/dev/disk/by-(id|path)/.+", device):
        raise SystemExit(1)
    if not re.match(r"^/dev/disk/by-(id|path)/.+", pv):
        raise SystemExit(1)
    if not mountpoint.startswith("/") or not isinstance(initialize, bool) or not isinstance(reuse, bool):
        raise SystemExit(1)
    if type(capacity) is not int or not 0 <= capacity <= 1000000:
        raise SystemExit(1)
    if type(size) is not int or not 0 <= size <= 1000000:
        raise SystemExit(1)
    if type(required_free) is not int or not 0 <= required_free <= 1000000:
        raise SystemExit(1)
    if type(partition) is not int or partition <= 0:
        raise SystemExit(1)
    if layout and (capacity <= 0 or size <= 0 or size + required_free > capacity):
        raise SystemExit(1)
    print("\t".join((device, str(initialize).lower(), mountpoint, str(reuse).lower(), vg, lv, pv, fstype, str(capacity), str(size), str(required_free), str(partition))))
PY
    ); then
      fail "storage.inventory" "storage volumes are absent or use unsafe paths"
    else
      pass "storage.inventory" "storage host has valid volume definitions"
      if ! root_source=$(findmnt -n -o SOURCE / 2>/dev/null) || [[ $root_source != /dev/* ]]; then
        fail "storage.root-discovery" "root filesystem source is unavailable or not block-backed"
        storage_rows=""
      elif ! root_chain=$(lsblk -s -nrpo PATH "$root_source" 2>/dev/null) || [[ -z $root_chain ]]; then
        fail "storage.root-discovery" "could not resolve the root storage ancestor chain"
        storage_rows=""
      else
        pass "storage.root-discovery" "$root_source"
      fi
      root_vg=""
      if command -v lvs >/dev/null 2>&1; then
        root_vg=$(sudo lvs --noheadings -o vg_name "$root_source" 2>/dev/null | awk '{$1=$1; print}' || true)
      fi
      declare -A checked_devices=()
      declare -A vg_missing_bytes=()
      declare -A vg_headroom_bytes=()
      declare -A vg_extent_bytes=()
      while IFS=$'\t' read -r device initialize mountpoint reuse vg lv pv fstype capacity_gib size_gib required_free_gib partition; do
        [[ -n $device ]] || continue
        if [[ ! -b $device ]]; then
          fail "storage.device" "not a block device: $device"
          continue
        fi
        if [[ $device != /dev/disk/by-id/* && $device != /dev/disk/by-path/* ]]; then
          fail "storage.device" "unstable device path: $device"
          continue
        fi
        device_real=$(realpath --canonicalize-existing "$device" 2>/dev/null || true)
        if [[ -z $device_real ]]; then
          fail "storage.device" "cannot resolve stable device: $device"
          continue
        fi
        if ! candidate_chain=$(lsblk -s -nrpo PATH "$device" 2>/dev/null) || [[ -z $candidate_chain ]]; then
          fail "storage.device" "could not resolve candidate storage ancestors: $device"
          continue
        fi
        os_disk=false
        while IFS= read -r ancestor; do
          [[ -n $ancestor ]] || continue
          ancestor_real=$(realpath --canonicalize-existing "$ancestor" 2>/dev/null || true)
          if [[ -z $ancestor_real ]]; then
            fail "storage.os-disk" "could not canonicalize candidate ancestor: $ancestor"
            os_disk=true
            continue
          fi
          while IFS= read -r root_ancestor; do
            [[ -n $root_ancestor ]] || continue
            root_ancestor_real=$(realpath --canonicalize-existing "$root_ancestor" 2>/dev/null || true)
            if [[ -z $root_ancestor_real ]]; then
              fail "storage.os-disk" "could not canonicalize root ancestor: $root_ancestor"
              os_disk=true
            elif [[ $ancestor_real == "$root_ancestor_real" ]]; then
              os_disk=true
            fi
          done <<<"$root_chain"
        done <<<"$candidate_chain"
        if [[ $os_disk == true ]]; then
          fail "storage.os-disk" "$device intersects the root storage stack"
          continue
        fi
        pass "storage.os-disk" "$device is separate from the root storage stack"
        if [[ -z ${checked_devices[$device]:-} ]]; then
          checked_devices[$device]=true
          actual_bytes=$(lsblk -bdno SIZE "$device" 2>/dev/null | awk '{$1=$1; print}' || true)
          if [[ $actual_bytes =~ ^[0-9]+$ && $capacity_gib =~ ^[0-9]+$ ]]; then
            expected_bytes=$((capacity_gib * 1024 * 1024 * 1024))
            if ((capacity_gib == 0 || actual_bytes >= expected_bytes)); then
              pass "storage.capacity" "$device satisfies declared capacity"
            else
              fail "storage.capacity" "$device is smaller than declared capacity"
            fi
          else
            fail "storage.capacity" "could not read capacity for $device"
          fi
          if [[ $initialize == true ]]; then
            if ! topology_output=$(lsblk -nr -o TYPE "$device" 2>/dev/null); then
              fail "storage.new-device" "could not inspect topology for $device"
            elif [[ $topology_output != disk ]]; then
              fail "storage.new-device" "$device has child block devices"
            elif ! wipefs_output=$(sudo wipefs --no-act --noheadings --output TYPE,UUID,LABEL "$device" 2>/dev/null); then
              fail "storage.new-device" "wipefs could not inspect signatures on $device"
            elif [[ -n ${wipefs_output//[[:space:]]/} ]]; then
              fail "storage.new-device" "$device has filesystem, partition, RAID, or LVM signatures"
            else
              blkid_status=0
              blkid_output=$(sudo blkid "$device" 2>/dev/null) || blkid_status=$?
              if ((blkid_status == 2)) && [[ -z $blkid_output ]]; then
                pass "storage.new-device" "$device is an empty disk"
              elif ((blkid_status == 0)); then
                fail "storage.new-device" "$device has a blkid signature"
              else
                fail "storage.new-device" "blkid could not safely inspect $device"
              fi
            fi
          elif [[ $reuse != true ]]; then
            fail "storage.existing-layout" "$device requires explicit reuse_existing_vg: true"
          elif ! command -v pvs >/dev/null 2>&1 || ! command -v lvs >/dev/null 2>&1; then
            fail "storage.existing-layout" "pvs and lvs are required to verify existing VG reuse"
          elif [[ ! -b $pv ]]; then
            fail "storage.existing-layout" "declared PV does not exist: $pv"
          else
            pv_real=$(realpath --canonicalize-existing "$pv" 2>/dev/null || true)
            pv_type=$(lsblk -dnro TYPE "$pv" 2>/dev/null | awk '{$1=$1; print}' || true)
            pv_parent=$(lsblk -dnro PKNAME "$pv" 2>/dev/null | awk '{$1=$1; print}' || true)
            pv_partition=$(lsblk -dnro PARTN "$pv" 2>/dev/null | awk '{$1=$1; print}' || true)
            if [[ -n $pv_parent ]]; then
              pv_parent_real=$(realpath --canonicalize-existing "/dev/$pv_parent" 2>/dev/null || true)
            else
              pv_parent_real=""
            fi
            existing_vg=$(sudo pvs --noheadings -o vg_name "$pv" 2>/dev/null | awk '{$1=$1; print}' || true)
            existing_pvs=$(sudo pvs --noheadings -o pv_name --select "vg_name=$vg" 2>/dev/null | awk 'NF {count++} END {print count+0}' || true)
            extent_bytes=$(sudo vgs --units b --nosuffix --noheadings -o vg_extent_size "$vg" 2>/dev/null | awk '{printf "%.0f", $1}' || true)
            if [[ -n $pv_real && $pv_type == part && $pv_parent_real == "$device_real" && $pv_partition == "$partition" && $existing_vg == "$vg" && $existing_pvs == 1 && $vg != "$root_vg" && $extent_bytes =~ ^[1-9][0-9]*$ ]]; then
              vg_extent_bytes[$vg]=$extent_bytes
              pass "storage.existing-layout" "$pv is the declared partition and sole PV for non-root VG $vg"
            else
              fail "storage.existing-layout" "existing PV/VG ownership does not match the declared one-PV non-root layout"
            fi
          fi
        fi
        lv_path="/dev/$vg/$lv"
        if [[ -e $lv_path ]]; then
          existing_fstype=$(sudo blkid -o value -s TYPE "$lv_path" 2>/dev/null || true)
          if [[ $reuse == true && $existing_fstype == "$fstype" ]]; then
            pass "storage.logical-volume" "$lv_path has compatible filesystem state"
          elif [[ $reuse == true ]]; then
            fail "storage.logical-volume" "$lv_path must have the declared $fstype filesystem before reuse"
          elif [[ -z $existing_fstype || $existing_fstype == "$fstype" ]]; then
            pass "storage.logical-volume" "$lv_path has compatible filesystem state"
          else
            fail "storage.logical-volume" "$lv_path has $existing_fstype, expected $fstype"
          fi
          if [[ $reuse == true && $size_gib =~ ^[1-9][0-9]*$ ]]; then
            size_bytes=$(sudo lvs --units b --nosuffix --noheadings -o lv_size "$lv_path" 2>/dev/null | awk '{printf "%.0f", $1}' || true)
            requested_bytes=$((size_gib * 1024 * 1024 * 1024))
            extent_bytes=${vg_extent_bytes[$vg]:-0}
            if ((extent_bytes > 0)); then
              rounded_bytes=$(( (requested_bytes + extent_bytes - 1) / extent_bytes * extent_bytes ))
            else
              rounded_bytes=0
            fi
            if [[ $size_bytes =~ ^[0-9]+$ ]] && ((size_bytes == rounded_bytes && rounded_bytes > 0)); then
              pass "storage.logical-volume-size" "$lv_path exactly matches the extent-rounded declared size"
            else
              fail "storage.logical-volume-size" "$lv_path does not exactly match the extent-rounded declared size"
            fi
          fi
          mount_status=0
          mount_targets=$(findmnt -rn -S "$lv_path" -o TARGET 2>/dev/null) || mount_status=$?
          if ((mount_status == 1)); then
            pass "storage.logical-volume-mounts" "$lv_path is unmounted"
          elif ((mount_status != 0)); then
            fail "storage.logical-volume-mounts" "could not inspect mount targets for $lv_path"
          elif [[ -n $mount_targets ]] && ! grep -Fvx "$mountpoint" <<<"$mount_targets" | grep -q .; then
            pass "storage.logical-volume-mounts" "$lv_path is unmounted or only at $mountpoint"
          else
            fail "storage.logical-volume-mounts" "$lv_path is mounted outside $mountpoint"
          fi
        else
          pass "storage.logical-volume" "$lv_path will be created"
          if [[ $reuse == true && $size_gib =~ ^[1-9][0-9]*$ ]]; then
            requested_bytes=$((size_gib * 1024 * 1024 * 1024))
            extent_bytes=${vg_extent_bytes[$vg]:-0}
            if ((extent_bytes > 0)); then
              rounded_bytes=$(( (requested_bytes + extent_bytes - 1) / extent_bytes * extent_bytes ))
              vg_missing_bytes[$vg]=$(( ${vg_missing_bytes[$vg]:-0} + rounded_bytes ))
            else
              fail "storage.logical-volume-size" "cannot calculate missing LV allocation without a valid VG extent"
            fi
          fi
        fi
        if [[ $reuse == true && $required_free_gib =~ ^[0-9]+$ ]]; then
          required_bytes=$((required_free_gib * 1024 * 1024 * 1024))
          if (( ${vg_headroom_bytes[$vg]:-0} < required_bytes )); then
            vg_headroom_bytes[$vg]=$required_bytes
          fi
        fi
        if [[ ! -e $mountpoint && ! -L $mountpoint ]]; then
          pass "storage.mountpoint" "$mountpoint is absent"
        elif [[ -L $mountpoint || ! -d $mountpoint ]]; then
          fail "storage.mountpoint" "$mountpoint exists but is not a safe directory"
        else
          mount_content_status=0
          mount_content=$(sudo find "$mountpoint" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) || mount_content_status=$?
          if ((mount_content_status != 0)); then
            fail "storage.mountpoint" "could not inspect $mountpoint"
          elif [[ -n $mount_content ]]; then
            fail "storage.mountpoint" "$mountpoint is not empty"
          else
            pass "storage.mountpoint" "$mountpoint is empty"
          fi
        fi
      done <<<"$storage_rows"
      for vg in "${!vg_headroom_bytes[@]}"; do
        free_bytes=$(sudo vgs --units b --nosuffix --noheadings -o vg_free "$vg" 2>/dev/null | awk '{printf "%.0f", $1}' || true)
        required_bytes=$(( ${vg_missing_bytes[$vg]:-0} + ${vg_headroom_bytes[$vg]} ))
        if [[ $free_bytes =~ ^[0-9]+$ ]] && ((free_bytes >= required_bytes)); then
          pass "storage.vg-headroom" "$vg has required free space"
        else
          fail "storage.vg-headroom" "$vg lacks declared free space and missing-LV allocation headroom"
        fi
      done
    fi
  else
    pass "storage.root-model" "runner data remains on root; root capacity gate passed"
  fi

  for playbook in bootstrap.yml base-os.yml storage-volumes.yml container-runtime.yml gitlab-runners.yml; do
    if run_in_environment ansible-playbook -i "$container_inventory" "/workspace/playbooks/$playbook" --syntax-check --limit "$limit" >/dev/null 2>&1; then
      pass "playbook.syntax" "$playbook"
    else
      fail "playbook.syntax" "$playbook failed syntax validation"
    fi
  done
}

inspect_phase
case "$operation" in
  inspect) ;;
  build) build_phase ;;
  connect) connect_phase ;;
  all)
    build_phase
    connect_phase
    ;;
esac

summary
