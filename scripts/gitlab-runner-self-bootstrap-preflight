    raw = os.environ.get(name, "")
    try:
        tokens = shlex.split(raw)
    except ValueError:
        raise SystemExit(1)
    index = 0
    while index < len(tokens):
        token = tokens[index]
        option = ""
        if token == "-o":
            index += 1
            if index >= len(tokens):
