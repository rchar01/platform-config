for name, expected in expected_runner_identifiers.items():
    if values.get(name, expected) != expected:
        raise SystemExit(f"self-bootstrap requires default clean-state identifier: {name}")
url = values.get("gitlab_runner_gitlab_url", "")
if not isinstance(url, str) or not url.startswith("https://"):
    raise SystemExit("gitlab_runner_gitlab_url must use HTTPS")
token = values.get("gitlab_runner_token_src", "")
if not isinstance(token, str) or not token.startswith("/tmp/platform-home/.config/platform-infrastructure/"):
    raise SystemExit("runner token must resolve under the mounted outside-Git secret root")
