  elif PLATFORM_CONFIG_DEV_IMAGE="$dev_image" "$repo_root/scripts/in-container" python -c '
import ssl, sys, urllib.error, urllib.parse, urllib.request
url, ca = sys.argv[1:]
parsed = urllib.parse.urlsplit(url)
path = parsed.path.rstrip("/") + "/users/sign_in"
target = urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, path, "", ""))
