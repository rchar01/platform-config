#!/usr/bin/env bash
# shellcheck disable=SC2016  # Single-quoted snippets expand inside sh -c or Python.
set -uo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
repo_root=$(cd -- "$script_dir/.." && pwd -P)

usage() {
  printf '%s\n' \
    'Usage: gitlab-runner-self-bootstrap-preflight {inspect|build|connect|all} --env ENV --limit HOST --min-controller-free-gib N --min-root-free-gib N [--allow-dirty] [--connect-timeout SECONDS] [--connect-retries COUNT]' \
    'Operator-attended use only; do not run self-bootstrap from CI or automation.' >&2
}

die() {
  printf 'gitlab-runner-self-bootstrap-preflight: %s\n' "$1" >&2
  exit 2
}

passes=0
warnings=0
failures=0

pass() {
  passes=$((passes + 1))
  printf '[PASS] %-36s %s\n' "$1" "$2"
}

warn() {
  warnings=$((warnings + 1))
  printf '[WARN] %-36s %s\n' "$1" "$2"
}

fail() {
  failures=$((failures + 1))
  printf '[FAIL] %-36s %s\n' "$1" "$2" >&2
}

skip() {
  printf '[SKIP] %-36s %s\n' "$1" "$2"
}

summary() {
  printf '\nPassed: %d\nWarnings: %d\nFailed: %d\n' "$passes" "$warnings" "$failures"
  if ((failures == 0)); then
    printf 'Result: READY\n'
    return 0
  fi
  printf 'Result: NOT READY\n'
  return 1
}

require_command() {
  if command -v -- "$1" >/dev/null 2>&1; then
    pass "host.command.$1" "available"
  else
    fail "host.command.$1" "required command is missing"
  fi
}

check_worktree() {
  local label=$1 path=$2 commit worktree_status manifest_error git_root path_root
  path_root=$(realpath --canonicalize-existing "$path" 2>/dev/null || true)
  git_root=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null || true)
  git_root=$(realpath --canonicalize-existing "$git_root" 2>/dev/null || true)
  if [[ -n $path_root && $git_root == "$path_root" ]]; then
    if ! commit=$(git -C "$path" rev-parse --verify HEAD 2>/dev/null); then
      fail "repository.$label" "has no resolvable HEAD"
      return
    fi
    pass "repository.$label" "commit ${commit:0:12}"
    if ! worktree_status=$(git -C "$path" status --porcelain=v1 --untracked-files=normal 2>/dev/null); then
      fail "repository.$label.clean" "could not inspect worktree status"
    elif [[ -z $worktree_status ]]; then
      pass "repository.$label.clean" "worktree is clean"
    elif [[ $allow_dirty == true ]]; then
      warn "repository.$label.clean" "dirty worktree allowed explicitly"
    else
      fail "repository.$label.clean" "worktree is dirty; review it or use --allow-dirty"
    fi
    if git -C "$path" diff --check >/dev/null 2>&1; then
      pass "repository.$label.diff" "no whitespace errors"
    else
      fail "repository.$label.diff" "git diff --check failed"
    fi
  elif commit=$(python3 "$repo_root/scripts/gitlab-runner-self-bootstrap-manifest" verify --repository "$label" --tree "$path" 2>"$tmp_dir/manifest-$label.err"); then
    pass "repository.$label" "export commit ${commit:0:12}"
    pass "repository.$label.clean" "history-free export manifest is valid"
    pass "repository.$label.diff" "exported files match deterministic integrity metadata"
  else
    manifest_error=$(<"$tmp_dir/manifest-$label.err")
    fail "repository.$label" "not a clean Git worktree or valid export: ${manifest_error:-validation failed}"
  fi
}

check_space() {
  local label=$1 path=$2 minimum=$3 available_kib required_kib
  if [[ ! -e $path ]]; then
    fail "$label" "path does not exist: $path"
    return
  fi
  if ! available_kib=$(df -Pk -- "$path" 2>/dev/null | awk 'NR == 2 { print $4 }'); then
    fail "$label" "could not read free space for $path"
    return
  fi
  if [[ ! $available_kib =~ ^[0-9]+$ ]]; then
    fail "$label" "invalid free-space result for $path"
    return
  fi
  required_kib=$((minimum * 1024 * 1024))
  if ((available_kib >= required_kib)); then
    pass "$label" "$((available_kib / 1024 / 1024)) GiB free, minimum ${minimum} GiB"
  else
    fail "$label" "$((available_kib / 1024 / 1024)) GiB free, minimum ${minimum} GiB"
  fi
}

run_in_environment() {
  "$repo_root/scripts/in-container" sh -c \
    '. "$1"; shift; exec "$@"' \
    platform-self-bootstrap "$container_env_file" "$@"
}

json_value() {
  python3 -c '
import json, sys
value = json.load(sys.stdin)
for part in sys.argv[1].split("."):
    value = value.get(part) if isinstance(value, dict) else None
if value is None:
    print("")
elif isinstance(value, bool):
    print("true" if value else "false")
elif isinstance(value, (dict, list)):
    print(json.dumps(value, sort_keys=True, separators=(",", ":")))
else:
    print(value)
' "$1"
}

operation=""
environment=""
limit=""
min_controller_free_gib=""
min_root_free_gib=""
allow_dirty=false
connect_timeout=10
connect_retries=6

[[ $# -ge 1 ]] || { usage; exit 2; }
if [[ $1 == -h || $1 == --help ]]; then
  usage
  exit 0
fi
operation=$1
shift
case "$operation" in
  inspect|build|connect|all) ;;
  *) die "unsupported operation: $operation" ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env)
      [[ $# -ge 2 ]] || die "--env requires a value"
      environment=$2
      shift 2
      ;;
    --limit)
      [[ $# -ge 2 ]] || die "--limit requires a value"
      limit=$2
      shift 2
      ;;
    --min-controller-free-gib)
      [[ $# -ge 2 ]] || die "--min-controller-free-gib requires a value"
      min_controller_free_gib=$2
      shift 2
      ;;
    --min-root-free-gib)
      [[ $# -ge 2 ]] || die "--min-root-free-gib requires a value"
      min_root_free_gib=$2
      shift 2
      ;;
    --allow-dirty)
      allow_dirty=true
      shift
      ;;
    --connect-timeout)
      [[ $# -ge 2 ]] || die "--connect-timeout requires a value"
      connect_timeout=$2
      shift 2
      ;;
    --connect-retries)
      [[ $# -ge 2 ]] || die "--connect-retries requires a value"
      connect_retries=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) die "unexpected argument: $1" ;;
  esac
done

[[ $environment =~ ^[a-z][a-z0-9-]*$ ]] || die "--env must be a literal environment name"
[[ $limit =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "--limit must be one literal inventory hostname"
[[ $min_controller_free_gib =~ ^[1-9][0-9]*$ ]] || die "--min-controller-free-gib must be a positive integer"
[[ $min_root_free_gib =~ ^[1-9][0-9]*$ ]] || die "--min-root-free-gib must be a positive integer"
[[ $connect_timeout =~ ^[1-9][0-9]*$ ]] || die "--connect-timeout must be a positive integer"
[[ $connect_retries =~ ^[1-9][0-9]*$ ]] || die "--connect-retries must be a positive integer"
((min_controller_free_gib <= 1000000)) || die "--min-controller-free-gib is unreasonably large"
((min_root_free_gib <= 1000000)) || die "--min-root-free-gib is unreasonably large"
((connect_timeout <= 3600)) || die "--connect-timeout must not exceed 3600 seconds"
((connect_retries <= 100)) || die "--connect-retries must not exceed 100"

private_root=${PLATFORM_CONFIG_PRIVATE_ROOT:-$repo_root/../platform-private}
secret_root=${PLATFORM_CONFIG_SECRET_ROOT:-$HOME/.config/platform-infrastructure}
dev_image=${PLATFORM_CONFIG_DEV_IMAGE:-platform-config-dev:latest}
env_file="$private_root/config/$environment.ansible.env"
inventory="$private_root/config/inventories/$environment/hosts.yml"
container_env_file="/platform-private/config/$environment.ansible.env"
container_inventory="/platform-private/config/inventories/$environment/hosts.yml"
tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/runner-self-bootstrap.XXXXXXXX") || die "could not create temporary directory"
trap 'rm -rf "$tmp_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

inspect_phase() {
  local command_name path metadata podman_info podman_values graph_root os_id arch pid1 root_nevra unit_files rootful_containers

  printf '%s\n' '== Inspect host and repositories =='
  printf '%s\n' 'Output contains private host and storage metadata; do not publish it.'

  if ((EUID == 0)); then
    fail "host.user.nonroot" "run as the bootstrap account, not root"
  else
    pass "host.user.nonroot" "running as $(id -un)"
  fi
  if [[ -d ${HOME:-} && -w ${HOME:-} ]]; then
    pass "host.user.home" "writable home directory"
  else
    fail "host.user.home" "HOME is missing or not writable"
  fi

  for command_name in podman git make ssh ssh-keygen python3 sudo systemctl rpm dnf stat realpath df findmnt lsblk blkid wipefs ip getent timeout awk grep ps find sort uname; do
    require_command "$command_name"
  done

  for path in Containerfile.dev Makefile ansible.cfg requirements-dev.txt requirements-test.txt requirements.yml scripts/in-container scripts/gitlab-runner-self-bootstrap-manifest playbooks/bootstrap.yml playbooks/base-os.yml playbooks/storage-volumes.yml playbooks/container-runtime.yml playbooks/gitlab-runners.yml; do
    if [[ -f $repo_root/$path && ! -L $repo_root/$path ]]; then
      pass "repository.public.file" "$path"
    else
      fail "repository.public.file" "missing or symlinked: $path"
    fi
  done

  check_worktree public "$repo_root"

  if [[ -d $private_root && ! -L $private_root ]]; then
    private_root=$(realpath --canonicalize-existing "$private_root")
    pass "repository.private.path" "$private_root"
    check_worktree private "$private_root"
  else
    fail "repository.private.path" "missing or symlinked sibling repository: $private_root"
  fi

  for path in "$env_file" "$inventory"; do
    if [[ -f $path && ! -L $path ]]; then
      pass "private.file" "$path"
    else
      fail "private.file" "missing, non-regular, or symlinked: $path"
    fi
  done

  if [[ -d $secret_root && ! -L $secret_root ]]; then
    metadata=$(stat -Lc '%u:%a:%F' -- "$secret_root" 2>/dev/null || true)
    if [[ $metadata == "$(id -u):700:directory" ]]; then
      pass "secret.root" "current-user-owned mode 0700"
    else
      fail "secret.root" "must be current-user-owned mode 0700: $secret_root"
    fi
  else
    fail "secret.root" "missing or symlinked: $secret_root"
  fi

  if sudo -n true >/dev/null 2>&1; then
    pass "host.privilege.sudo" "passwordless sudo works"
  else
    fail "host.privilege.sudo" "sudo -n true failed"
  fi

  podman_info=$(podman info --format json 2>/dev/null || true)
  if [[ -n $podman_info ]] && podman_values=$(python3 -c '
import json, sys
data = json.load(sys.stdin)
host = data.get("host", {})
store = data.get("store", {})
security = host.get("security", {})
rootless = security.get("rootless", host.get("rootless", False))
graph = store.get("graphRoot", "")
driver = store.get("graphDriverName", "")
if rootless is not True or not graph or not driver:
    raise SystemExit(1)
print(graph)
print(driver)
' <<<"$podman_info" 2>/dev/null); then
    mapfile -t podman_fields <<<"$podman_values"
    graph_root=${podman_fields[0]:-}
    pass "controller.podman.rootless" "driver ${podman_fields[1]:-unknown}"
    check_space "capacity.controller" "$graph_root" "$min_controller_free_gib"
  else
    fail "controller.podman.rootless" "podman info did not report a usable rootless store"
    check_space "capacity.controller" "$repo_root" "$min_controller_free_gib"
  fi

  os_id=""
  if [[ -r /etc/os-release ]]; then
    os_id=$(sh -c '. /etc/os-release; printf "%s" "${ID:-}"' 2>/dev/null || true)
  fi
  if [[ $os_id == rocky ]]; then
    pass "host.os" "Rocky Linux"
  else
    fail "host.os" "expected Rocky Linux, found ${os_id:-unknown}"
  fi
  arch=$(uname -m 2>/dev/null || true)
  if [[ $arch == x86_64 ]]; then
    pass "host.architecture" "$arch"
  else
    fail "host.architecture" "expected x86_64, found ${arch:-unknown}"
  fi
  pid1=$(ps -p 1 -o comm= 2>/dev/null | awk '{$1=$1; print}' || true)
  if [[ $pid1 == systemd ]]; then
    pass "host.systemd" "systemd is PID 1"
  else
    fail "host.systemd" "systemd is not PID 1"
  fi
  if systemctl is-active --quiet sshd 2>/dev/null; then
    pass "host.sshd" "active"
  else
    fail "host.sshd" "sshd is not active"
  fi
  if python3 -c 'import sys; raise SystemExit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
    pass "host.python" "$(python3 --version 2>&1)"
  else
    fail "host.python" "Python 3.11 or newer is required for tomllib"
  fi

  check_space "capacity.root" / "$min_root_free_gib"

  if [[ -f /etc/logrotate.conf && ! -L /etc/logrotate.conf ]]; then
    pass "host.logrotate" "/etc/logrotate.conf exists"
  else
    fail "host.logrotate" "/etc/logrotate.conf is missing or unsafe"
  fi
  if [[ -f /etc/cloud/templates/hosts.redhat.tmpl ]]; then
    pass "host.cloud-init-template" "present"
  else
    warn "host.cloud-init-template" "absent; private inventory must disable template management"
  fi
  if [[ -d /sys/module/overlay ]] || grep -qw overlay /proc/filesystems 2>/dev/null || { command -v modinfo >/dev/null 2>&1 && modinfo overlay >/dev/null 2>&1; }; then
    pass "host.kernel.overlayfs" "available"
  else
    fail "host.kernel.overlayfs" "OverlayFS is unavailable or could not be verified"
  fi

  root_nevra=$(rpm -q --qf '%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}' podman 2>/dev/null || true)
  if [[ $root_nevra == podman-* ]]; then
    pass "host.podman.package" "$root_nevra"
  else
    fail "host.podman.package" "Podman is not installed as an RPM"
  fi

  if sudo test ! -e /etc/gitlab-runner/config.toml; then
    pass "runner.clean.config" "absent"
  else
    fail "runner.clean.config" "/etc/gitlab-runner/config.toml already exists"
  fi
  if sudo test ! -e /etc/containers/systemd/gitlab-runner.container; then
    pass "runner.clean.quadlet" "absent"
  else
    fail "runner.clean.quadlet" "runner Quadlet already exists"
  fi
  if unit_files=$(systemctl list-unit-files gitlab-runner.service --no-legend 2>/dev/null); then
    if grep -q '^gitlab-runner\.service' <<<"$unit_files"; then
      fail "runner.clean.service" "gitlab-runner.service already exists"
    else
      pass "runner.clean.service" "absent"
    fi
  else
    fail "runner.clean.service" "could not inspect systemd unit files"
  fi
  if sudo test ! -e /var/lib/containers/storage; then
    pass "runner.clean.container" "no rootful Podman storage exists"
  elif rootful_containers=$(sudo podman ps -a --format '{{.Names}}' 2>/dev/null); then
    if grep -Fxq gitlab-runner <<<"$rootful_containers"; then
      fail "runner.clean.container" "gitlab-runner container already exists"
    else
      pass "runner.clean.container" "absent"
    fi
  else
    fail "runner.clean.container" "could not inspect existing rootful containers"
  fi

  path=/etc/dnf/plugins/versionlock.list
  if sudo test ! -e "$path"; then
    pass "host.podman.versionlock" "absent"
  elif sudo test -f "$path" && ! sudo test -L "$path"; then
    metadata=$(sudo stat -Lc '%U:%G:%a:%F' -- "$path" 2>/dev/null || true)
    if [[ $metadata =~ ^root:root:[0-7]*[0145][0145]:regular\ file$ ]]; then
      pass "host.podman.versionlock" "safe root-owned regular file"
    else
      fail "host.podman.versionlock" "unsafe metadata: $metadata"
    fi
  else
    fail "host.podman.versionlock" "path is not a safe regular file"
  fi
}

build_phase() {
  local image_id mount_output
  printf '\n%s\n' '== Build and validate controller image =='
  if ((failures > 0)); then
    skip "controller.image.build" "inspect phase failed"
    return
  fi
  if make -C "$repo_root" container-build DEV_IMAGE="$dev_image"; then
    pass "controller.image.build" "fresh build completed"
  else
    fail "controller.image.build" "make container-build failed"
    return
  fi
  if PLATFORM_CONFIG_DEV_IMAGE="$dev_image" "$repo_root/scripts/in-container" ./scripts/check-dev-toolchain >/dev/null; then
    pass "controller.image.toolchain" "development toolchain is healthy"
  else
    fail "controller.image.toolchain" "toolchain check failed"
  fi
  if image_id=$(podman image inspect --format '{{.Id}}' "$dev_image" 2>/dev/null); then
    pass "controller.image.identity" "$image_id"
  else
    fail "controller.image.identity" "built image cannot be inspected"
  fi
  if mount_output=$(PLATFORM_CONFIG_DEV_IMAGE="$dev_image" "$repo_root/scripts/in-container" sh -c '
set -eu
test -f /workspace/Makefile
test -r "$1"
test -r /tmp/platform-home/.config/platform-infrastructure
private_options=$(findmnt -n -o OPTIONS -T /platform-private)
secret_options=$(findmnt -n -o OPTIONS -T /tmp/platform-home/.config/platform-infrastructure)
case ",$private_options," in *,ro,*) ;; *) exit 1 ;; esac
case ",$secret_options," in *,ro,*) ;; *) exit 1 ;; esac
' platform-self-bootstrap "$container_env_file" 2>&1); then
    pass "controller.image.mounts" "workspace available; private and secret mounts are read-only"
  else
    fail "controller.image.mounts" "container mount contract failed: ${mount_output:-no details}"
  fi
  if [[ -d $HOME/.ssh ]]; then
    if PLATFORM_CONFIG_DEV_IMAGE="$dev_image" "$repo_root/scripts/in-container" test -r /tmp/platform-home/.ssh >/dev/null 2>&1; then
      pass "controller.image.ssh" "SSH directory is visible read-only"
    else
      fail "controller.image.ssh" "SSH directory is not visible"
    fi
  fi
  if [[ -n ${SSH_AUTH_SOCK:-} && -S ${SSH_AUTH_SOCK:-} ]]; then
    if PLATFORM_CONFIG_DEV_IMAGE="$dev_image" "$repo_root/scripts/in-container" test -S /tmp/ssh-agent >/dev/null 2>&1; then
      pass "controller.image.agent" "forwarded agent socket is visible"
    else
      fail "controller.image.agent" "forwarded agent socket is not visible"
    fi
  else
    warn "controller.image.agent" "no forwarded SSH agent; inventory must select a readable key"
  fi
}

connect_phase() {
  local inventory_json selected_json selected_file list_output address user port connection become target_env
  local local_ips resolved_ips matched known_host_lookup config_json ssh_g ssh_error
  local attempt output token_path token_metadata ca_path ca_safe url package_nevra installed_nevra available_nevras
  local cloud_template users_manage keys_count identity_file identity_metadata identity_uid identity_mode identity_type
  local storage_member storage_rows root_source root_vg root_chain candidate_chain device initialize mountpoint reuse vg lv pv fstype capacity_gib size_gib required_free_gib partition
  local device_real ancestor ancestor_real root_ancestor root_ancestor_real actual_bytes expected_bytes existing_vg existing_pvs lv_path existing_fstype
  local topology_output wipefs_output blkid_output blkid_status os_disk size_bytes requested_bytes rounded_bytes mount_targets mount_status mount_content mount_content_status free_bytes required_bytes extent_bytes
  local pv_real pv_type pv_parent pv_parent_real pv_partition
  local -a effective_inventory_ssh_args

  printf '\n%s\n' '== Validate inventory and self-connection =='
  if ((failures > 0)); then
    skip "inventory.validation" "earlier phase failed"
    return
  fi
  if ! podman image exists "$dev_image" >/dev/null 2>&1; then
    fail "controller.image.present" "run the build operation first: $dev_image"
    return
  fi
  pass "controller.image.present" "$dev_image"

  if ! inventory_json=$(run_in_environment ansible-inventory -i "$container_inventory" --list 2>"$tmp_dir/inventory.err"); then
    fail "inventory.parse" "ansible-inventory failed"
    return
  fi
  printf '%s\n' "$inventory_json" >"$tmp_dir/inventory.json"
  chmod 0600 "$tmp_dir/inventory.json"
  if ! selected_json=$(python3 - "$limit" "$tmp_dir/inventory.json" <<'PY'
import json, re, shlex, sys

target = sys.argv[1]
with open(sys.argv[2], encoding="utf-8") as stream:
    data = json.load(stream)
hostvars = data.get("_meta", {}).get("hostvars", {})
if target not in hostvars:
    raise SystemExit("literal host is absent from inventory")
for group in ("rocky", "container_hosts", "gitlab_runners"):
    if target not in data.get(group, {}).get("hosts", []):
        raise SystemExit(f"host is not a member of required group: {group}")
values = hostvars[target]
connection = str(values.get("ansible_connection", "ssh") or "ssh")
if connection not in {"ssh", "ansible.builtin.ssh"}:
    raise SystemExit("ansible_connection must use SSH")
ssh_executable = str(values.get("ansible_ssh_executable", "") or "")
if ssh_executable and ssh_executable != "/usr/bin/ssh":
    raise SystemExit("ansible_ssh_executable must be /usr/bin/ssh when explicitly set")
address = values.get("ansible_host", target)
user = values.get("ansible_user", "")
port = values.get("ansible_port", 22)
if not isinstance(address, str) or not address or address.lower() == "localhost" or address.startswith("-") or any(character.isspace() or ord(character) < 32 or ord(character) == 127 for character in address):
    raise SystemExit("ansible_host is invalid")
if not isinstance(user, str) or not re.match(r"^[A-Za-z_][A-Za-z0-9_.-]*[$]?$", user):
    raise SystemExit("ansible_user is required")
if type(port) is not int or not 1 <= port <= 65535:
    raise SystemExit("ansible_port is invalid")
if values.get("ansible_become") is not True:
    raise SystemExit("ansible_become must be true")
unsafe_patterns = (
    r"strict\s*host\s*key\s*checking\s*(?:=|\s)\s*(?:no|false|off|0|accept-new)(?=\s|$)",
    r"user\s*known\s*hosts\s*file\s*(?:=|\s)\s*(?:/dev/null|none)(?=\s|$)",
)
for name in ("ansible_ssh_args", "ansible_ssh_common_args", "ansible_ssh_extra_args"):
    raw = str(values.get(name, "") or "")
    value = raw.lower()
    if any(re.search(pattern, value) for pattern in unsafe_patterns):
        raise SystemExit(f"unsafe SSH setting in {name}")
    try:
        tokens = shlex.split(raw)
    except ValueError as error:
        raise SystemExit(f"invalid SSH argument quoting in {name}: {error}") from error
    index = 0
    while index < len(tokens):
        token = tokens[index]
        option = ""
        if token == "-o":
            index += 1
            if index >= len(tokens):
                raise SystemExit(f"missing SSH -o value in {name}")
            option = tokens[index]
        elif token.startswith("-o"):
            option = token[2:]
        if option:
            key, separator, option_value = option.partition("=")
            normalized_key = key.lower()
            normalized_value = option_value.lower()
            if normalized_key == "stricthostkeychecking" and (not separator or normalized_value not in {"yes", "true", "ask"}):
                raise SystemExit(f"unsafe StrictHostKeyChecking in {name}")
            if normalized_key == "userknownhostsfile" and (not separator or normalized_value != "/tmp/platform-home/.ssh/known_hosts"):
                raise SystemExit(f"unsafe UserKnownHostsFile in {name}")
        index += 1
executor = values.get("gitlab_runner_executor", "")
manager_image = values.get("gitlab_runner_image", "")
docker_image = values.get("gitlab_runner_docker_image", "")
digest = re.compile(r"^[^\s@]+@sha256:[0-9a-f]{64}$")
if executor != "docker":
    raise SystemExit("gitlab_runner_executor must be docker")
if not digest.match(str(manager_image)) or not digest.match(str(docker_image)):
    raise SystemExit("runner manager and Docker fallback images must be digest-pinned")
if values.get("podman_host_socket_enabled") is not True or values.get("gitlab_runner_podman_socket_enabled") is not True:
    raise SystemExit("runner Docker mode requires the role-managed Podman socket")
if values.get("gitlab_runner_docker_pull_policy", "always") != "always":
    raise SystemExit("runner Docker pull policy must be always")
if values.get("gitlab_runner_docker_network_per_build", True) is not True:
    raise SystemExit("runner per-build networking must be enabled")
expected_runner_identifiers = {
    "gitlab_runner_config_dir": "/etc/gitlab-runner",
    "gitlab_runner_config_path": "/etc/gitlab-runner/config.toml",
    "gitlab_runner_container_name": "gitlab-runner",
    "gitlab_runner_quadlet_dir": "/etc/containers/systemd",
    "gitlab_runner_quadlet_name": "gitlab-runner.container",
    "gitlab_runner_quadlet_path": "/etc/containers/systemd/gitlab-runner.container",
    "gitlab_runner_service_name": "gitlab-runner.service",
