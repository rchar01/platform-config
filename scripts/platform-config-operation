#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf '%s\n' \
    'Usage: platform-config-operation OPERATION --inventory PATH --controller-vars PATH [--plan PATH] [--node HOST (storage routes only)]' \
    'Fixed operations: storage-check, storage-apply, openbao-storage-check, rke2-host-aliases-plan, rke2-host-aliases-apply, rke2-bootstrap-plan, rke2-converge-plan, rke2-bootstrap, rke2-deploy, rke2-deployment-runners-smoke, openbao-status, openbao-restart-plan, openbao-restart, openbao-converge-plan, openbao-deploy, openbao-haproxy-plan, openbao-haproxy-activate, openbao-keepalived-plan, openbao-keepalived-activate, openbao-smoke, openbao-vip-smoke, openbao-haproxy-failover-plan, openbao-haproxy-failover, openbao-haproxy-failover-recover' >&2
}

fail() {
  printf 'platform-config-operation: %s\n' "$1" >&2
  exit 2
}

require_private_file() {
  local name=$1
  local path=$2

  [[ $path == /* ]] || fail "$name must be an absolute path"
  [[ -f $path && ! -L $path ]] || fail "$name must be a regular non-symlink file"
}

require_owner_private_file() {
  local name=$1
  local path=$2
  local mode

  require_private_file "$name" "$path"
  [[ -O $path ]] || fail "$name must be owned by the current user"
  mode=$(stat -c '%a' -- "$path") || fail "$name mode is unavailable"
  (( (8#$mode & 077) == 0 )) || fail "$name must not be group- or world-readable"
}

require_summary_output() {
  local path=$1
  local parent
  local mode
  local path_identity
  local descriptor_identity

  [[ $path == /* ]] || fail "operation summary output must be an absolute path"
  [[ -f $path && ! -L $path ]] ||
    fail "operation summary output must be an existing regular non-symlink file"
  parent=${path%/*}
  [[ -n $parent ]] || parent=/
  [[ -d $parent && ! -L $parent ]] ||
    fail "operation summary output parent must be a non-symlink directory"
  mode=$(stat -c '%a' -- "$parent" 2>/dev/null) ||
    fail "operation summary output parent mode is unavailable"
  (( (8#$mode & 077) == 0 )) ||
    fail "operation summary output parent must not be accessible by group or other"

  if ! open_summary_output "$path" 2>/dev/null; then
    fail "operation summary output is not writable"
  fi
  path_identity=$(stat -c '%d:%i' -- "$path" 2>/dev/null) ||
    fail "operation summary output identity is unavailable"
  descriptor_identity=$(
    stat -Lc '%d:%i' -- "/proc/self/fd/$summary_output_fd" 2>/dev/null
  ) || fail "operation summary output identity is unavailable"
  [[ -f $path && ! -L $path && $path_identity == "$descriptor_identity" ]] ||
    fail "operation summary output changed during validation"
  if ! truncate_summary_output 2>/dev/null; then
    fail "operation summary output is not writable"
  fi
}

open_summary_output() {
  exec {summary_output_fd}>>"$1"
}

truncate_summary_output() {
  : >"/proc/self/fd/$summary_output_fd"
}

[[ $# -gt 0 ]] || {
  usage
  exit 2
}

operation=$1
shift
case "$operation" in
  storage-check | storage-apply | openbao-storage-check) ;;
  rke2-host-aliases-plan | rke2-host-aliases-apply) ;;
  rke2-deployment-runners-smoke) ;;
  openbao-haproxy-failover-plan | openbao-haproxy-failover | openbao-haproxy-failover-recover) ;;
  rke2-bootstrap-plan | rke2-converge-plan | rke2-bootstrap | rke2-deploy | openbao-status | openbao-restart-plan | openbao-restart | openbao-converge-plan | openbao-deploy | openbao-haproxy-plan | openbao-haproxy-activate | openbao-keepalived-plan | openbao-keepalived-activate | openbao-smoke | openbao-vip-smoke) ;;
  *) fail "unsupported operation: $operation" ;;
esac

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
summary_tool="$repo_root/scripts/platform-config-operation-summary"
summary_dir=
summary_events=
active_pid=
summary_output=
summary_output_fd=

if [[ ${PLATFORM_CONFIG_OPERATION_SUMMARY_OUTPUT+x} == x ]]; then
  summary_output=$PLATFORM_CONFIG_OPERATION_SUMMARY_OUTPUT
  require_summary_output "$summary_output"
fi

fallback_summary() {
  printf '%s\n' \
    '=== PLATFORM CONFIG OPERATION SUMMARY ===' \
    "Operation: $operation" \
    "Execution context: $([[ ${CI:-} == true ]] && printf 'GitLab Runner' || printf 'Operator controller')" \
    'Overall: FAIL' \
    'Selected VMs: none established' \
    '' \
    'Changed tasks:' \
    '  none' \
    '' \
    'Observed failed tasks:' \
    '  none' \
    '' \
    'Unreachable tasks:' \
    '  none' \
    '' \
    '=== END PLATFORM CONFIG OPERATION SUMMARY ==='
}

write_summary() {
  if [[ -n $summary_output_fd ]]; then
    printf '%s\n' "$1" >&"$summary_output_fd"
  else
    printf '%s\n' "$1"
  fi
}

finish() {
  local status=$?
  local render_status=0
  local cleanup_status=0
  local write_status=0
  local rendered_summary=
  local summary=

  trap - EXIT HUP INT TERM
  if [[ -n $active_pid ]]; then
    kill -s TERM "$active_pid" 2>/dev/null || true
    wait "$active_pid" 2>/dev/null || true
    active_pid=
  fi
  if [[ -n $summary_events && -f $summary_events ]]; then
    if rendered_summary=$(
      "$summary_tool" render --input "$summary_events" --status "$status"
    ); then
      render_status=0
    else
      render_status=$?
    fi
    if [[ -n $rendered_summary ]]; then
      summary=$rendered_summary
    else
      summary=$(fallback_summary)
    fi
  else
    render_status=2
    summary=$(fallback_summary)
  fi
  if ! write_summary "$summary"; then
    write_status=2
    printf '%s\n' 'platform-config-operation: summary output failed' >&2
  fi
  if [[ -n $summary_dir ]] && ! rm -rf -- "$summary_dir"; then
    cleanup_status=2
    printf '%s\n' 'platform-config-operation: summary cleanup failed' >&2
  fi
  if [[ $status -eq 0 && ( $render_status -ne 0 || $write_status -ne 0 || $cleanup_status -ne 0 ) ]]; then
    status=2
  fi
  exit "$status"
}

trap finish EXIT
umask 077
summary_dir=$(mktemp -d "${TMPDIR:-/tmp}/platform-config-operation.XXXXXXXX")
chmod 0700 "$summary_dir"
summary_events="$summary_dir/events.jsonl"
"$summary_tool" initialize --operation "$operation" --output "$summary_events"

export ANSIBLE_CALLBACK_PLUGINS="$repo_root/plugins/callback"
export ANSIBLE_CALLBACKS_ENABLED=platform_config_operation_summary
export ANSIBLE_LOAD_CALLBACK_PLUGINS=1
export PLATFORM_CONFIG_OPERATION_SUMMARY_PATH="$summary_events"

inventory=""
controller_vars=""
plan=""
node=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --inventory)
      [[ $# -ge 2 && -n $2 && -z $inventory ]] || fail "--inventory must be provided exactly once with a value"
      inventory=$2
      shift 2
      ;;
    --controller-vars)
      [[ $# -ge 2 && -n $2 && -z $controller_vars ]] || fail "--controller-vars must be provided exactly once with a value"
      controller_vars=$2
      shift 2
      ;;
    --plan)
      [[ $# -ge 2 && -n $2 && -z $plan ]] || fail "--plan must be provided exactly once with a value"
      plan=$2
      shift 2
      ;;
    --node)
      [[ $# -ge 2 && -n $2 && -z $node ]] || fail "--node must be provided exactly once with a value"
      node=$2
      shift 2
      ;;
    *) fail "unsupported argument: $1" ;;
  esac
done

[[ -n $inventory ]] || fail "--inventory is required"
[[ -n $controller_vars ]] || fail "--controller-vars is required"
if [[ $operation == storage-check || $operation == storage-apply || $operation == openbao-storage-check ]]; then
  [[ $node =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,254}$ && $node != all && $node != ungrouped ]] ||
    fail "$operation requires --node with one literal inventory hostname"
else
  [[ -z $node ]] || fail "--node is only accepted by storage-check, storage-apply or openbao-storage-check"
fi
require_private_file inventory "$inventory"
require_owner_private_file controller-vars "$controller_vars"
if [[ $operation == storage-apply || $operation == openbao-storage-check ]]; then
  "$summary_tool" storage-apply-controller-vars --input "$controller_vars" \
    --output "$summary_dir/controller-vars.json" --node "$node" ||
    fail "$operation controller-vars must be transport-only JSON"
  controller_vars="$summary_dir/controller-vars.json"
fi
if [[ $operation == rke2-host-aliases-plan || $operation == rke2-host-aliases-apply || $operation == rke2-deployment-runners-smoke ]]; then
  "$summary_tool" transport-controller-vars --input "$controller_vars" \
    --output "$summary_dir/controller-vars.json" ||
    fail "$operation controller-vars must be transport-only JSON"
  controller_vars="$summary_dir/controller-vars.json"
fi

case "$operation" in
  openbao-haproxy-failover-plan | openbao-haproxy-failover)
    [[ $plan == /* ]] || fail "failover plan/test requires one absolute --plan path"
    if [[ $operation == *-plan ]]; then
      [[ ! -e $plan && ! -L $plan ]] || fail "plan output already exists"
    else
      require_owner_private_file plan "$plan"
      [[ ${CI:-} == true || -t 0 ]] || fail "operator failover requires an interactive terminal"
    fi
    ;;
  openbao-haproxy-failover-recover)
    [[ -z $plan ]] || fail "failover recovery discovers retained target records; --plan is forbidden"
    [[ ${CI:-} == true || -t 0 ]] || fail "operator recovery requires an interactive terminal"
    ;;
  openbao-haproxy-plan | openbao-haproxy-activate | openbao-keepalived-plan | openbao-keepalived-activate)
    [[ $plan == /* ]] || fail "edge operations require one absolute --plan path"
    if [[ $operation == *-activate ]]; then
      require_owner_private_file plan "$plan"
      if [[ ${CI:-} != true && ! -t 0 ]]; then
        fail "operator activation requires an interactive terminal"
      fi
    else
      [[ ! -e $plan && ! -L $plan ]] || fail "plan output already exists"
    fi
    ;;
  *) [[ -z $plan ]] || fail "--plan is only accepted by edge plan/activation or failover plan/test routes" ;;
esac

export ANSIBLE_CONFIG="$repo_root/ansible.cfg"

extra_vars=(--extra-vars "@$controller_vars")
summary_host_args=()
if [[ $operation == storage-check || $operation == storage-apply || $operation == openbao-storage-check ]]; then
  summary_host_args=(--node "$node")
elif [[ $operation == rke2-host-aliases-plan || $operation == rke2-host-aliases-apply || $operation == rke2-deployment-runners-smoke ]]; then
  summary_host_args=(--controller-vars "$controller_vars")
fi

forward_signal() {
  local exit_status=$1

  trap - HUP INT TERM
  if [[ -n $active_pid ]]; then
    kill -s TERM "$active_pid" 2>/dev/null || true
    wait "$active_pid" 2>/dev/null || true
  fi
  exit "$exit_status"
}

run_command() {
  local status

  (
    unset PLATFORM_CONFIG_OPERATION_SUMMARY_OUTPUT
    if [[ -n $summary_output_fd ]]; then
      exec {summary_output_fd}>&-
    fi
    exec "$@"
  ) <&0 &
  active_pid=$!
  if wait "$active_pid"; then
    status=0
  else
    status=$?
  fi
  active_pid=
  return "$status"
}

trap 'forward_signal 129' HUP
trap 'forward_signal 130' INT
trap 'forward_signal 143' TERM

record_phase() {
  local phase=$1
  local state=$2
  local status=${3:-}

  if [[ $state == completed ]]; then
    "$summary_tool" phase --output "$summary_events" --phase "$phase" \
      --state "$state" --status "$status"
  else
    "$summary_tool" phase --output "$summary_events" --phase "$phase" \
      --state "$state"
  fi
}

initialize_hosts() {
  local phase=${1:-}
  local inventory_output="$summary_dir/inventory.json"
  local status

  : >"$inventory_output"
  chmod 0600 "$inventory_output"
  if [[ -n $phase ]]; then
    record_phase "$phase" started
    export PLATFORM_CONFIG_OPERATION_PHASE="$phase"
  else
    unset PLATFORM_CONFIG_OPERATION_PHASE
  fi
  if run_command ansible-inventory -i "$inventory" --list \
    "${extra_vars[@]}" >"$inventory_output"; then
    status=0
  else
    status=$?
  fi
  if [[ $status -eq 0 ]]; then
    if "$summary_tool" hosts --operation "$operation" \
      --inventory "$inventory_output" --output "$summary_events" "${summary_host_args[@]}"; then
      status=0
    else
      status=$?
    fi
  fi
  if ! rm -f -- "$inventory_output"; then
    status=2
  fi
  if [[ -n $phase ]]; then
    record_phase "$phase" completed "$status"
  fi
  return "$status"
}

run_phase() {
  local phase=$1
  local status
  shift

  record_phase "$phase" started
  export PLATFORM_CONFIG_OPERATION_PHASE="$phase"
  if run_command "$@"; then
    status=0
  else
    status=$?
  fi
  record_phase "$phase" completed "$status"
  return "$status"
}

ping_group() {
  local phase=$1
  local group=$2

  run_phase "$phase" ansible -i "$inventory" "$group" \
    -m ansible.builtin.ping \
    "${extra_vars[@]}"
}

run_playbook() {
  local phase=$1
  local playbook=$2
  local limit=$3
  shift 3

  run_phase "$phase" ansible-playbook -i "$inventory" "$repo_root/$playbook" \
    --limit "$limit" \
    "$@" \
    "${extra_vars[@]}"
}

require_phase_evidence() {
  # Fail before the next command even when Ansible exits zero with incomplete,
  # ignored, or rescued evidence. Final reporting still runs through finish.
  "$summary_tool" render --input "$summary_events" --status 0 --through "$1" >/dev/null
}

run_openbao_status() {
  local phase=$1
  local allow_desired_config_drift=$2

  case "$allow_desired_config_drift" in
    true | false) ;;
    *) return 2 ;;
  esac
  run_phase "$phase" ansible-playbook -i "$inventory" \
    "$repo_root/playbooks/maintenance/openbao-status.yml" \
    --limit openbao \
    "${extra_vars[@]}" \
    --extra-vars \
    "{\"openbao_active_preflight_allow_desired_config_drift\":$allow_desired_config_drift}"
}

run_openbao_roll() {
  local phase=$1
  shift

  run_phase "$phase" ansible-playbook -i "$inventory" \
    "$repo_root/playbooks/maintenance/openbao-rolling-restart.yml" \
    --limit openbao \
    "${extra_vars[@]}" \
    --extra-vars openbao_rolling_restart_confirm=true \
    "$@"
}

case "$operation" in
  rke2-deploy) initialize_hosts ;;
  *) initialize_hosts inventory ;;
esac

case "$operation" in
  openbao-storage-check)
    require_phase_evidence inventory
    ping_group connectivity "$node"
    require_phase_evidence connectivity
    run_playbook storage-check playbooks/storage-volumes.yml "$node" --check --diff
    ;;
  storage-check)
    ping_group connectivity "$node"
    run_playbook storage-check playbooks/storage-volumes.yml "$node" --check --diff
    ;;
  storage-apply)
    ping_group connectivity "$node"
    require_phase_evidence connectivity
    run_playbook storage-check playbooks/storage-volumes.yml "$node" --check --diff
    require_phase_evidence storage-check
    run_playbook storage-apply playbooks/storage-volumes.yml "$node"
    require_phase_evidence storage-apply
    # This is a real second apply, not a prediction or an automatic retry.
    run_playbook storage-idempotence playbooks/storage-volumes.yml "$node"
    require_phase_evidence storage-idempotence
    run_playbook storage-verify playbooks/maintenance/storage-volumes-verify.yml "$node"
    ;;
  rke2-host-aliases-plan | rke2-host-aliases-apply)
    require_phase_evidence inventory
    ping_group connectivity rke2_cluster
    require_phase_evidence connectivity
    run_playbook host-aliases-check playbooks/rke2-host-aliases.yml rke2_cluster --check --diff
    require_phase_evidence host-aliases-check
    if [[ $operation == rke2-host-aliases-apply ]]; then
      run_playbook host-aliases-apply playbooks/rke2-host-aliases.yml rke2_cluster
      require_phase_evidence host-aliases-apply
      run_playbook host-aliases-post-check playbooks/rke2-host-aliases.yml rke2_cluster --check --diff
      require_phase_evidence host-aliases-post-check
      run_playbook host-aliases-verify playbooks/rke2-host-aliases-verify.yml rke2_cluster
    fi
    ;;
  rke2-bootstrap-plan)
    ping_group connectivity rke2_cluster
    run_playbook bootstrap-preflight playbooks/rke2-bootstrap-preflight.yml rke2_cluster
    run_playbook rke2-plan playbooks/rke2.yml rke2_cluster --check --diff
    ;;
  rke2-deployment-runners-smoke)
    require_phase_evidence inventory
    ping_group connectivity rke2_cluster
    require_phase_evidence connectivity
    run_playbook rke2-deployment-runners-smoke playbooks/rke2-gitlab-deployment-runners-smoke.yml rke2_servers
    ;;
  rke2-converge-plan)
    ping_group connectivity rke2_cluster
    run_playbook core-health playbooks/rke2-core-health.yml rke2_cluster
    run_playbook convergence-preflight playbooks/rke2-convergence-preflight.yml rke2_cluster
    run_playbook rke2-plan playbooks/rke2.yml rke2_cluster --check --diff
    run_playbook kube-vip-plan playbooks/rke2-kube-vip.yml rke2_servers --check --diff
    run_playbook rke2-gitlab-runner-plan playbooks/rke2-gitlab-runner.yml rke2_servers --check --diff
    require_phase_evidence rke2-gitlab-runner-plan
    run_playbook rke2-deployment-runners-plan playbooks/rke2-gitlab-deployment-runners.yml rke2_servers --check --diff
    ;;
  rke2-bootstrap)
    ping_group connectivity rke2_cluster
    run_playbook bootstrap-preflight playbooks/rke2-bootstrap-preflight.yml rke2_cluster
    run_playbook rke2-apply playbooks/rke2.yml rke2_cluster
    run_playbook kube-vip-apply playbooks/rke2-kube-vip.yml rke2_servers
    run_playbook rke2-gitlab-runner-apply playbooks/rke2-gitlab-runner.yml rke2_servers
    require_phase_evidence rke2-gitlab-runner-apply
    run_playbook rke2-deployment-runners-apply playbooks/rke2-gitlab-deployment-runners.yml rke2_servers
    require_phase_evidence rke2-deployment-runners-apply
    run_playbook rke2-smoke playbooks/rke2-smoke.yml rke2_cluster
    run_playbook kube-vip-smoke playbooks/rke2-kube-vip-smoke.yml rke2_servers
    run_playbook rke2-gitlab-runner-smoke playbooks/rke2-gitlab-runner-smoke.yml rke2_servers
    require_phase_evidence rke2-gitlab-runner-smoke
    run_playbook rke2-deployment-runners-smoke playbooks/rke2-gitlab-deployment-runners-smoke.yml rke2_servers
    require_phase_evidence rke2-deployment-runners-smoke
    run_playbook rke2-post-check playbooks/rke2.yml rke2_cluster --check --diff
    run_playbook kube-vip-post-check playbooks/rke2-kube-vip.yml rke2_servers --check --diff
    run_playbook rke2-gitlab-runner-post-check playbooks/rke2-gitlab-runner.yml rke2_servers --check --diff
    run_playbook rke2-deployment-runners-post-check playbooks/rke2-gitlab-deployment-runners.yml rke2_servers --check --diff
    ;;
  rke2-deploy)
    run_playbook core-health playbooks/rke2-core-health.yml rke2_cluster
    run_playbook convergence-preflight playbooks/rke2-convergence-preflight.yml rke2_cluster
    run_playbook rke2-apply playbooks/rke2.yml rke2_cluster
    run_playbook kube-vip-apply playbooks/rke2-kube-vip.yml rke2_servers
    run_playbook rke2-gitlab-runner-apply playbooks/rke2-gitlab-runner.yml rke2_servers
    require_phase_evidence rke2-gitlab-runner-apply
    run_playbook rke2-deployment-runners-apply playbooks/rke2-gitlab-deployment-runners.yml rke2_servers
    require_phase_evidence rke2-deployment-runners-apply
    run_playbook rke2-smoke playbooks/rke2-smoke.yml rke2_cluster
    run_playbook kube-vip-smoke playbooks/rke2-kube-vip-smoke.yml rke2_servers
    run_playbook rke2-gitlab-runner-smoke playbooks/rke2-gitlab-runner-smoke.yml rke2_servers
    require_phase_evidence rke2-gitlab-runner-smoke
    run_playbook rke2-deployment-runners-smoke playbooks/rke2-gitlab-deployment-runners-smoke.yml rke2_servers
    require_phase_evidence rke2-deployment-runners-smoke
    run_playbook rke2-post-check playbooks/rke2.yml rke2_cluster --check --diff
    run_playbook kube-vip-post-check playbooks/rke2-kube-vip.yml rke2_servers --check --diff
    run_playbook rke2-gitlab-runner-post-check playbooks/rke2-gitlab-runner.yml rke2_servers --check --diff
    run_playbook rke2-deployment-runners-post-check playbooks/rke2-gitlab-deployment-runners.yml rke2_servers --check --diff
    ;;
  openbao-status)
    ping_group connectivity openbao
    run_openbao_status openbao-status false
    ;;
  openbao-haproxy-failover-plan | openbao-haproxy-failover | openbao-haproxy-failover-recover)
    mode='test'
    [[ $operation != *-plan ]] || mode=plan
    [[ $operation != *-recover ]] || mode=recover
    plan_vars=$(python3 -c 'import json,sys; print(json.dumps(dict(zip(("openbao_failover_mode", "openbao_failover_plan_path"), sys.argv[1:]))))' "$mode" "$plan")
    # The playbook inspects retained records before baseline smoke, so a stopped
    # owner can be recovered. No pre-route health gate may prevent restoration.
    run_phase "failover-$mode" ansible-playbook -i "$inventory" \
      "$repo_root/playbooks/maintenance/openbao-haproxy-failover.yml" \
      --limit openbao "${extra_vars[@]}" --extra-vars "$plan_vars"
    ;;
  openbao-haproxy-plan | openbao-haproxy-activate | openbao-keepalived-plan | openbao-keepalived-activate)
    edge=${operation#openbao-}
    edge=${edge%-*}
    mode=plan
      phase='edge-plan'
    if [[ $operation == *-activate ]]; then
      mode=interactive
      [[ ${CI:-} != true ]] || mode=ci
      phase='edge-activate'
    fi
    # Use JSON, not Ansible key=value parsing, for controller-owned path arguments.
    plan_vars=$(python3 -c 'import json,sys; print(json.dumps(dict(zip(("openbao_activation_mode", "openbao_activation_plan_path"), sys.argv[1:]))))' "$mode" "$plan")
    run_phase "$phase" ansible-playbook -i "$inventory" \
      "$repo_root/playbooks/maintenance/openbao-$edge-activate.yml" \
      --limit openbao "${extra_vars[@]}" --extra-vars "$plan_vars"
    ;;
  openbao-smoke | openbao-vip-smoke)
    run_playbook "$operation" "playbooks/$operation.yml" openbao
    ;;
  openbao-restart-plan)
    ping_group connectivity openbao
    run_openbao_status openbao-status false
    run_playbook openbao-restart-check playbooks/maintenance/openbao-active-check.yml openbao --check --diff
    ;;
  openbao-converge-plan)
    ping_group connectivity openbao
    run_openbao_status openbao-status true
    run_playbook openbao-converge-check playbooks/maintenance/openbao-active-check.yml openbao --check --diff
    ;;
  openbao-restart)
    ping_group connectivity openbao
    run_openbao_status openbao-status false
    run_openbao_roll openbao-roll --extra-vars openbao_rolling_force_restart=true
    run_openbao_status openbao-final-status false
    run_playbook openbao-post-check playbooks/maintenance/openbao-active-check.yml openbao --check --diff
    ;;
  openbao-deploy)
    ping_group connectivity openbao
    run_openbao_status openbao-status true
    run_openbao_roll openbao-roll
    run_openbao_status openbao-final-status false
    run_playbook openbao-post-check playbooks/maintenance/openbao-active-check.yml openbao --check --diff
    ;;
esac
