---
# Keep the staging gate false until storage, PKI, network, package, and source
# policy inputs satisfy every role assertion. Staging owns configuration while
# all three services remain disabled and stopped.
openbao_orchestration_ready: false
openbao_enabled: false
openbao_service_enabled: false
openbao_service_state: stopped
openbao_bootstrap_ready: false
openbao_bootstrap_complete_ready: false
openbao_image_registry: ghcr.io/openbao/openbao
openbao_image_digest: sha256:15e90b578c970ae57b596ed51295380cd54f93860fe36758f05b455d71aae0e0
openbao_service_dns: bao.example.invalid
openbao_service_vip: 192.0.2.200
openbao_client_port: 8200
openbao_backend_port: 18200
openbao_cluster_port: 8201
openbao_haproxy_enabled: false
openbao_haproxy_package_nevra: ""
openbao_haproxy_service_enabled: false
openbao_haproxy_service_state: stopped
openbao_haproxy_activation_ready: false
openbao_haproxy_client_allowed_sources: []
openbao_haproxy_stats_allowed_sources:
  - 127.0.0.1/32
keepalived_vip_enabled: false
keepalived_vip_package_nevra: ""
keepalived_vip_service_enabled: false
keepalived_vip_service_state: stopped
keepalived_vip_preempt_delay: 300
keepalived_vip_track_service: haproxy.service
keepalived_vip_track_ports:
  - 8200
keepalived_vip_cluster_members:
  - name: openbao-example-01
    router_id: bao-vrrp-1
    instances:
      OPENBAO:
        source_address: 192.0.2.63
        priority: 150
  - name: openbao-example-02
    router_id: bao-vrrp-2
    instances:
      OPENBAO:
        source_address: 192.0.2.72
        priority: 140
  - name: openbao-example-03
    router_id: bao-vrrp-3
    instances:
      OPENBAO:
        source_address: 192.0.2.74
        priority: 130
openbao_tls_ca_src: "{{ lookup('ansible.builtin.env', 'PLATFORM_INFRASTRUCTURE_CONFIG_DIR') | dirname }}/pki/export/ansible/ca/root-ca.crt"
openbao_backend_allowed_sources: []
openbao_cluster_members:
  - name: openbao-example-01
    node_id: bao-1
    address: 192.0.2.63
    dns: bao-1.internal.invalid
  - name: openbao-example-02
    node_id: bao-2
    address: 192.0.2.72
    dns: bao-2.internal.invalid
  - name: openbao-example-03
    node_id: bao-3
    address: 192.0.2.74
    dns: bao-3.internal.invalid

# Host-local OpenBao PKI remains denied until private inventory supplies every
# reviewed outside-Git trust, GitLab package, transport-client, and CA input.
# Do not replace empty digests with illustrative values that could validate.
pki_host_local_certificate_service: "openbao-{{ inventory_hostname }}"
pki_host_local_certificate_target: "{{ inventory_hostname }}"
pki_host_local_certificate_operation: issue
pki_host_local_certificate_inventory_sha256: ""
pki_host_local_certificate_current_cert_sha256: none
pki_host_local_certificate_current_cert_path: ""
pki_host_local_certificate_requester_principal: "{{ inventory_hostname }}"
pki_host_local_certificate_response_principal: ""
pki_host_local_certificate_common_name: "{{ openbao_node_dns }}"
pki_host_local_certificate_dns_sans:
  - "{{ openbao_service_dns }}"
  - "{{ openbao_node_dns }}"
pki_host_local_certificate_ip_sans:
  - "{{ openbao_node_address }}"
pki_host_local_certificate_trust_id: ""
pki_host_local_certificate_trust_paths: {}
pki_host_local_certificate_trust_sha256: {}
pki_host_local_certificate_trust_sources: {}
pki_host_local_certificate_state_root: /var/lib/platform-config/pki/openbao
pki_host_local_certificate_pending_root: /etc/openbao/tls-pending
pki_host_local_certificate_versions_root: /etc/openbao/tls-versions
pki_host_local_certificate_gitlab_project_record_source: ""
pki_host_local_certificate_gitlab_ca_source: ""
pki_host_local_certificate_platform_pki_source: ""
pki_host_local_certificate_platform_pki_sha256: ""
pki_host_local_certificate_reviewed_ca_source: ""
pki_host_local_certificate_reviewed_ca_target_path: /etc/platform-config/openbao-validation-ca.crt
pki_host_local_certificate_reviewed_ca_sha256: ""
pki_host_local_certificate_reviewed_ca_mode: ""
pki_host_local_certificate_minimum_remaining_lifetime_seconds: 0
pki_host_local_certificate_rollback_seconds: 0
pki_host_local_certificate_endpoint: ""
pki_host_local_certificate_service_adapter: openbao-pristine-v1
pki_host_local_certificate_service_unit: openbao.service
pki_host_local_certificate_service_config_path: /etc/openbao/listener.hcl
pki_host_local_certificate_openbao_node_dns: "{{ openbao_node_dns }}"
pki_host_local_certificate_openbao_node_address: "{{ openbao_node_address }}"

# Fresh OpenBao hosts can stage the observer roles after the monitoring VIP,
# authenticated endpoints, remote-write receiver, and outside-Git identities
# exist. Keep activation false for the first apply. The observer playbook derives
# all service and timer states from this single selector.
openbao_observers_orchestration_ready: false
openbao_observers_activate: false
platform_external_probe_enabled: false
platform_external_probe_observer_id: "{{ inventory_hostname }}"
platform_external_probe_targets:
  - name: grafana_health
    service: grafana
    profile: grafana_health
    address: https://192.0.2.201/api/health
    address_mode: vip
    server_name: grafana.monitoring.example.invalid
    host_header: grafana.monitoring.example.invalid
    ca_file: /etc/platform-pki/monitoring-ca.crt
    client_cert_file: "/run/platform-secrets/monitoring-probe-{{ inventory_hostname }}.crt"
    client_key_file: "/run/platform-secrets/monitoring-probe-{{ inventory_hostname }}.key"
  - name: loki_ready
    service: loki
    profile: loki_ready
    address: https://192.0.2.201/ready
    address_mode: vip
    server_name: loki.monitoring.example.invalid
    host_header: loki.monitoring.example.invalid
    ca_file: /etc/platform-pki/monitoring-ca.crt
    client_cert_file: "/run/platform-secrets/monitoring-probe-{{ inventory_hostname }}.crt"
    client_key_file: "/run/platform-secrets/monitoring-probe-{{ inventory_hostname }}.key"
  - name: mimir_ready
    service: mimir
    profile: mimir_ready
    address: https://192.0.2.201/ready
    address_mode: vip
    server_name: mimir.monitoring.example.invalid
    host_header: mimir.monitoring.example.invalid
    ca_file: /etc/platform-pki/monitoring-ca.crt
    client_cert_file: "/run/platform-secrets/monitoring-probe-{{ inventory_hostname }}.crt"
    client_key_file: "/run/platform-secrets/monitoring-probe-{{ inventory_hostname }}.key"
platform_external_probe_vip_ownership: []
platform_external_probe_postgresql_primary:
  name: postgresql_primary
  service: postgresql
  address_mode: vip
  host: postgres.monitoring.example.invalid
  port: 5432
  database: observer
  user: monitoring_probe
  ca_file: /etc/platform-pki/monitoring-ca.crt
  client_cert_file: "/run/platform-secrets/postgresql-probe-{{ inventory_hostname }}.crt"
  client_key_file: "/run/platform-secrets/postgresql-probe-{{ inventory_hostname }}.key"
platform_external_probe_garage_canary:
  name: garage_canary
  service: garage
  address_mode: vip
  host: s3.monitoring.example.invalid
  port: 443
  region: garage
  bucket: "observer-canary-{{ inventory_hostname }}"
  object_key: "canary/{{ inventory_hostname }}"
  ca_file: /etc/platform-pki/monitoring-ca.crt
  client_cert_file: "/run/platform-secrets/garage-{{ inventory_hostname }}.crt"
  client_key_file: "/run/platform-secrets/garage-{{ inventory_hostname }}.key"
  credentials_file: "/run/platform-secrets/garage-{{ inventory_hostname }}.json"
grafana_alloy_enabled: false
grafana_alloy_prometheus_remote_write_url: https://mimir.monitoring.example.invalid/api/v1/push
grafana_alloy_prometheus_remote_write_ca_file: /etc/platform-pki/monitoring-ca.crt
grafana_alloy_prometheus_remote_write_server_name: mimir.monitoring.example.invalid
grafana_alloy_prometheus_remote_write_client_cert_file: "/run/platform-secrets/monitoring-writer-{{ inventory_hostname }}.crt"
grafana_alloy_prometheus_remote_write_client_key_file: "/run/platform-secrets/monitoring-writer-{{ inventory_hostname }}.key"
