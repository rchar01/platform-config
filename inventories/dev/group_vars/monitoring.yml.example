---
# Combined monitoring convergence remains blocked. The focused HAProxy staging
# playbook also remains inert until its explicit orchestration gate is enabled.
monitoring_service_vip: 192.0.2.201
monitoring_grafana_dns: grafana.monitoring.example.invalid
monitoring_loki_dns: loki.monitoring.example.invalid
monitoring_mimir_dns: mimir.monitoring.example.invalid
monitoring_s3_dns: s3.monitoring.example.invalid
monitoring_alertmanager_dns: alertmanager.monitoring.example.invalid
monitoring_postgres_dns: postgres.monitoring.example.invalid
monitoring_keepalived_enabled: false
keepalived_vip_enabled: false
keepalived_vip_package_nevra: ""
keepalived_vip_service_enabled: false
keepalived_vip_service_state: stopped
keepalived_vip_preempt_delay: 300
keepalived_vip_track_service: haproxy.service
keepalived_vip_track_ports:
  - 443
  - 5432
keepalived_vip_cluster_members:
  - name: monitoring-example-01
    router_id: monitoring-vrrp-1
    instances:
      MONITORING:
        source_address: 192.0.2.64
        priority: 150
  - name: monitoring-example-02
    router_id: monitoring-vrrp-2
    instances:
      MONITORING:
        source_address: 192.0.2.75
        priority: 140
  - name: monitoring-example-03
    router_id: monitoring-vrrp-3
    instances:
      MONITORING:
        source_address: 192.0.2.76
        priority: 130
monitoring_haproxy_orchestration_ready: false
monitoring_haproxy_contract_ready: false
monitoring_haproxy_enabled: false
monitoring_haproxy_service_enabled: false
monitoring_haproxy_service_state: stopped
# Dedicated Patroni etcd staging remains inert until private inventory supplies
# reviewed topology, PKI source paths, and an explicit orchestration approval.
monitoring_etcd_orchestration_ready: false
monitoring_etcd_bootstrap_preflight_ready: false
monitoring_etcd_bootstrap_ready: false
monitoring_etcd_contract_ready: false
monitoring_etcd_enabled: false
monitoring_etcd_converge: false
monitoring_etcd_service_enabled: false
monitoring_etcd_service_state: stopped
monitoring_etcd_data_fstype: xfs
monitoring_etcd_data_mount_source: ""
monitoring_etcd_bootstrap_require_selinux_enforcing: true
monitoring_etcd_firewalld_manage: true
monitoring_etcd_selinux_manage: true
monitoring_etcd_initial_cluster_token: ""
monitoring_etcd_tls_ca_src: ""
monitoring_etcd_tls_cert_src: ""
monitoring_etcd_tls_key_src: ""
monitoring_etcd_client_allowed_sources: []
monitoring_etcd_cluster_members:
  - name: monitoring-1
    address: 192.0.2.64
    dns: monitoring-1.internal.invalid
  - name: monitoring-2
    address: 192.0.2.75
    dns: monitoring-2.internal.invalid
  - name: monitoring-3
    address: 192.0.2.76
    dns: monitoring-3.internal.invalid
# Private inventory must provide exact service and health ports. TLS backends use
# three named canonical-IPv4 targets with lowercase FQDN TLS identities;
# node-local Garage S3 uses one 127.0.0.1 target without a TLS identity and a
# separate Garage Admin health port. PostgreSQL uses a separate Patroni REST
# health port. Integrated Alertmanager uses the exact Mimir port and topology.
monitoring_haproxy_backends: {}
