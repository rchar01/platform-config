---
platform_os_family: rocky

ssh_server_package: openssh-server
ssh_service_name: sshd

chrony_service_name: chronyd
nfs_client_package: nfs-utils

# Firewalld tooling remains installed for permanent offline rule management.
# The daemon is disabled at boot and stopped at runtime.
firewalld_service_enabled: false
firewalld_service_state: stopped
