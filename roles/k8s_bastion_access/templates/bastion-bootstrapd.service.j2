[Unit]
Description=Bastion bootstrap daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={{ k8s_bastion_sbin_dir }}/bastion-bootstrapd
Restart=on-failure
RestartSec=2
RuntimeDirectory=bastion-bootstrapd
RuntimeDirectoryMode=0750
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/run/bastion-bootstrapd /home /var/lib/bastion/bootstrap-tokens
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
