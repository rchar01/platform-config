[Unit]
Description=GitLab Runner
Wants={{ gitlab_runner_quadlet_wants }}
After={{ gitlab_runner_quadlet_after }}
RequiresMountsFor={{ gitlab_runner_config_dir }} {{ gitlab_runner_data_dir }}{% if podman_host_storage_contract_enabled | default(false) | bool %} {{ podman_host_storage_mountpoint }}{% endif %}
{% if gitlab_runner_podman_socket_enabled | bool %}
Requires={{ podman_host_socket_name | default('podman.socket') }}
After={{ podman_host_socket_name | default('podman.socket') }}
{% endif %}

[Container]
Image={{ gitlab_runner_image }}
ContainerName={{ gitlab_runner_container_name }}
Volume={{ gitlab_runner_config_dir }}:/etc/gitlab-runner:{{ gitlab_runner_quadlet_volume_label }}
Volume={{ gitlab_runner_data_dir }}:/home/gitlab-runner:{{ gitlab_runner_quadlet_volume_label }}
{% if gitlab_runner_podman_socket_enabled | bool %}
Volume={{ gitlab_runner_podman_socket_host_path }}:{{ gitlab_runner_podman_socket_container_path }}
SecurityLabelDisable=true
{% endif %}

[Service]
Restart={{ gitlab_runner_quadlet_restart_policy }}

[Install]
WantedBy=multi-user.target
