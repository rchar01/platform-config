ui = {{ openbao_ui_enabled | bool | lower }}
api_addr = "{{ openbao_api_addr }}"
cluster_addr = "{{ openbao_cluster_addr }}"
log_level = "{{ openbao_log_level }}"
log_format = "{{ openbao_log_format }}"

storage "raft" {
  path = "{{ openbao_container_data_dir }}"
  node_id = "{{ openbao_node_id }}"
}

listener "tcp" {
  address = "{{ openbao_listener_address }}:{{ openbao_container_port }}"
  cluster_address = "{{ openbao_listener_address }}:{{ openbao_cluster_port }}"
{% if openbao_tls_enabled | bool %}
  tls_cert_file = "{{ openbao_tls_cert_path }}"
  tls_key_file = "{{ openbao_tls_key_path }}"
  tls_min_version = "{{ openbao_tls_min_version }}"
{% else %}
  tls_disable = true
{% endif %}
}
{% if openbao_extra_config | length > 0 %}

{{ openbao_extra_config }}
{% endif %}
