#!/usr/bin/env python3
"""Root-only durable HAProxy fault intent; execute with python -c SOURCE ACTION.

JSON stdin: inspect {host, plan_id?}; all other actions {host, plan, nonce},
finish additionally {smoke_verified: true}. JSON stdout is private (no_log).
This helper never invokes services. Only a successful arm response authorizes
one stop on the planned owner. Lost responses/interruption never authorize retry.

Claim all hosts before arming; prove/fail all after the caller's global proof;
restore all owned records before service start; finish only after full smoke.
Recovery must inspect all hosts and validate the retained plan at the controller.
All present records must have the same exact plan/nonce and their own host name.
Absent hosts remain absent. Partial acquisition is recoverable only if present
records are claimed, or failed restoring/closed records from that cleanup; an
armed/proven record plus any absent host is inconsistent and blocks automation.
Foreign/unknown/incomplete state also requires separately reviewed root recovery,
never guessed unlocks. The caller must enforce this all-host gate before start.
The mutex/active namespace interoperates with platform-openbao-edge-guard.
Consumption records are permanent, including failed, interrupted and closed runs.
"""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import sys
import time
import uuid

ROOT = Path('/var/lib/platform-config/openbao-edge-guard')
MAX_BYTES = 256 * 1024
RECORD_BYTES = MAX_BYTES + 4096
OPERATION = 'haproxy-failover'
PHASES = {'claimed', 'armed', 'failover-proven', 'restoring', 'closed'}


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(',', ':'),
                      ensure_ascii=True, allow_nan=False).encode()


def pairs(items):
    result = {}
    for key, value in items:
        if key in result:
            raise ValueError('duplicate JSON key')
        result[key] = value
    return result


def matches(pattern, value):
    return isinstance(value, str) and re.fullmatch(pattern, value) is not None


def validate_plan(plan):
    keys = {'schema', 'operation', 'plan_id', 'nonce', 'created', 'expires', 'hosts',
            'context', 'owner', 'service', 'evidence', 'digest'}
    if (not isinstance(plan, dict) or set(plan) != keys
            or type(plan['schema']) is not int or plan['schema'] != 1
            or plan['operation'] != OPERATION or plan['service'] != 'haproxy.service'
            or not all(matches('[0-9a-f]{32}', plan[k]) for k in ('plan_id', 'nonce'))
            or type(plan['created']) is not int or type(plan['expires']) is not int
            or plan['created'] < 0 or plan['expires'] - plan['created'] != 1800):
        raise ValueError('invalid failover plan schema')
    hosts = plan['hosts']
    if (not isinstance(hosts, list) or len(hosts) != 3
            or not all(matches('[A-Za-z0-9_][A-Za-z0-9_.-]{0,252}', h) for h in hosts)
            or len(set(hosts)) != 3 or hosts != sorted(hosts) or plan['owner'] not in hosts
            or not isinstance(plan['evidence'], dict) or not plan['evidence']):
        raise ValueError('invalid failover hosts/owner/evidence')
    ctx = plan['context']
    if (not isinstance(ctx, dict) or set(ctx) != {'config_sha', 'private_sha', 'inventory',
            'environment', 'lane', 'project', 'pipeline', 'image', 'plan_job'}
            or not all(matches('[0-9a-f]{40}', ctx[k]) for k in ('config_sha', 'private_sha'))
            or not matches('[A-Za-z0-9_.-]{1,64}', ctx['environment'])
            or not isinstance(ctx['inventory'], str) or not ctx['inventory']
            or ctx['inventory'].startswith('/') or '..' in ctx['inventory'].split('/')):
        raise ValueError('invalid failover source identity')
    if ctx['lane'] == 'operator':
        if any(ctx[k] != '' for k in ('project', 'pipeline', 'image', 'plan_job')):
            raise ValueError('invalid operator identity')
    elif ctx['lane'] == 'gitlab':
        if (not all(matches('[1-9][0-9]*', ctx[k]) for k in ('project', 'pipeline'))
                or not matches(r'[^\s]+@sha256:[0-9a-f]{64}', ctx['image'])
                or not matches('[A-Za-z0-9_.-]+-haproxy-failover-plan', ctx['plan_job'])
                or len(ctx['plan_job']) > 128):
            raise ValueError('invalid GitLab identity')
    else:
        raise ValueError('unknown lane')
    body = {k: v for k, v in plan.items() if k != 'digest'}
    if len(canonical(plan)) > MAX_BYTES or plan['digest'] != hashlib.sha256(canonical(body)).hexdigest():
        raise ValueError('invalid plan digest/size')


def _directory(path, private=False):
    info = path.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) & 0o022
            or (private and stat.S_IMODE(info.st_mode) != 0o700)):
        raise ValueError('unsafe guard directory')


def _file(path, flags):
    fd = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1
            or info.st_size > RECORD_BYTES):
        os.close(fd)
        raise ValueError('unsafe guard record')
    return fd


def _read(path):
    with os.fdopen(_file(path, os.O_RDONLY), 'rb') as stream:
        data = stream.read(RECORD_BYTES + 1)
    if len(data) > RECORD_BYTES:
        raise ValueError('oversized guard record')
    return json.loads(data, object_pairs_hook=pairs)


def _sync(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _write(path, value, replace=False):
    data = canonical(value)
    if len(data) > RECORD_BYTES:
        raise ValueError('oversized guard record')
    if replace:
        # Check existing file before replacement; never follow or repair it.
        os.close(_file(path, os.O_RDONLY))
    elif os.path.lexists(path):
        raise ValueError('record already exists')
    temporary = path.parent / ('.pending-' + uuid.uuid4().hex)
    with os.fdopen(_file(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL), 'wb') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    os.rename(temporary, path)
    _sync(path.parent)


def _record(value):
    if (not isinstance(value, dict) or set(value) != {'schema', 'plan', 'nonce', 'host', 'phase', 'outcome'}
            or type(value['schema']) is not int or value['schema'] != 1):
        raise ValueError('unknown transaction record')
    validate_plan(value['plan'])
    if (value['nonce'] != value['plan']['nonce'] or value['host'] not in value['plan']['hosts']
            or value['phase'] not in PHASES or value['outcome'] not in {'pending', 'proven', 'failed'}
            or (value['phase'] in {'claimed', 'armed'} and value['outcome'] not in {'pending', 'failed'})
            or (value['phase'] == 'armed' and value['host'] != value['plan']['owner'])
            or (value['phase'] == 'failover-proven' and value['outcome'] != 'proven')
            or (value['phase'] in {'restoring', 'closed'} and value['outcome'] == 'pending')):
        raise ValueError('invalid transaction phase/outcome')
    return value


def _owner(record):
    return {'operation': OPERATION, 'plan_id': record['plan']['plan_id'], 'nonce': record['nonce']}


def guard(action, request):
    if action not in {'inspect', 'claim', 'arm', 'prove', 'fail', 'restore', 'finish'}:
        raise ValueError('unsupported action')
    if not isinstance(request, dict) or not matches('[A-Za-z0-9_][A-Za-z0-9_.-]{0,252}', request.get('host')):
        raise ValueError('explicit inventory host required')
    if action == 'inspect':
        if set(request) not in ({'host'}, {'host', 'plan_id'}):
            raise ValueError('inspect accepts only host and optional plan_id')
        plan_id = request.get('plan_id')
        if plan_id is not None and not matches('[0-9a-f]{32}', plan_id):
            raise ValueError('invalid plan ID')
    else:
        expected = {'host', 'plan', 'nonce'} | ({'smoke_verified'} if action == 'finish' else set())
        if set(request) != expected or (action == 'finish' and request['smoke_verified'] is not True):
            raise ValueError('invalid action fields or missing full smoke verification')
        validate_plan(request['plan'])
        if request['nonce'] != request['plan']['nonce'] or request['host'] not in request['plan']['hosts']:
            raise ValueError('plan host/nonce mismatch')
        plan_id = request['plan']['plan_id']
        if action in {'claim', 'arm'} and not request['plan']['created'] <= int(time.time()) < request['plan']['expires']:
            raise ValueError('fresh fault plan expired or future-dated')
    if os.geteuid() != 0:
        raise ValueError('target root is required')
    absent = {'changed': False, 'status': 'absent', 'record': None,
              'stop_authorized': False, 'restore_authorized': False}
    for parent in reversed(ROOT.parents):
        if not os.path.lexists(parent):
            if parent != ROOT.parent:
                raise ValueError('missing guard ancestor')
            if action == 'inspect':
                return absent
            if action == 'claim':
                parent.mkdir(mode=0o700)
                _sync(parent.parent)
        _directory(parent)
    if not os.path.lexists(ROOT) and action == 'inspect':
        return absent
    if action == 'claim':
        ROOT.mkdir(mode=0o700, exist_ok=True)
        _sync(ROOT.parent)
    _directory(ROOT, private=True)
    fd = _file(ROOT / 'mutex', os.O_RDWR | (os.O_CREAT if action == 'claim' else 0))
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        return _locked(action, request, plan_id, absent)
    finally:
        os.close(fd)


def _locked(action, request, plan_id, absent):
    active, consumed = ROOT / 'active', ROOT / 'consumed'
    if set(p.name for p in ROOT.iterdir()) - {'mutex', 'active', 'consumed'}:
        raise ValueError('unknown guard entries; retained')
    if action == 'claim':
        consumed.mkdir(mode=0o700, exist_ok=True)
        _sync(ROOT)
    _directory(consumed, private=True)
    if any(not matches('[0-9a-f]{32}', p.name) for p in consumed.iterdir()):
        raise ValueError('incomplete or unknown consumption records; retained')
    owner = None
    if os.path.lexists(active):
        _directory(active, private=True)
        if {p.name for p in active.iterdir()} != {'owner.json'}:
            raise ValueError('incomplete active ownership; retained')
        owner = _read(active / 'owner.json')
        if (not isinstance(owner, dict) or set(owner) != {'operation', 'plan_id', 'nonce'}
                or owner['operation'] != OPERATION
                or not all(matches('[0-9a-f]{32}', owner[k]) for k in ('plan_id', 'nonce'))):
            raise ValueError('foreign or malformed active guard; retained')
        if plan_id is None:
            plan_id = owner['plan_id']
        if plan_id != owner['plan_id']:
            raise ValueError('another transaction is active; retained')
    if action == 'claim':
        if owner is not None or os.path.lexists(consumed / plan_id):
            raise ValueError('active or permanently consumed plan; no reacquisition')
        record = {'schema': 1, 'plan': request['plan'], 'nonce': request['nonce'],
                  'host': request['host'], 'phase': 'claimed', 'outcome': 'pending'}
        # Reserve shared exclusion first. A crash in publication leaves ambiguous
        # ownership locked for reviewed recovery; no arm can then succeed.
        active.mkdir(mode=0o700)
        _sync(ROOT)
        _write(active / 'owner.json', _owner(record))
        _write(consumed / plan_id, record)
        return _result(record, True)
    if plan_id is None or not os.path.lexists(consumed / plan_id):
        if action == 'inspect' and owner is None:
            return absent
        raise ValueError('missing retained transaction; no automatic repair')
    record = _record(_read(consumed / plan_id))
    if record['plan']['plan_id'] != plan_id or record['host'] != request['host']:
        raise ValueError('retained record identity mismatch')
    if owner != _owner(record) and not (owner is None and record['phase'] == 'closed'):
        raise ValueError('active/consumed ownership mismatch; retained')
    if action == 'inspect':
        return _result(record, False)
    if canonical(request['plan']) != canonical(record['plan']) or request['nonce'] != record['nonce']:
        raise ValueError('exact retained plan/nonce required')
    phase = record['phase']
    if phase == 'closed':
        if action not in {'restore', 'finish'}:
            raise ValueError('closed record is verification-only')
    elif action == 'arm':
        if phase != 'claimed' or record['outcome'] != 'pending' or record['host'] != record['plan']['owner']:
            raise ValueError('stop intent may be armed once on exact planned owner')
        record['phase'] = 'armed'
    elif action == 'prove':
        expected = 'armed' if record['host'] == record['plan']['owner'] else 'claimed'
        if phase != expected or record['outcome'] != 'pending':
            raise ValueError('proof cannot replace failed/interrupted/restored result')
        record.update(phase='failover-proven', outcome='proven')
    elif action == 'fail':
        record['outcome'] = 'failed'
        if phase == 'failover-proven':
            record['phase'] = 'restoring'
    elif action == 'restore':
        record['phase'] = 'restoring'
        if record['outcome'] == 'pending':
            record['outcome'] = 'failed'
    elif action == 'finish':
        if phase != 'restoring':
            raise ValueError('restore intent and full smoke required before finish')
        record['phase'] = 'closed'
    changed = phase != 'closed'
    if changed:
        _record(record)
        _write(consumed / plan_id, record, replace=True)
    if action == 'finish' and owner is not None:
        # Closed is durable before releasing exclusion. A lost response supports
        # verification-only finish; an incomplete unlink is conservatively locked.
        (active / 'owner.json').unlink()
        _sync(active)
        active.rmdir()
        _sync(ROOT)
        changed = True
    return _result(record, changed, stop=action == 'arm',
                   restore=action == 'restore' and phase != 'closed')


def _result(record, changed, stop=False, restore=False):
    return {'changed': changed, 'status': record['phase'], 'record': record,
            'stop_authorized': stop, 'restore_authorized': restore}


if __name__ == '__main__':
    try:
        if len(sys.argv) != 2:
            raise ValueError('expected fixed action; no path overrides')
        data = sys.stdin.buffer.read(RECORD_BYTES + 1)
        if len(data) > RECORD_BYTES:
            raise ValueError('oversized request')
        result = guard(sys.argv[1], json.loads(data, object_pairs_hook=pairs))
        print(canonical(result).decode())
    except (OSError, ValueError, TypeError, KeyError, RecursionError) as error:
        print('OpenBao failover guard refused (' + type(error).__name__
              + '); records retained for reviewed recovery.', file=sys.stderr)
        sys.exit(1)
