#!/usr/bin/env python3
"""Persistent exclusion and single-use plans for supported OpenBao edge routes.

Run as target root through Python -c; no installation or runtime path override.
An interrupted invocation retains active/ for separately reviewed recovery.
Never remove consumed/ records, including after rollback or manual recovery.
"""

import fcntl
import json
import os
from pathlib import Path
import re
import stat
import sys


ROOT = Path('/var/lib/platform-config/openbao-edge-guard')


def _directory(path, private=False):
    info = path.lstat()
    if (not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) & 0o022
            or (private and stat.S_IMODE(info.st_mode) != 0o700)):
        raise ValueError('unsafe guard directory: ' + str(path))


def _file(path, flags):
    fd = os.open(path, flags | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
        os.close(fd)
        raise ValueError('unsafe guard record: ' + str(path))
    return fd


def _sync(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def guard(action, operation, plan_id, nonce):
    if action not in ('acquire', 'release') or operation not in ('haproxy', 'keepalived'):
        raise ValueError('unsupported guard operation')
    if not all(re.fullmatch('[0-9a-f]{32}', value) for value in (plan_id, nonce)):
        raise ValueError('plan ID and invocation nonce must be lowercase hex32')
    if os.geteuid() != 0:
        raise ValueError('target root is required')
    # Validate every ancestor before creating anything; do not follow symlinks.
    for parent in reversed(ROOT.parents):
        if parent == ROOT.parent and not parent.exists() and action == 'acquire':
            parent.mkdir(mode=0o700)
            _sync(parent.parent)
        _directory(parent)
    if action == 'acquire':
        ROOT.mkdir(mode=0o700, exist_ok=True)
    _directory(ROOT, private=True)
    _sync(ROOT.parent)
    # Serialize short filesystem updates; active/ survives process exit and reboot.
    fd = _file(ROOT / 'mutex', os.O_RDWR | os.O_CREAT)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        active = ROOT / 'active'
        consumed = ROOT / 'consumed'
        owner = {'operation': operation, 'plan_id': plan_id, 'nonce': nonce}
        if action == 'acquire':
            consumed.mkdir(mode=0o700, exist_ok=True)
            _directory(consumed, private=True)
            if os.path.lexists(consumed / plan_id):
                raise ValueError('plan already consumed; prepare a fresh plan')
            # No stale timeout and no same-owner reacquisition, even after rollback.
            active.mkdir(mode=0o700)
            _sync(ROOT)
            with os.fdopen(_file(active / 'owner.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL), 'w') as stream:
                json.dump(owner, stream, sort_keys=True)
                stream.flush()
                os.fsync(stream.fileno())
            _sync(active)
            with os.fdopen(_file(consumed / plan_id, os.O_WRONLY | os.O_CREAT | os.O_EXCL), 'w') as stream:
                json.dump(owner, stream, sort_keys=True)
                stream.flush()
                os.fsync(stream.fileno())
            _sync(consumed)
            _sync(ROOT)
        else:
            _directory(active, private=True)
            _directory(consumed, private=True)
            with os.fdopen(_file(active / 'owner.json', os.O_RDONLY)) as stream:
                if json.load(stream) != owner:
                    raise ValueError('guard belongs to another invocation; retained')
            with os.fdopen(_file(consumed / plan_id, os.O_RDONLY)) as stream:
                if json.load(stream) != owner:
                    raise ValueError('consumed plan ownership mismatch; retained')
            (active / 'owner.json').unlink()
            active.rmdir()
            _sync(ROOT)
    finally:
        os.close(fd)


if __name__ == '__main__':
    try:
        if len(sys.argv) != 5:
            raise ValueError('expected action operation plan_id nonce; no path overrides')
        guard(*sys.argv[1:])
    except (OSError, ValueError) as error:
        print('OpenBao edge guard refused: ' + str(error)
              + '. Existing guards are retained; explicit reviewed recovery may be required.', file=sys.stderr)
        sys.exit(1)
    print('OpenBao edge guard ' + sys.argv[1] + ' complete')
