# Entire list: Helm replaces lists rather than merging plugins.
- zones:
    - zone: .
      use_tcp: true
  port: 53
  plugins:
    - name: errors
    - name: health
      configBlock: "lameduck 10s"
    - name: ready
{% if rke2_coredns_records | length > 0 %}
    - name: hosts
      parameters: /dev/null
      configBlock: |
{% for record in rke2_coredns_records | sort(attribute='address') %}
        {{ record.address }} {{ record.names | sort | join(' ') }}
{% endfor %}
        fallthrough
{% endif %}
    - name: kubernetes
      # Rancher's patched chart prepends global.clusterDomain itself.
      parameters: in-addr.arpa ip6.arpa
      configBlock: |
        pods insecure
        fallthrough in-addr.arpa ip6.arpa
        ttl 30
    - name: prometheus
      parameters: 0.0.0.0:9153
    - name: forward
      parameters: . /etc/resolv.conf
    - name: cache
      parameters: "30"
    - name: loop
    - name: reload
    - name: loadbalance
