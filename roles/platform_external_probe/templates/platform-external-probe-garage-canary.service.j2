# Managed by platform_external_probe Garage canary.
[Unit]
Description=Collect detect-only Garage semantic canary metrics
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=-/usr/bin/rm -f {{ platform_external_probe_garage_metrics_path }}
ExecStart={{ platform_external_probe_garage_script_path }}
TimeoutStartSec={{ platform_external_probe_garage_run_timeout + 2 }}s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ platform_external_probe_metrics_dir }}
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077
