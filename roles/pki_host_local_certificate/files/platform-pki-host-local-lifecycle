def restore_from_evidence_journal(
    state: PinnedDirectory,
    data: bytes,
    identity: tuple[int, ...],
    args,
) -> str:
    record = evidence_journal_record(data, args)
    prior_active = decode_bound_bytes(
        record["prior_active_b64"], record["prior_active_sha256"], "prior active"
    )
    new_active = decode_bound_bytes(
        record["new_active_b64"], record["new_active_sha256"], "new active"
    )
    prior_rollback = decode_bound_bytes(
        record["prior_rollback_b64"], record["prior_rollback_sha256"],
        "prior rollback",
    )
    new_rollback = decode_bound_bytes(
        record["new_rollback_b64"], record["new_rollback_sha256"], "new rollback"
    )
    prior_config = decode_bound_bytes(
        record["prior_zot_config_b64"], record["prior_zot_config_sha256"],
        "prior Zot config",
    )
    assert all(
        value is not None
        for value in (prior_active, new_active, prior_rollback, new_rollback, prior_config)
    )
    current_config, _ = read_path(args.zot_config, "Zot configuration", mode=0o644)
    current_active, _ = read_optional_state(state, "active")
    current_rollback, _ = read_optional_state(state, "rollback")
    if current_config != prior_config:
        fail("Zot configuration differs from the evidence attempt journal")
    if current_active not in {prior_active, new_active}:
        fail("active record differs from the evidence attempt journal")
    if current_rollback not in {prior_rollback, new_rollback}:
        fail("rollback record differs from the evidence attempt journal")
    published = evidence_published_for_journal(state, record)
    if published:
        target_active = new_active
        target_rollback = new_rollback
        status = "evidence-completed"
    else:
        cleanup_evidence_stage(
            state, record["request_id"], record["transaction_id"]
        )
        target_active = prior_active
        target_rollback = prior_rollback
        status = "restored"
    replace_state_bytes(
        state, "active", current_active, target_active, "active record"
    )
    replace_state_bytes(
        state, "rollback", current_rollback, target_rollback, "rollback record"
    )
    current, current_identity = read_at(
        state, "evidence-attempt-journal", "evidence attempt journal"
    )
    if current != data or current_identity != identity:
        fail("evidence attempt journal changed during recovery")
    require_snapshot(
        state, "evidence-attempt-journal", current_identity,
        "evidence attempt journal",
    )
    os.unlink("evidence-attempt-journal", dir_fd=state.fd)
    os.fsync(state.fd)
    return status


def abandonment_finish(args, state: PinnedDirectory, trust: Mapping[str, bytes]) -> None:
    entries = state_entries(state)
    journal_data: bytes | None = None
    journal_identity: tuple[int, ...] | None = None
    journal: dict[str, str] | None = None
    if "evidence-attempt-journal" in entries:
        fail("fresh finalization evidence blocks abandonment")
    if "activation-journal" in entries:
        journal_data, journal_identity = read_at(
            state, "activation-journal", "activation journal"
        )
        journal = journal_record(journal_data, args)
        if (
            journal["checkpoint"] != args.result
            or journal["request_id"] != args.request_id
            or journal["artifact_manifest_sha256"] != args.artifact_sha256
        ):
            fail("activation journal does not prove the requested abandonment result")
    elif args.result == "rolled-back":
        fail("rolled-back abandonment requires the retained activation journal")

    pending = validate_pending(
        os.path.join(args.pending_root, args.request_id), trust
    )
    version, files, _ = validate_version(
        os.path.join(args.versions_root, args.request_id), args.request_id
    )
    try:
        validated = validate_response_files(
            {name: files[name] for name in RESPONSE_NAMES}, pending, trust, args
        )
        response = validated["response"]
        assert isinstance(response, dict)
        active_auth = authenticate_active(state, args)
        if (
            active_auth is not None
            and active_auth["record"]["request_id"] == args.request_id
        ):
            fail("abandonment cannot claim that the candidate was not activated")
        if args.result == "not-activated" and journal is None:
            current_rollback, _ = read_optional_state(state, "rollback")
            if current_rollback is not None:
                rollback = parse_rollback(current_rollback, args)
                if rollback["activating_request_id"] == args.request_id:
                    fail("rollback state records activation of the candidate")
            request_evidence_path = os.path.join(
                state.path, "evidence", args.request_id
            )
            if os.path.lexists(request_evidence_path):
                request_evidence = PinnedDirectory.open(
                    request_evidence_path, "candidate evidence request root"
                )
                try:
                    for digest, metadata in scan(
                        request_evidence, "candidate evidence request root"
                    ).items():
                        if (
                            HEX_RE.fullmatch(digest) is None
                            or not stat.S_ISDIR(metadata.st_mode)
                        ):
                            fail("candidate evidence request root is invalid")
                        evidence_dir, evidence_files, _ = open_exact_tree(
                            os.path.join(request_evidence_path, digest),
                            EVIDENCE_NAMES, "candidate evidence",
                        )
                        evidence_dir.close()
                        deployment = parse_record(
                            evidence_files["deployment"], DEPLOYMENT_FIELDS,
                            "candidate deployment evidence",
                        )
                        if sha256(evidence_files["deployment"]) != digest:
                            fail("candidate evidence coordinate is invalid")
                        if (
                            deployment["request_id"] == args.request_id
                            and deployment["artifact_manifest_sha256"]
                            == args.artifact_sha256
                            and deployment["action"] == "finalize"
                            and deployment["result"] == "activated"
                        ):
                            fail("existing evidence records activation of the candidate")
                finally:
                    request_evidence.close()
        supplied_boundary, _ = read_path(
            args.validation_boundary, "reviewed validation boundary"
        )
        boundary = validate_boundary(supplied_boundary, args)
        boundary_sha = sha256(supplied_boundary)
        if boundary_sha != args.validation_boundary_sha256:
            fail("validation boundary differs from the reviewed digest")
        installed_boundary, _ = read_optional_state(state, "validation-boundary")
        if installed_boundary is not None and installed_boundary != supplied_boundary:
            fail("installed validation boundary conflicts with reviewed bytes")

        created = lifecycle_epoch()
        activation_value = "none"
        validation_value = "none"
        served_certificate = "none"
        served_intermediate = "none"
        validation_state = "not-run"
        rollback_state = "none"
        rollback_until = "none"
        remote_http_status = "not-run"
        remote_api_version = "not-run"
        remote_auth_challenge = "not-run"
        check_state = "not-run"
        if args.result == "not-activated":
            if args.observation_file is not None:
                fail("not-activated abandonment must not consume validation observations")
        else:
            assert journal is not None
            if args.observation_file is None:
                if not args.prepare_rolled_back_abandonment:
                    fail("rolled-back abandonment requires a restored-state observation")
            rollback_bytes = decode_bound_bytes(
                journal["new_rollback_b64"], journal["new_rollback_sha256"],
                "activation rollback",
            )
            assert rollback_bytes is not None
            rollback = parse_rollback(rollback_bytes, args)
            if rollback["predecessor_kind"] == "none":
                fail("rolled-back abandonment lacks a predecessor")
            served_certificate = rollback["predecessor_certificate_sha256"]
            require_digest(served_certificate, "restored predecessor certificate")
            if args.prepare_rolled_back_abandonment:
                ca_data, _ = read_path(
                    args.reviewed_ca, "reviewed validation CA",
                    mode=args.reviewed_ca_mode,
                )
                certificates = pem_certificates(
                    ca_data, 2, "reviewed validation CA"
                )
                served_intermediate = sha256(
                    certificates[0].public_bytes(serialization.Encoding.PEM)
                )
                strict_local_validation(
                    args, served_certificate, served_intermediate
                )
                activation = require_epoch(
                    journal["created_epoch"], "candidate activation epoch"
                )
                hold = require_epoch(
                    journal["rollback_deadline_epoch"], "retained rollback hold"
                )
                assert activation is not None and hold is not None
                json_output({
                    "status": "rolled-back-abandonment-local-validated",
                    "action": "abandon", "result": "rolled-back",
                    "request_id": args.request_id,
                    "artifact_sha256": args.artifact_sha256,
                    "served_certificate_sha256": served_certificate,
                    "served_intermediate_sha256": served_intermediate,
                    "activation_epoch": activation,
                    "rollback_deadline_epoch": hold,
                })
                return
            assert args.served_intermediate_sha256 is not None
            served_intermediate = args.served_intermediate_sha256
            hold = require_epoch(
                journal["rollback_deadline_epoch"], "retained rollback hold"
            )
            assert hold is not None
            required_hold = created + args.rollback_seconds
            if hold < required_hold:
                assert journal_data is not None and journal_identity is not None
                new_active_bytes = decode_bound_bytes(
                    journal["new_active_b64"], journal["new_active_sha256"],
                    "journal candidate active",
                )
                assert new_active_bytes is not None
                new_active = parse_active(new_active_bytes, args)
                new_active["rollback_deadline_epoch"] = str(required_hold)
                new_active_bytes = serialize_record(
                    ACTIVE_FIELDS, new_active, "extended candidate active record"
                )
                rollback["rollback_deadline_epoch"] = str(required_hold)
                rollback_bytes = serialize_record(
                    ROLLBACK_FIELDS, rollback, "extended candidate rollback record"
                )
                journal["rollback_deadline_epoch"] = str(required_hold)
                journal["new_active_b64"] = b64_value(new_active_bytes)
                journal["new_active_sha256"] = sha256(new_active_bytes)
                journal["new_rollback_b64"] = b64_value(rollback_bytes)
                journal["new_rollback_sha256"] = sha256(rollback_bytes)
                updated_journal = serialize_record(
                    ACTIVATION_JOURNAL_FIELDS, journal, "activation journal"
                )
                atomic_replace_at(
                    state, "activation-journal", updated_journal,
                    "activation journal", expected=journal_identity,
                )
                journal_data, journal_identity = read_at(
                    state, "activation-journal", "activation journal"
                )
                journal = journal_record(journal_data, args)
                hold = required_hold
            strict_local_validation(
                args, served_certificate, served_intermediate
            )
            observation_data, _ = read_private_path(
                args.observation_file, "restored-state runner observation"
            )
            observation = parse_record(
                observation_data, EXTERNAL_OBSERVATION_FIELDS,
                "restored-state runner observation",
            )
            expected_observation = {
                "schema": "1", "kind": "pki-external-validation-observation",
                "service": args.service, "target": args.target,
                "request_id": args.request_id,
                "artifact_manifest_sha256": args.artifact_sha256,
                "validation_boundary_sha256": boundary_sha,
                "remote_validator": boundary["remote_validator"],
                "endpoint": boundary["endpoint"],
                "remote_tls_result": "passed",
                "remote_application_result": "passed",
                "remote_http_status": observation["remote_http_status"],
                "remote_api_version": "registry/2.0",
                "remote_auth_challenge": observation["remote_auth_challenge"],
                "served_certificate_sha256": served_certificate,
                "served_intermediate_sha256": served_intermediate,
                "validation_epoch": observation["validation_epoch"],
            }
            if (
                observation != expected_observation
                or (observation["remote_http_status"], observation["remote_auth_challenge"])
                not in {("200", "not-required"), ("401", "present")}
            ):
                fail("restored-state observation does not prove the predecessor")
            activation = require_epoch(
                journal["created_epoch"], "candidate activation epoch"
            )
            validation = require_epoch(
                observation["validation_epoch"], "restored validation epoch"
            )
            assert activation is not None and validation is not None
            if (
                not activation <= validation <= created + 300
                or validation > created + 300
                or hold < created + MIN_ROLLBACK_SECONDS
            ):
                fail("rolled-back abandonment epochs or retained hold are invalid")
            activation_value = str(activation)
            validation_value = str(validation)
            validation_state = "passed"
            rollback_state = "restored"
            rollback_until = str(hold)
            remote_http_status = observation["remote_http_status"]
            remote_api_version = observation["remote_api_version"]
            remote_auth_challenge = observation["remote_auth_challenge"]
            check_state = "passed"

        candidate_sha = sha256(candidate_bytes(
            response, str(validated["response_sha256"]),
            str(validated["response_signature_sha256"]),
        ))
        deployment_values = {
            "schema": "1", "request_id": args.request_id,
            "nonce": response["nonce"], "operation": response["operation"],
            "service": args.service, "target": args.target,
            "request_sha256": response["request_sha256"],
            "response_sha256": str(validated["response_sha256"]),
            "response_signature_sha256": str(validated["response_signature_sha256"]),
            "candidate_sha256": candidate_sha,
            "artifact_request_id": args.request_id,
            "artifact_manifest_sha256": args.artifact_sha256,
            "certificate_sha256": str(validated["certificate_sha256"]),
            "certificate_spki_sha256": str(validated["certificate_spki_sha256"]),
            "chain_sha256": str(validated["chain_sha256"]),
            "fullchain_sha256": str(validated["fullchain_sha256"]),
            "action": "abandon", "result": args.result,
            "local_certificate_sha256": str(validated["certificate_sha256"]),
            "local_key_spki_sha256": str(validated["certificate_spki_sha256"]),
            "local_key_certificate_match": "true",
            "served_certificate_sha256": served_certificate,
            "served_intermediate_sha256": served_intermediate,
            "validation_boundary_sha256": boundary_sha,
            "validation_result": validation_state,
            "activation_epoch": activation_value,
            "validation_epoch": validation_value,
            "rollback_state": rollback_state,
            "rollback_hold_until_epoch": rollback_until,
            "deployment_principal": args.target, "created_epoch": str(created),
            "expires_epoch": str(created + 86400),
        }
        deployment = serialize_record(
            DEPLOYMENT_FIELDS, deployment_values, "abandonment deployment"
        )
        deployment_sha = sha256(deployment)
        result_values = {
            "schema": "1", "kind": "pki-validation-result",
            "service": args.service, "target": args.target,
            "request_id": args.request_id,
            "artifact_manifest_sha256": args.artifact_sha256,
            "validation_boundary_sha256": boundary_sha,
            "action": "abandon", "result": args.result,
            "local_validator": boundary["local_validator"],
            "remote_validator": boundary["remote_validator"],
            "endpoint": boundary["endpoint"],
            "local_service_result": check_state,
            "local_tls_result": check_state,
            "remote_tls_result": check_state,
            "remote_application_result": check_state,
            "remote_http_status": remote_http_status,
            "remote_api_version": remote_api_version,
            "remote_auth_challenge": remote_auth_challenge,
            "served_certificate_sha256": served_certificate,
            "served_intermediate_sha256": served_intermediate,
            "activation_epoch": activation_value,
            "validation_epoch": validation_value,
            "deployment_sha256": deployment_sha,
        }
        validation_result = serialize_record(
            VALIDATION_RESULT_FIELDS, result_values, "abandonment validation result"
        )
        if args.check:
            json_output({
                "status": "would-publish-abandonment", "result": args.result,
                "request_id": args.request_id,
                "deployment_sha256": deployment_sha,
            })
            return
        if installed_boundary is None:
            write_new_at(
                state, "validation-boundary", supplied_boundary,
                "validation boundary",
            )
        deployment_signature = sign_bytes(
            deployment, args.deployment_signing_key,
            trust["deployers.allowed_signers"], args.target,
            "abandonment deployment",
        )
        result_signature = sign_bytes(
            validation_result, args.deployment_signing_key,
            trust["deployers.allowed_signers"], args.target,
            "abandonment validation result",
        )
        evidence = {
            "deployment": deployment, "deployment.sig": deployment_signature,
            "validation-boundary": supplied_boundary,
            "validation-result": validation_result,
            "validation-result.sig": result_signature,
        }
        transaction_id = secrets.token_hex(16)
        abandonment_journal_data: bytes | None = None
        abandonment_journal_identity: tuple[int, ...] | None = None
        if journal is not None:
            assert journal_data is not None and journal_identity is not None
            journal_data, journal_identity = set_journal_checkpoint(
                state, journal_data, journal_identity, "evidence-ready", args,
                evidence=evidence,
            )
            transaction_id = journal["transaction_id"]
        else:
            abandonment_values = {
                "schema": "1", "kind": "host-local-abandonment-publication",
                "transaction_id": transaction_id, "service": args.service,
                "target": args.target, "request_id": args.request_id,
                "artifact_manifest_sha256": args.artifact_sha256,
                "result": "not-activated", "checkpoint": "evidence-ready",
                "recovery_action": "remove-stage-unless-published",
                "deployment_sha256": deployment_sha,
                "deployment_signature_sha256": sha256(deployment_signature),
                "validation_boundary_sha256": sha256(supplied_boundary),
                "validation_result_sha256": sha256(validation_result),
                "validation_result_signature_sha256": sha256(result_signature),
            }
            abandonment_journal_data = serialize_record(
                ABANDONMENT_JOURNAL_FIELDS, abandonment_values,
                "abandonment journal",
            )
            abandonment_journal_identity = write_new_at(
                state, "abandonment-journal", abandonment_journal_data,
                "abandonment journal",
            )
            os.fsync(state.fd)
            fault("after-abandonment-journal")
        created_evidence = publish_evidence(
            state, args.request_id, deployment_sha, evidence, transaction_id
        )
        fault("after-abandonment-publication")
        published, published_files, _ = open_exact_tree(
            os.path.join(state.path, "evidence", args.request_id, deployment_sha),
            EVIDENCE_NAMES, "published abandonment evidence",
        )
        published.close()
        if published_files != evidence:
            fail("published abandonment evidence bytes changed")
        if journal is not None:
            assert journal_data is not None and journal_identity is not None
            current, current_identity = read_at(
                state, "activation-journal", "activation journal"
            )
            if current != journal_data or current_identity != journal_identity:
                fail("activation journal changed before abandonment completion")
            require_snapshot(
                state, "activation-journal", current_identity, "activation journal"
            )
            os.unlink("activation-journal", dir_fd=state.fd)
            os.fsync(state.fd)
        else:
            assert (
                abandonment_journal_data is not None
                and abandonment_journal_identity is not None
            )
            current, current_identity = read_at(
                state, "abandonment-journal", "abandonment journal"
            )
            if (
                current != abandonment_journal_data
                or current_identity != abandonment_journal_identity
            ):
                fail("abandonment journal changed before publication completion")
            require_snapshot(
                state, "abandonment-journal", current_identity,
                "abandonment journal",
            )
            os.unlink("abandonment-journal", dir_fd=state.fd)
            os.fsync(state.fd)
        json_output({
            "status": "evidence-published" if created_evidence else "evidence-existing",
            "action": "abandon", "result": args.result,
            "request_id": args.request_id, "deployment_sha256": deployment_sha,
            "evidence_path": os.path.join(
                state.path, "evidence", args.request_id, deployment_sha
            ),
        })
    finally:
        version.close()


def activate_finish(args) -> None:
    state, lock = common_open(args)
    try:
        entries = state_entries(state)
        if (
            "request.journal" in entries
            or "trust-install.journal" in entries
            or "expired-request-abandonment-journal" in entries
            or "expired-request-abandonment-journal.stage" in entries
            or "pending-request-cancellation-journal" in entries
            or "pending-request-cancellation-journal.stage" in entries
        ):
            fail("unrelated unresolved lifecycle state blocks evidence finalization")
        if "abandonment-journal" in entries:
            fail("abandonment publication recovery is required")
        if "activation-journal" in entries and "evidence-attempt-journal" in entries:
            fail("multiple lifecycle journals are present")
        trust, _policy = load_trust(state, args.trust_id, args.target)
        if args.action == "abandon":
            abandonment_finish(args, state, trust)
            return
        active_auth = authenticate_active(state, args)
        if active_auth is None:
            fail("active candidate is absent")
        active = active_auth["record"]
        active_data = active_auth["record_bytes"]
        assert isinstance(active_data, bytes)
        rollback_data, _ = read_at(state, "rollback", "rollback record")
        rollback = parse_rollback(rollback_data, args)
        if (
            active["request_id"] != args.request_id
            or active["artifact_manifest_sha256"] != args.artifact_sha256
            or rollback["activating_request_id"] != args.request_id
            or rollback["activating_artifact_manifest_sha256"]
            != args.artifact_sha256
            or rollback["rollback_deadline_epoch"]
            != active["rollback_deadline_epoch"]
        ):
            fail("active and rollback state differ from the requested evidence identity")
        journal_data: bytes | None = None
        journal_identity: tuple[int, ...] | None = None
        journal_name: str | None = None
        fresh_attempt = False
        if "activation-journal" in entries:
            if args.fresh_evidence:
                fail("fresh evidence cannot begin during initial activation")
            journal_data, journal_identity = read_at(state, "activation-journal", "activation journal")
            journal = journal_record(journal_data, args)
            if journal["checkpoint"] != "local-validated" or journal["request_id"] != args.request_id or journal["artifact_manifest_sha256"] != args.artifact_sha256:
                fail("activation journal is not the exact local-validated candidate")
            journal_name = "activation-journal"
        elif "evidence-attempt-journal" in entries:
            if args.fresh_evidence:
                fail("fresh evidence preparation is already unresolved")
            journal_data, journal_identity = read_at(
                state, "evidence-attempt-journal", "evidence attempt journal"
            )
            journal = evidence_journal_record(journal_data, args)
            if (
                journal["checkpoint"] != "local-validated"
                or journal["request_id"] != args.request_id
                or journal["artifact_manifest_sha256"] != args.artifact_sha256
            ):
                fail("evidence attempt journal is not ready for remote validation")
            journal_name = "evidence-attempt-journal"
            fresh_attempt = True
        elif args.fresh_evidence:
            evidence_state, evidence_digests = validate_evidence(state, args, active)
            if evidence_state != "target-published" or not evidence_digests:
                fail("fresh evidence requires authenticated prior target evidence")
            activation = require_epoch(active["activation_epoch"], "active activation epoch")
            prior_deadline = require_epoch(
                active["rollback_deadline_epoch"], "active rollback deadline"
            )
            assert activation is not None and prior_deadline is not None
            created = lifecycle_epoch()
            if created <= activation + 300:
                fail("initial deployment ordering window has not elapsed")
            deadline = max(
                prior_deadline,
                created + max(args.rollback_seconds, prior_deadline - activation),
            )
            new_active_values = dict(active)
            new_active_values["rollback_deadline_epoch"] = str(deadline)
            new_active_data = serialize_record(
                ACTIVE_FIELDS, new_active_values, "extended active record"
            )
            new_rollback_values = dict(rollback)
            new_rollback_values["rollback_deadline_epoch"] = str(deadline)
            new_rollback_data = serialize_record(
                ROLLBACK_FIELDS, new_rollback_values, "extended rollback record"
            )
            config_data, _ = read_path(
                args.zot_config, "Zot configuration", mode=0o644
            )
            if service_state() != "active":
                fail("Zot must remain active for fresh evidence")
            values = {
                "schema": "1", "kind": "host-local-evidence-attempt",
                "transaction_id": secrets.token_hex(16), "service": args.service,
                "target": args.target, "request_id": args.request_id,
                "artifact_manifest_sha256": args.artifact_sha256,
                "checkpoint": "prepared",
                "recovery_action": "restore-prior-unless-published",
                "target_version_path": active["version_path"],
                "target_version_device": active["version_device"],
                "target_version_inode": active["version_inode"],
                "target_certificate_sha256": active["certificate_sha256"],
                "target_certificate_spki_sha256": active["certificate_spki_sha256"],
                "target_chain_sha256": active["chain_sha256"],
                "target_fullchain_sha256": active["fullchain_sha256"],
                "prior_active_b64": b64_value(active_data),
                "prior_active_sha256": sha256(active_data),
                "new_active_b64": b64_value(new_active_data),
                "new_active_sha256": sha256(new_active_data),
                "prior_rollback_b64": b64_value(rollback_data),
                "prior_rollback_sha256": sha256(rollback_data),
                "new_rollback_b64": b64_value(new_rollback_data),
                "new_rollback_sha256": sha256(new_rollback_data),
                "prior_zot_config_b64": b64_value(config_data),
                "prior_zot_config_sha256": sha256(config_data),
                "target_zot_config_b64": b64_value(config_data),
                "target_zot_config_sha256": sha256(config_data),
                "prior_service_state": "active", "created_epoch": str(created),
                "rollback_deadline_epoch": str(deadline),
                "deployment_sha256": "none",
                "deployment_signature_sha256": "none",
                "validation_boundary_sha256": "none",
                "validation_result_sha256": "none",
                "validation_result_signature_sha256": "none",
            }
            if args.check:
                json_output({
                    "status": "would-prepare-fresh-evidence",
                    "request_id": args.request_id,
                    "artifact_sha256": args.artifact_sha256,
                    "created_epoch": created,
                    "rollback_deadline_epoch": deadline,
                })
                return
            prepared = serialize_record(
                EVIDENCE_ATTEMPT_JOURNAL_FIELDS, values,
                "evidence attempt journal",
            )
            prepared_identity = write_new_at(
                state, "evidence-attempt-journal", prepared,
                "evidence attempt journal",
            )
            os.fsync(state.fd)
            fault("after-evidence-attempt-journal")
            try:
                replace_state_bytes(
                    state, "active", active_data, new_active_data, "active record"
                )
                replace_state_bytes(
                    state, "rollback", rollback_data, new_rollback_data,
                    "rollback record",
                )
                prepared, prepared_identity = set_evidence_journal_checkpoint(
                    state, prepared, prepared_identity, "records-written", args
                )
                fault("after-evidence-attempt-records")
                strict_local_validation(
                    args, active["certificate_sha256"],
                    args.served_intermediate_sha256,
                )
                if lifecycle_epoch() > created + 300:
                    fail("fresh local validation exceeded the ordering window")
                authenticate_active(state, args)
                prepared, prepared_identity = set_evidence_journal_checkpoint(
                    state, prepared, prepared_identity, "local-validated", args
                )
                fault("after-fresh-local-validation")
            except Exception:
                try:
                    current, current_identity = read_at(
                        state, "evidence-attempt-journal",
                        "evidence attempt journal",
                    )
                    restore_from_evidence_journal(
                        state, current, current_identity, args
                    )
                except Exception:
                    pass
                raise
            json_output({
                "status": "fresh-evidence-local-validated",
                "request_id": args.request_id,
                "artifact_sha256": args.artifact_sha256,
                "created_epoch": created,
                "rollback_deadline_epoch": deadline,
            })
            return
        else:
            journal = {
                "request_id": active["request_id"],
                "artifact_manifest_sha256": active["artifact_manifest_sha256"],
                "created_epoch": active["activation_epoch"],
                "transaction_id": secrets.token_hex(16),
            }
            if journal["request_id"] != args.request_id or journal["artifact_manifest_sha256"] != args.artifact_sha256:
                fail("active identity differs from the requested evidence attempt")
        boundary_data, _ = read_at(state, "validation-boundary", "validation boundary")
        boundary = validate_boundary(boundary_data, args)
        boundary_sha = sha256(boundary_data)
        if boundary_sha != args.validation_boundary_sha256:
            fail("installed validation boundary differs from reviewed digest")
        if args.observation_file is None:
            fail("external runner observation is required for evidence publication")
        observation_data, _ = read_private_path(
            args.observation_file, "external runner observation"
        )
        observation = parse_record(observation_data, EXTERNAL_OBSERVATION_FIELDS, "external runner observation")
        expected_observation = {
            "schema": "1", "kind": "pki-external-validation-observation", "service": args.service,
            "target": args.target, "request_id": args.request_id,
            "artifact_manifest_sha256": args.artifact_sha256,
            "validation_boundary_sha256": boundary_sha,
            "remote_validator": boundary["remote_validator"], "endpoint": boundary["endpoint"],
            "remote_tls_result": "passed", "remote_application_result": "passed",
            "remote_http_status": observation["remote_http_status"], "remote_api_version": "registry/2.0",
            "remote_auth_challenge": observation["remote_auth_challenge"],
            "served_certificate_sha256": active["certificate_sha256"],
            "served_intermediate_sha256": args.served_intermediate_sha256,
            "validation_epoch": observation["validation_epoch"],
        }
        if observation != expected_observation or (observation["remote_http_status"], observation["remote_auth_challenge"]) not in {("200", "not-required"), ("401", "present")}:
            fail("external runner observation does not prove the exact candidate")
        validation_epoch = require_epoch(observation["validation_epoch"], "external validation epoch")
        created = require_epoch(journal["created_epoch"], "activation reserved epoch")
        activation = require_epoch(active["activation_epoch"], "active activation epoch")
        assert validation_epoch is not None and created is not None and activation is not None
        now = lifecycle_epoch()
        lower_bound = created if fresh_attempt else activation
        if not lower_bound <= validation_epoch <= created + 300 or validation_epoch > now + 300:
            fail("external observation is outside the activation ordering window")
        version, files, _ = validate_version(active["version_path"], args.request_id)
        try:
            response = parse_record(files["response"], RESPONSE_FIELDS, "active response")
            candidate_sha = sha256(candidate_bytes(response, active["response_sha256"], active["response_signature_sha256"]))
            rollback_state = "none" if response["operation"] == "issue" else "retained"
            rollback_until = "none" if rollback_state == "none" else rollback["rollback_deadline_epoch"]
            deployment_values = {
                "schema": "1", "request_id": args.request_id, "nonce": response["nonce"],
                "operation": response["operation"], "service": args.service, "target": args.target,
                "request_sha256": response["request_sha256"], "response_sha256": active["response_sha256"],
                "response_signature_sha256": active["response_signature_sha256"], "candidate_sha256": candidate_sha,
                "artifact_request_id": args.request_id, "artifact_manifest_sha256": args.artifact_sha256,
                "certificate_sha256": active["certificate_sha256"], "certificate_spki_sha256": active["certificate_spki_sha256"],
                "chain_sha256": active["chain_sha256"], "fullchain_sha256": active["fullchain_sha256"],
                "action": "finalize", "result": "activated", "local_certificate_sha256": active["certificate_sha256"],
                "local_key_spki_sha256": active["certificate_spki_sha256"], "local_key_certificate_match": "true",
                "served_certificate_sha256": observation["served_certificate_sha256"],
                "served_intermediate_sha256": observation["served_intermediate_sha256"],
                "validation_boundary_sha256": boundary_sha, "validation_result": "passed",
                "activation_epoch": active["activation_epoch"], "validation_epoch": observation["validation_epoch"],
                "rollback_state": rollback_state, "rollback_hold_until_epoch": rollback_until,
                "deployment_principal": args.target, "created_epoch": journal["created_epoch"],
                "expires_epoch": str(created + 86400),
            }
            deployment = serialize_record(DEPLOYMENT_FIELDS, deployment_values, "deployment evidence")
            deployment_sha = sha256(deployment)
            result_values = {
                "schema": "1", "kind": "pki-validation-result", "service": args.service,
                "target": args.target, "request_id": args.request_id,
                "artifact_manifest_sha256": args.artifact_sha256,
                "validation_boundary_sha256": boundary_sha, "action": "finalize", "result": "activated",
                "local_validator": boundary["local_validator"], "remote_validator": boundary["remote_validator"],
                "endpoint": boundary["endpoint"], "local_service_result": "passed", "local_tls_result": "passed",
                "remote_tls_result": observation["remote_tls_result"],
                "remote_application_result": observation["remote_application_result"],
                "remote_http_status": observation["remote_http_status"], "remote_api_version": observation["remote_api_version"],
                "remote_auth_challenge": observation["remote_auth_challenge"],
                "served_certificate_sha256": observation["served_certificate_sha256"],
                "served_intermediate_sha256": observation["served_intermediate_sha256"],
                "activation_epoch": active["activation_epoch"], "validation_epoch": observation["validation_epoch"],
                "deployment_sha256": deployment_sha,
            }
            validation_result = serialize_record(VALIDATION_RESULT_FIELDS, result_values, "validation result")
            if args.check:
                json_output({"status": "would-publish-evidence", "request_id": args.request_id, "deployment_sha256": deployment_sha, "certificate_sha256": active["certificate_sha256"]})
                return
            deployment_signature = sign_bytes(deployment, args.deployment_signing_key, trust["deployers.allowed_signers"], args.target, "deployment")
            result_signature = sign_bytes(validation_result, args.deployment_signing_key, trust["deployers.allowed_signers"], args.target, "validation result")
            evidence = {
                "deployment": deployment, "deployment.sig": deployment_signature,
                "validation-boundary": boundary_data, "validation-result": validation_result,
                "validation-result.sig": result_signature,
            }
            if journal_name == "activation-journal":
                assert journal_data is not None and journal_identity is not None
                journal_data, journal_identity = set_journal_checkpoint(
                    state, journal_data, journal_identity, "evidence-ready", args,
                    evidence=evidence,
                )
            elif journal_name == "evidence-attempt-journal":
                assert journal_data is not None and journal_identity is not None
                journal_data, journal_identity = set_evidence_journal_checkpoint(
                    state, journal_data, journal_identity, "evidence-ready", args,
                    evidence=evidence,
                )
            else:
                existing_path = os.path.join(
                    state.path, "evidence", args.request_id, deployment_sha
                )
                if not os.path.lexists(existing_path):
                    fail("evidence publication without a journal is not allowed")
            try:
                created_evidence = publish_evidence(
                    state, args.request_id, deployment_sha, evidence,
                    journal["transaction_id"],
                )
                fault("after-evidence-publication")
            except Exception:
                if journal_name == "evidence-attempt-journal":
                    try:
                        current, current_identity = read_at(
                            state, journal_name, "evidence attempt journal"
                        )
                        restore_from_evidence_journal(
                            state, current, current_identity, args
                        )
                    except Exception:
                        pass
                raise
            published, published_files, _ = open_exact_tree(os.path.join(state.path, "evidence", args.request_id, deployment_sha), EVIDENCE_NAMES, "published evidence")
            published.close()
            if published_files != evidence:
                fail("published evidence bytes changed")
            verify_ssh_signature(deployment, deployment_signature, trust["deployers.allowed_signers"], args.target, DEPLOYMENT_NAMESPACE, "deployment")
            verify_ssh_signature(validation_result, result_signature, trust["deployers.allowed_signers"], args.target, DEPLOYMENT_NAMESPACE, "validation result")
            if journal_name is not None:
                assert journal_data is not None and journal_identity is not None
                current_journal, current_identity = read_at(
                    state, journal_name, journal_name.replace("-", " ")
                )
                if current_journal != journal_data or current_identity != journal_identity:
                    fail("lifecycle journal changed before evidence completion")
                fault("before-evidence-journal-removal")
                if journal_name == "activation-journal":
                    fault("before-activation-journal-removal")
                require_snapshot(
                    state, journal_name, current_identity,
                    journal_name.replace("-", " "),
                )
                os.unlink(journal_name, dir_fd=state.fd)
                os.fsync(state.fd)
            json_output({"status": "evidence-published" if created_evidence else "evidence-existing", "request_id": args.request_id, "deployment_sha256": deployment_sha, "certificate_sha256": active["certificate_sha256"], "evidence_path": os.path.join(state.path, "evidence", args.request_id, deployment_sha)})
        finally:
            version.close()
    finally:
        os.close(lock)
        state.close()


def recover(args) -> None:
    state, lock = common_open(args)
    try:
        entries = state_entries(state)
        if "abandonment-journal" in entries:
            data, identity = read_at(
                state, "abandonment-journal", "abandonment journal"
            )
            record = abandonment_journal_record(data, args)
            if args.check:
                fail("abandonment publication recovery is required")
            published = abandonment_published_for_journal(state, record)
            if not published:
                cleanup_evidence_stage(
                    state, record["request_id"], record["transaction_id"]
                )
            require_snapshot(
                state, "abandonment-journal", identity, "abandonment journal"
            )
            os.unlink("abandonment-journal", dir_fd=state.fd)
            os.fsync(state.fd)
            json_output({
                "status": "evidence-completed" if published else "restored",
                "result": record["result"], "request_id": record["request_id"],
                "artifact_sha256": record["artifact_manifest_sha256"],
            })
            return
        if "evidence-attempt-journal" in entries:
            data, identity = read_at(
                state, "evidence-attempt-journal", "evidence attempt journal"
            )
            record = evidence_journal_record(data, args)
            if args.request_id is not None and record["request_id"] != args.request_id:
                fail("recovery request ID differs from the evidence journal")
            if args.artifact_sha256 is not None and record["artifact_manifest_sha256"] != args.artifact_sha256:
                fail("recovery artifact digest differs from the evidence journal")
            if args.check:
                fail("evidence-attempt recovery is required before check mode can succeed")
            recovered = restore_from_evidence_journal(state, data, identity, args)
            json_output({
                "status": recovered, "request_id": record["request_id"],
                "artifact_sha256": record["artifact_manifest_sha256"],
            })
            return
        if "activation-journal" not in entries:
            json_output({"status": "not-required"})
            return
        data, identity = read_at(state, "activation-journal", "activation journal")
        record = journal_record(data, args)
        if args.request_id is not None and record["request_id"] != args.request_id:
            fail("recovery request ID differs from the journal")
        if args.artifact_sha256 is not None and record["artifact_manifest_sha256"] != args.artifact_sha256:
            fail("recovery artifact digest differs from the journal")
        if args.check:
            fail("activation recovery is required before check mode can succeed")
        if record["checkpoint"] in {"not-activated", "rolled-back"}:
            json_output({
                "status": "abandonment-evidence-required",
                "result": record["checkpoint"],
                "request_id": record["request_id"],
                "artifact_sha256": record["artifact_manifest_sha256"],
            })
            return
        if evidence_published_for_journal(state, record):
            prior_active = decode_bound_bytes(
                record["prior_active_b64"], record["prior_active_sha256"],
                "prior active", allow_none=True,
            )
            prior_rollback = decode_bound_bytes(
                record["prior_rollback_b64"], record["prior_rollback_sha256"],
                "prior rollback", allow_none=True,
            )
            prior_config = decode_bound_bytes(
                record["prior_zot_config_b64"], record["prior_zot_config_sha256"],
                "prior Zot config",
            )
            new_active = decode_bound_bytes(
                record["new_active_b64"], record["new_active_sha256"],
                "new active",
            )
            new_rollback = decode_bound_bytes(
                record["new_rollback_b64"], record["new_rollback_sha256"],
                "new rollback",
            )
            target_config = decode_bound_bytes(
                record["target_zot_config_b64"],
                record["target_zot_config_sha256"], "target Zot config",
            )
            current_active, _ = read_optional_state(state, "active")
            current_rollback, _ = read_optional_state(state, "rollback")
            current_config, _ = read_path(
                args.zot_config, "Zot configuration", mode=0o644
            )
            abandoned = record["evidence_action"] == "abandon"
            expected_active = prior_active if abandoned else new_active
            expected_rollback = prior_rollback if abandoned else new_rollback
            expected_config = prior_config if abandoned else target_config
            if (
                current_active != expected_active
                or current_rollback != expected_rollback
                or current_config != expected_config
            ):
                fail("published deployment evidence does not match current state")
            if not abandoned:
                authenticate_active(state, args)
            require_snapshot(state, "activation-journal", identity, "activation journal")
            os.unlink("activation-journal", dir_fd=state.fd)
            os.fsync(state.fd)
            json_output({
                "status": "evidence-completed", "request_id": record["request_id"],
                "artifact_sha256": record["artifact_manifest_sha256"],
            })
            return
        cleanup_evidence_stage(
            state, record["request_id"], record["transaction_id"]
        )
        restore_from_journal(state, data, identity, args)
        json_output({"status": "restored", "request_id": record["request_id"], "artifact_sha256": record["artifact_manifest_sha256"]})
    finally:
        os.close(lock)
        state.close()


def authenticate_evidence_attempt(
    state: PinnedDirectory, args, trust: Mapping[str, bytes]
) -> dict[str, object]:
    evidence_path = os.path.join(
        state.path, "evidence", args.request_id, args.deployment_sha256
    )
    evidence_dir, evidence_files, _ = open_exact_tree(
        evidence_path, EVIDENCE_NAMES, "requested evidence attempt"
    )
    evidence_dir.close()
    deployment = parse_record(
        evidence_files["deployment"], DEPLOYMENT_FIELDS, "deployment evidence"
    )
    result = parse_record(
        evidence_files["validation-result"], VALIDATION_RESULT_FIELDS,
        "validation result",
    )
    boundary = parse_record(
        evidence_files["validation-boundary"], VALIDATION_BOUNDARY_FIELDS,
        "evidence validation boundary",
    )
    if (
        sha256(evidence_files["deployment"]) != args.deployment_sha256
        or result["deployment_sha256"] != args.deployment_sha256
    ):
        fail("requested deployment coordinate differs from evidence bytes")
    verify_ssh_signature(
        evidence_files["deployment"], evidence_files["deployment.sig"],
        trust["deployers.allowed_signers"], args.target, DEPLOYMENT_NAMESPACE,
        "deployment evidence",
    )
    verify_ssh_signature(
        evidence_files["validation-result"],
        evidence_files["validation-result.sig"],
        trust["deployers.allowed_signers"], args.target, DEPLOYMENT_NAMESPACE,
        "validation result",
    )
    installed_boundary, _ = read_at(
        state, "validation-boundary", "installed validation boundary"
    )
    if evidence_files["validation-boundary"] != installed_boundary:
        fail("evidence boundary differs from the installed reviewed boundary")
    boundary_sha = sha256(installed_boundary)
    endpoint = urllib.parse.urlsplit(boundary["endpoint"])
    if (
        boundary["schema"] != "1"
        or boundary["kind"] != "pki-validation-boundary"
        or boundary["service"] != args.service
        or boundary["target"] != args.target
        or boundary["local_validator"] != args.target
        or IDENTITY_RE.fullmatch(boundary["remote_validator"]) is None
        or boundary["local_check"] != LOCAL_CHECK
        or boundary["remote_check"] != REMOTE_CHECK
        or endpoint.scheme != "https"
        or not endpoint.hostname
        or endpoint.path != "/v2/"
        or endpoint.query
        or endpoint.fragment
    ):
        fail("evidence validation boundary is invalid")

    version, version_files, _ = validate_version(
        os.path.join(args.versions_root, args.request_id), args.request_id
    )
    try:
        response_record = parse_record(
            version_files["response"], RESPONSE_FIELDS, "evidence response"
        )
        response_created = require_epoch(
            response_record["created_epoch"], "response created epoch"
        )
        assert response_created is not None
        pending = validate_pending(
            os.path.join(args.pending_root, args.request_id), trust,
            now=response_created,
        )
        pending_files = pending["files"]
        assert isinstance(pending_files, dict)
        csr = load_csr(pending_files["tls.csr"])
        common_names = csr.subject.get_attributes_for_oid(NameOID.COMMON_NAME)
        if len(common_names) != 1:
            fail("evidence source CSR common name is invalid")
        try:
            csr_san = csr.extensions.get_extension_for_class(
                x509.SubjectAlternativeName
            ).value
        except x509.ExtensionNotFound:
            fail("evidence source CSR SAN extension is missing")
        dns_sans = tuple(csr_san.get_values_for_type(x509.DNSName))
        ip_sans = tuple(
            str(value) for value in csr_san.get_values_for_type(x509.IPAddress)
        )
        if len(dns_sans) + len(ip_sans) != len(csr_san):
            fail("evidence source CSR contains unsupported SAN identities")
        historical_args = argparse.Namespace(
            artifact_sha256=args.artifact_sha256,
            common_name=common_names[0].value,
            dns_san=dns_sans,
            ip_san=ip_sans,
            minimum_remaining_lifetime_seconds=1,
        )
        validated = validate_response_files(
            {name: version_files[name] for name in RESPONSE_NAMES},
            pending, trust, historical_args, now=response_created,
        )
    finally:
        version.close()
    response = validated["response"]
    assert isinstance(response, dict)
    candidate_sha = sha256(candidate_bytes(
        response, str(validated["response_sha256"]),
        str(validated["response_signature_sha256"]),
    ))
    created = require_epoch(deployment["created_epoch"], "deployment created epoch")
    expires = require_epoch(deployment["expires_epoch"], "deployment expiry epoch")
    assert created is not None and expires is not None
    if (
        deployment["schema"] != "1"
        or deployment["request_id"] != args.request_id
        or deployment["artifact_request_id"] != args.request_id
        or deployment["artifact_manifest_sha256"] != args.artifact_sha256
        or deployment["nonce"] != response["nonce"]
        or deployment["operation"] != response["operation"]
        or deployment["service"] != args.service
        or deployment["target"] != args.target
        or deployment["request_sha256"] != response["request_sha256"]
        or deployment["response_sha256"] != validated["response_sha256"]
        or deployment["response_signature_sha256"]
        != validated["response_signature_sha256"]
        or deployment["candidate_sha256"] != candidate_sha
        or deployment["certificate_sha256"] != validated["certificate_sha256"]
        or deployment["certificate_spki_sha256"]
        != validated["certificate_spki_sha256"]
        or deployment["chain_sha256"] != validated["chain_sha256"]
        or deployment["fullchain_sha256"] != validated["fullchain_sha256"]
        or deployment["local_certificate_sha256"]
        != validated["certificate_sha256"]
        or deployment["local_key_spki_sha256"]
        != validated["certificate_spki_sha256"]
        or deployment["local_key_certificate_match"] != "true"
        or deployment["validation_boundary_sha256"] != boundary_sha
        or deployment["deployment_principal"] != args.target
        or expires <= created
        or expires - created > 86400
        or (deployment["action"], deployment["result"])
        not in {
            ("finalize", "activated"),
            ("abandon", "not-activated"),
            ("abandon", "rolled-back"),
        }
    ):
        fail("deployment evidence source or coordinate binding is invalid")

    expected_result = {
        "schema": "1", "kind": "pki-validation-result",
        "service": args.service, "target": args.target,
        "request_id": args.request_id,
        "artifact_manifest_sha256": args.artifact_sha256,
        "validation_boundary_sha256": boundary_sha,
        "action": deployment["action"], "result": deployment["result"],
        "local_validator": boundary["local_validator"],
        "remote_validator": boundary["remote_validator"],
        "endpoint": boundary["endpoint"],
        "local_service_result": result["local_service_result"],
        "local_tls_result": result["local_tls_result"],
        "remote_tls_result": result["remote_tls_result"],
        "remote_application_result": result["remote_application_result"],
        "remote_http_status": result["remote_http_status"],
        "remote_api_version": result["remote_api_version"],
        "remote_auth_challenge": result["remote_auth_challenge"],
        "served_certificate_sha256": deployment["served_certificate_sha256"],
        "served_intermediate_sha256": deployment["served_intermediate_sha256"],
        "activation_epoch": deployment["activation_epoch"],
        "validation_epoch": deployment["validation_epoch"],
        "deployment_sha256": args.deployment_sha256,
    }
    if result != expected_result:
        fail("validation result does not exactly bind deployment evidence")

    active_auth = authenticate_active(state, args, require_config=False)
    active = None if active_auth is None else active_auth["record"]
    current_rollback, _ = read_optional_state(state, "rollback")
    rollback = (
        None if current_rollback is None else parse_rollback(current_rollback, args)
    )
    action_result = (deployment["action"], deployment["result"])
    if action_result == ("abandon", "not-activated"):
        not_run_fields = (
            "local_service_result", "local_tls_result", "remote_tls_result",
            "remote_application_result", "remote_http_status",
            "remote_api_version", "remote_auth_challenge",
        )
        if (
            any(result[field] != "not-run" for field in not_run_fields)
            or deployment["served_certificate_sha256"] != "none"
            or deployment["served_intermediate_sha256"] != "none"
            or deployment["validation_result"] != "not-run"
            or deployment["activation_epoch"] != "none"
            or deployment["validation_epoch"] != "none"
            or deployment["rollback_state"] != "none"
            or deployment["rollback_hold_until_epoch"] != "none"
            or (active is not None and active["request_id"] == args.request_id)
            or (rollback is not None and rollback["activating_request_id"] == args.request_id)
        ):
            fail("not-activated abandonment evidence is inconsistent")
    else:
        activation = require_epoch(
            deployment["activation_epoch"], "deployment activation epoch"
        )
        validation = require_epoch(
            deployment["validation_epoch"], "deployment validation epoch"
        )
        assert activation is not None and validation is not None
        if (
            any(
                result[field] != "passed"
                for field in (
                    "local_service_result", "local_tls_result",
                    "remote_tls_result", "remote_application_result",
                )
            )
            or result["remote_api_version"] != "registry/2.0"
            or (result["remote_http_status"], result["remote_auth_challenge"])
            not in {("200", "not-required"), ("401", "present")}
            or HEX_RE.fullmatch(deployment["served_certificate_sha256"]) is None
            or HEX_RE.fullmatch(deployment["served_intermediate_sha256"]) is None
            or deployment["validation_result"] != "passed"
            or not activation <= validation <= created + 300
        ):
            fail("observed deployment evidence is inconsistent")
        if action_result == ("finalize", "activated"):
            if active is None or rollback is None:
                fail("activated evidence lacks current active and rollback state")
            if (
                active["request_id"] != args.request_id
                or active["artifact_manifest_sha256"] != args.artifact_sha256
                or active["certificate_sha256"] != validated["certificate_sha256"]
                or active["certificate_spki_sha256"]
                != validated["certificate_spki_sha256"]
                or active["chain_sha256"] != validated["chain_sha256"]
                or active["fullchain_sha256"] != validated["fullchain_sha256"]
                or active["activation_epoch"] != deployment["activation_epoch"]
                or rollback["activating_request_id"] != args.request_id
                or rollback["activating_artifact_manifest_sha256"]
                != args.artifact_sha256
                or deployment["served_certificate_sha256"]
                != validated["certificate_sha256"]
                or deployment["served_intermediate_sha256"]
                != validated["intermediate_sha256"]
            ):
                fail("activated evidence differs from current activation state")
            if response["operation"] == "issue":
                if (
                    deployment["rollback_state"] != "none"
                    or deployment["rollback_hold_until_epoch"] != "none"
                ):
                    fail("issue evidence contains rollback state")
            else:
                hold = require_epoch(
                    deployment["rollback_hold_until_epoch"],
                    "deployment rollback hold",
                )
                active_hold = require_epoch(
                    active["rollback_deadline_epoch"], "active rollback hold"
                )
                assert hold is not None and active_hold is not None
                if (
                    deployment["rollback_state"] != "retained"
                    or hold < created + MIN_ROLLBACK_SECONDS
                    or active_hold < hold
                ):
                    fail("activated evidence rollback hold is invalid")
        else:
            hold = require_epoch(
                deployment["rollback_hold_until_epoch"],
                "rolled-back evidence hold",
            )
            assert hold is not None
            if (
                deployment["rollback_state"] != "restored"
                or hold < created + MIN_ROLLBACK_SECONDS
                or (active is not None and active["request_id"] == args.request_id)
                or (rollback is not None and rollback["activating_request_id"] == args.request_id)
            ):
                fail("rolled-back abandonment state is inconsistent")
            if active_auth is not None:
                active_files = active_auth["files"]
                assert isinstance(active_files, dict)
                predecessor_intermediate = pem_certificates(
                    active_files["ca-chain.crt"], 2,
                    "restored predecessor chain",
                )[0]
                if (
                    deployment["served_certificate_sha256"]
                    != active["certificate_sha256"]
                    or deployment["served_intermediate_sha256"]
                    != sha256(predecessor_intermediate.public_bytes(
                        serialization.Encoding.PEM
                    ))
                ):
                    fail("rolled-back evidence differs from active predecessor")
    return {
        "files": evidence_files, "deployment": deployment,
        "validation_result": result,
    }


def evidence_journals_allow_collection(
    state: PinnedDirectory, args, deployment: Mapping[str, str]
) -> None:
    entries = state_entries(state)
    if entries & {"request.journal", "trust-install.journal", "expired-request-abandonment-journal", "expired-request-abandonment-journal.stage", "pending-request-cancellation-journal", "pending-request-cancellation-journal.stage"}:
        fail("unrelated unresolved PKI journal blocks evidence collection")
    journals = entries & {
        "activation-journal", "evidence-attempt-journal", "abandonment-journal"
    }
    if not journals:
        return
    if len(journals) != 1:
        fail("multiple lifecycle journals block evidence collection")
    name = next(iter(journals))
    data, _ = read_at(state, name, name.replace("-", " "))
    if name == "activation-journal":
        record = journal_record(data, args)
        complete = (
            record["checkpoint"] == "evidence-ready"
            and record["deployment_sha256"] == args.deployment_sha256
            and record["evidence_action"] == deployment["action"]
            and record["evidence_result"] == deployment["result"]
            and evidence_published_for_journal(state, record)
        )
    elif name == "evidence-attempt-journal":
        record = evidence_journal_record(data, args)
        complete = (
            record["checkpoint"] == "evidence-ready"
            and record["deployment_sha256"] == args.deployment_sha256
            and deployment["action"] == "finalize"
            and deployment["result"] == "activated"
            and evidence_published_for_journal(state, record)
        )
    else:
        record = abandonment_journal_record(data, args)
        complete = (
            record["deployment_sha256"] == args.deployment_sha256
            and deployment["action"] == "abandon"
            and deployment["result"] == record["result"]
            and abandonment_published_for_journal(state, record)
        )
    if not complete:
        fail("unresolved lifecycle journal does not prove completed requested evidence")


def evidence_collection_prepare(args) -> None:
    state, lock = common_open(args)
    try:
        trust, _policy = load_trust(state, args.trust_id, args.target)
        authenticated = authenticate_evidence_attempt(state, args, trust)
        deployment = authenticated["deployment"]
        files = authenticated["files"]
        assert isinstance(deployment, dict) and isinstance(files, dict)
        evidence_journals_allow_collection(state, args, deployment)

        def revalidate() -> None:
            current = authenticate_evidence_attempt(state, args, trust)
            if current["files"] != files or current["deployment"] != deployment:
                fail("requested evidence changed during collection preparation")
            evidence_journals_allow_collection(state, args, deployment)

        status_value = prepare_collection_output(
            args, EVIDENCE_NAMES, files, "evidence collection", revalidate
        )
        metadata: dict[str, object] = {
            "status": status_value, "request_id": args.request_id,
            "artifact_sha256": args.artifact_sha256,
            "deployment_sha256": args.deployment_sha256,
            "action": deployment["action"], "result": deployment["result"],
        }
        for name in EVIDENCE_NAMES:
            metadata[f"{name.replace('-', '_').replace('.', '_')}_sha256"] = sha256(
                files[name]
            )
        json_output(metadata)
    finally:
        os.close(lock)
        state.close()


def managed_predecessor_public_identity(certificate_path: str) -> dict[str, str]:
    certificate_data, _ = read_path(
        certificate_path, "managed predecessor public certificate chain", mode=0o644
    )
    certificates = pem_certificates(
        certificate_data, None, "managed predecessor public certificate chain"
    )
    if len(certificates) < 2:
        fail("managed predecessor public certificate chain lacks an intermediate")
    leaf = certificates[0]
    intermediate = certificates[1]
    return {
        "certificate_sha256": sha256(
            leaf.public_bytes(serialization.Encoding.PEM)
        ),
        "certificate_spki_sha256": spki_digest(leaf.public_key()),
        "intermediate_sha256": sha256(
            intermediate.public_bytes(serialization.Encoding.PEM)
        ),
    }


def validate_target_outcome_package(
    state: PinnedDirectory,
    args,
    trust: Mapping[str, bytes],
    policy: Mapping[str, str],
    files: Mapping[str, bytes] | None,
    *,
    reviewed_outcome: Mapping[str, str] | None = None,
    reviewed_decision: Mapping[str, str] | None = None,
) -> tuple[dict[str, str], dict[str, str], dict[str, str]]:
    if files is None:
        if reviewed_outcome is None or reviewed_decision is None:
            fail("outcome preflight lacks reviewed scalar records")
        outcome = dict(reviewed_outcome)
        decision = dict(reviewed_decision)
    else:
        if reviewed_outcome is not None or reviewed_decision is not None:
            fail("package import cannot mix reviewed scalar records")
        outcome = parse_record(files["outcome"], OUTCOME_FIELDS, "signer outcome")
        decision = parse_record(files["decision"], DECISION_FIELDS, "signer decision")
        if sha256(files["outcome"]) != args.outcome_sha256:
            fail("signer outcome differs from the supplied digest")
        if sha256(files["deployment"]) != args.deployment_sha256:
            fail("outcome deployment differs from the supplied digest")
        if files["deployers.allowed_signers"] != trust["deployers.allowed_signers"]:
            fail("outcome deployer trust differs from target-frozen trust")
        verify_ssh_signature(
            files["outcome"], files["outcome.sig"],
            trust["responses.allowed_signers"], policy["response_principal"],
            OUTCOME_NAMESPACE, "signer outcome",
        )
        verify_ssh_signature(
            files["deployment"], files["deployment.sig"],
            trust["deployers.allowed_signers"], args.target,
            DEPLOYMENT_NAMESPACE, "outcome deployment",
        )

    evidence_dir, evidence_files, _ = open_exact_tree(
        os.path.join(state.path, "evidence", args.request_id, args.deployment_sha256),
        EVIDENCE_NAMES, "outcome target evidence",
    )
    evidence_dir.close()
    if files is not None and (
        files["deployment"] != evidence_files["deployment"]
        or files["deployment.sig"] != evidence_files["deployment.sig"]
    ):
        fail("imported deployment differs from exact target evidence")
    deployment = parse_record(
        evidence_files["deployment"], DEPLOYMENT_FIELDS,
        "outcome target deployment",
    )
    verify_ssh_signature(
        evidence_files["deployment"], evidence_files["deployment.sig"],
        trust["deployers.allowed_signers"], args.target,
        DEPLOYMENT_NAMESPACE, "outcome target deployment",
    )
    verify_ssh_signature(
        evidence_files["validation-result"], evidence_files["validation-result.sig"],
        trust["deployers.allowed_signers"], args.target,
        DEPLOYMENT_NAMESPACE, "outcome validation result",
    )
    validation = parse_record(
        evidence_files["validation-result"], VALIDATION_RESULT_FIELDS,
        "outcome validation result",
    )
    boundary, _ = read_at(state, "validation-boundary", "outcome validation boundary")
    if evidence_files["validation-boundary"] != boundary:
        fail("outcome evidence differs from installed validation boundary")
    boundary_record = parse_record(
        boundary, VALIDATION_BOUNDARY_FIELDS, "installed outcome validation boundary"
    )
    boundary_sha = sha256(boundary)
    endpoint = urllib.parse.urlsplit(boundary_record["endpoint"])
    if (
        boundary_record["schema"] != "1"
        or boundary_record["kind"] != "pki-validation-boundary"
        or boundary_record["service"] != args.service
        or boundary_record["target"] != args.target
        or boundary_record["local_validator"] != args.target
        or IDENTITY_RE.fullmatch(boundary_record["remote_validator"]) is None
        or boundary_record["local_check"] != LOCAL_CHECK
        or boundary_record["remote_check"] != REMOTE_CHECK
        or endpoint.scheme != "https"
        or not endpoint.hostname
        or endpoint.path != "/v2/"
        or endpoint.query
        or endpoint.fragment
    ):
        fail("installed outcome validation boundary is invalid")

    result_pair = (deployment["action"], deployment["result"])
    if (
        deployment["schema"] != "1"
        or deployment["request_id"] != args.request_id
        or deployment["artifact_request_id"] != args.request_id
        or deployment["service"] != args.service
        or deployment["target"] != args.target
        or deployment["deployment_principal"] != args.target
        or deployment["artifact_manifest_sha256"] != args.artifact_sha256
        or result_pair not in {
            ("finalize", "activated"), ("abandon", "not-activated"),
            ("abandon", "rolled-back"),
        }
        or validation["schema"] != "1"
        or validation["kind"] != "pki-validation-result"
        or validation["request_id"] != args.request_id
        or validation["service"] != args.service
        or validation["target"] != args.target
        or validation["artifact_manifest_sha256"] != args.artifact_sha256
        or validation["validation_boundary_sha256"] != boundary_sha
        or validation["deployment_sha256"] != args.deployment_sha256
        or (validation["action"], validation["result"]) != result_pair
        or validation["local_validator"] != boundary_record["local_validator"]
        or validation["remote_validator"] != boundary_record["remote_validator"]
        or validation["endpoint"] != boundary_record["endpoint"]
        or validation["served_certificate_sha256"]
        != deployment["served_certificate_sha256"]
        or validation["served_intermediate_sha256"]
        != deployment["served_intermediate_sha256"]
        or validation["activation_epoch"] != deployment["activation_epoch"]
        or validation["validation_epoch"] != deployment["validation_epoch"]
    ):
        fail("outcome deployment does not bind exact target evidence")
    created = require_epoch(deployment["created_epoch"], "outcome deployment created epoch")
    assert created is not None
    observation_fields = (
        "local_service_result", "local_tls_result", "remote_tls_result",
        "remote_application_result",
    )
    if result_pair == ("abandon", "not-activated"):
        if (
            any(validation[name] != "not-run" for name in (
                *observation_fields, "remote_http_status", "remote_api_version",
                "remote_auth_challenge",
            ))
            or deployment["served_certificate_sha256"] != "none"
            or deployment["served_intermediate_sha256"] != "none"
            or deployment["validation_result"] != "not-run"
            or deployment["activation_epoch"] != "none"
            or deployment["validation_epoch"] != "none"
            or deployment["rollback_state"] != "none"
            or deployment["rollback_hold_until_epoch"] != "none"
        ):
            fail("outcome not-activated observation semantics are invalid")
    else:
        activation = require_epoch(
            deployment["activation_epoch"], "outcome deployment activation epoch"
        )
        validation_epoch = require_epoch(
            deployment["validation_epoch"], "outcome deployment validation epoch"
        )
        assert activation is not None and validation_epoch is not None
        require_digest(
            deployment["served_certificate_sha256"],
            "outcome served certificate",
        )
        require_digest(
            deployment["served_intermediate_sha256"],
            "outcome served intermediate",
        )
        if (
            any(validation[name] != "passed" for name in observation_fields)
            or validation["remote_api_version"] != "registry/2.0"
            or (
                validation["remote_http_status"],
                validation["remote_auth_challenge"],
            ) not in {("200", "not-required"), ("401", "present")}
            or deployment["validation_result"] != "passed"
            or not activation <= validation_epoch <= created + 300
        ):
            fail("outcome observed deployment semantics are invalid")
        if result_pair == ("finalize", "activated"):
            if (
                deployment["served_certificate_sha256"]
                != deployment["certificate_sha256"]
            ):
                fail("outcome finalized deployment serves a different certificate")
            if deployment["operation"] == "issue":
                if (
                    deployment["rollback_state"] != "none"
                    or deployment["rollback_hold_until_epoch"] != "none"
                ):
                    fail("outcome issue observation contains rollback state")
            else:
                hold = require_epoch(
                    deployment["rollback_hold_until_epoch"],
                    "outcome retained rollback hold",
                )
                assert hold is not None
                if (
                    deployment["rollback_state"] != "retained"
                    or hold < created + MIN_ROLLBACK_SECONDS
                ):
                    fail("outcome finalized rollback observation is invalid")
        else:
            hold = require_epoch(
                deployment["rollback_hold_until_epoch"],
                "outcome rolled-back hold",
            )
            assert hold is not None
            if (
                deployment["rollback_state"] != "restored"
                or hold < created + MIN_ROLLBACK_SECONDS
            ):
                fail("outcome rolled-back observation semantics are invalid")

    shared = (
        "service", "target", "request_id", "operation", "request_sha256",
        "response_sha256", "response_signature_sha256", "candidate_sha256",
        "artifact_manifest_sha256", "certificate_sha256",
        "certificate_spki_sha256", "chain_sha256", "fullchain_sha256",
        "deployment_sha256", "deployment_signature_sha256", "deployers_sha256",
        "action", "state", "resulting_active_request_id", "created_epoch",
    )
    deployment_shared = (
        "operation", "request_sha256", "response_sha256",
        "response_signature_sha256", "candidate_sha256",
        "artifact_manifest_sha256", "certificate_sha256",
        "certificate_spki_sha256", "chain_sha256", "fullchain_sha256",
        "action", "created_epoch",
    )
    expected_state = "finalized" if decision["action"] == "finalize" else "abandoned"
    predecessor_kind = decision["predecessor_kind"]
    predecessor_id = decision["predecessor_request_id"]
    predecessor_digest_fields = tuple(
        name for name in DECISION_FIELDS
        if name.startswith("predecessor_")
        and name not in {"predecessor_kind", "predecessor_request_id"}
    )
    resulting = (
        args.request_id
        if decision["action"] == "finalize"
        else predecessor_id
        if predecessor_kind == "host-local"
        else "none"
    )
    if predecessor_kind not in {"none", "managed", "host-local"}:
        fail("signer decision predecessor kind is invalid")
    if predecessor_kind == "none" and (
        predecessor_id != "none"
        or any(decision[name] != "none" for name in predecessor_digest_fields)
    ):
        fail("empty signer decision predecessor is inconsistent")
    if predecessor_kind == "managed":
        if predecessor_id != "none":
            fail("managed signer decision predecessor request ID is invalid")
        for name in (
            "predecessor_certificate_sha256",
            "predecessor_certificate_spki_sha256",
            "predecessor_intermediate_sha256",
        ):
            require_digest(decision[name], f"signer decision {name}")
        for name in (
            "predecessor_response_sha256",
            "predecessor_artifact_manifest_sha256",
            "predecessor_deployment_sha256",
            "predecessor_decision_sha256",
        ):
            if decision[name] != "none":
                fail("managed signer decision predecessor history is invalid")
    if predecessor_kind == "host-local":
        require_request_id(predecessor_id)
        for name in predecessor_digest_fields:
            require_digest(decision[name], f"signer decision {name}")
    decision_bytes = serialize_record(
        DECISION_FIELDS, decision, "reviewed signer decision"
    )
    outcome_bytes = serialize_record(
        OUTCOME_FIELDS, outcome, "reviewed signer outcome"
    )
    deployment_signature_sha = sha256(evidence_files["deployment.sig"])
    deployers_sha = sha256(trust["deployers.allowed_signers"])
    if (
        sha256(outcome_bytes) != args.outcome_sha256
        or outcome["schema"] != "1"
        or outcome["kind"] != "csr-signer-outcome"
        or outcome["service"] != args.service
        or outcome["target"] != args.target
        or outcome["request_id"] != args.request_id
        or outcome["artifact_manifest_sha256"] != args.artifact_sha256
        or outcome["deployment_sha256"] != args.deployment_sha256
        or outcome["deployment_signature_sha256"] != deployment_signature_sha
        or outcome["deployers_sha256"] != deployers_sha
        or outcome["decision_sha256"] != sha256(decision_bytes)
        or outcome["outcome_principal"] != policy["response_principal"]
        or decision["schema"] != "1"
        or decision["state"] != expected_state
        or decision["resulting_active_request_id"] != resulting
        or any(outcome[name] != decision[name] for name in shared)
        or any(decision[name] != deployment[name] for name in deployment_shared)
    ):
        fail("signer outcome and decision cross-binding is invalid")
    for name in (
        "request_sha256", "response_sha256", "response_signature_sha256",
        "candidate_sha256", "artifact_manifest_sha256", "certificate_sha256",
        "certificate_spki_sha256", "chain_sha256", "fullchain_sha256",
        "deployment_sha256", "deployment_signature_sha256", "deployers_sha256",
        "decision_sha256",
    ):
        require_digest(outcome[name], f"signer outcome {name}")
    require_epoch(outcome["created_epoch"], "signer outcome created epoch")

    active_data, _ = read_optional_state(state, "active")
    active = None if active_data is None else parse_active(active_data, args)
    rollback_data, _ = read_optional_state(state, "rollback")
    rollback = None if rollback_data is None else parse_rollback(rollback_data, args)
    if decision["action"] == "finalize":
        if (
            active is None or rollback is None
            or active["request_id"] != args.request_id
            or active["artifact_manifest_sha256"] != args.artifact_sha256
            or active["certificate_sha256"] != outcome["certificate_sha256"]
            or active["certificate_spki_sha256"] != outcome["certificate_spki_sha256"]
            or active["chain_sha256"] != outcome["chain_sha256"]
            or active["fullchain_sha256"] != outcome["fullchain_sha256"]
            or rollback["activating_request_id"] != args.request_id
            or rollback["predecessor_kind"] != predecessor_kind
            or rollback["predecessor_request_id"] != predecessor_id
            or rollback["predecessor_certificate_sha256"]
            != decision["predecessor_certificate_sha256"]
            or rollback["predecessor_certificate_spki_sha256"]
            != decision["predecessor_certificate_spki_sha256"]
        ):
            fail("finalized signer outcome differs from current target active state")
        if predecessor_kind == "host-local":
            fail(
                "host-local predecessor outcome requires authenticated predecessor "
                "intermediate, response, deployment, and decision digests absent "
                "from the rollback record"
            )
        managed_identity = (
            managed_predecessor_public_identity(rollback["prior_zot_cert_path"])
            if predecessor_kind == "managed"
            else None
        )
        predecessor_expected = {
            "predecessor_kind": rollback["predecessor_kind"],
            "predecessor_request_id": rollback["predecessor_request_id"],
            "predecessor_certificate_sha256": rollback[
                "predecessor_certificate_sha256"
            ],
            "predecessor_certificate_spki_sha256": rollback[
                "predecessor_certificate_spki_sha256"
            ],
            "predecessor_intermediate_sha256": (
                managed_identity["intermediate_sha256"]
                if managed_identity is not None else "none"
            ),
            "predecessor_response_sha256": "none",
            "predecessor_artifact_manifest_sha256": rollback[
                "predecessor_artifact_manifest_sha256"
            ],
            "predecessor_deployment_sha256": "none",
            "predecessor_decision_sha256": "none",
        }
        if managed_identity is not None and (
            rollback["predecessor_certificate_sha256"]
            != managed_identity["certificate_sha256"]
            or rollback["predecessor_certificate_spki_sha256"]
            != managed_identity["certificate_spki_sha256"]
        ):
            fail("managed predecessor public certificate differs from rollback history")
        if any(decision[name] != value for name, value in predecessor_expected.items()):
            fail("finalized signer outcome predecessor differs from rollback history")
    else:
        if predecessor_kind == "managed" and result_pair == (
            "abandon", "rolled-back"
        ):
            config_data, _ = read_path(
                args.zot_config, "restored managed Zot configuration", mode=0o644
            )
            _config, certificate_path, _key_path = parse_zot_config(config_data)
            managed_identity = managed_predecessor_public_identity(certificate_path)
            predecessor_expected = {
                "predecessor_kind": "managed",
                "predecessor_request_id": "none",
                "predecessor_certificate_sha256": managed_identity[
                    "certificate_sha256"
                ],
                "predecessor_certificate_spki_sha256": managed_identity[
                    "certificate_spki_sha256"
                ],
                "predecessor_intermediate_sha256": managed_identity[
                    "intermediate_sha256"
                ],
                "predecessor_response_sha256": "none",
                "predecessor_artifact_manifest_sha256": "none",
                "predecessor_deployment_sha256": "none",
                "predecessor_decision_sha256": "none",
            }
            if (
                deployment["served_certificate_sha256"]
                != managed_identity["certificate_sha256"]
                or deployment["served_intermediate_sha256"]
                != managed_identity["intermediate_sha256"]
                or deployment["rollback_state"] != "restored"
                or any(
                    decision[name] != value
                    for name, value in predecessor_expected.items()
                )
            ):
                fail(
                    "abandoned managed predecessor differs from restored Zot "
                    "certificate and rollback evidence"
                )
        elif predecessor_kind != "none":
            fail(
                "abandoned outcome predecessor requires the candidate rollback "
                "record, which is unavailable after terminal abandonment"
            )
        if active is not None and active["request_id"] == args.request_id:
            fail("abandoned signer outcome candidate is still target active")
        if resulting == "none":
            if active is not None:
                fail("abandoned signer outcome unexpectedly leaves a host-local active identity")
        elif active is None or active["request_id"] != resulting:
            fail("abandoned signer outcome resulting active identity differs from target")
    return outcome, decision, deployment


def ensure_outcome_directory(parent: PinnedDirectory, name: str, label: str) -> PinnedDirectory:
    try:
        os.mkdir(name, 0o700, dir_fd=parent.fd)
        os.fsync(parent.fd)
    except FileExistsError:
        pass
    return PinnedDirectory.open(os.path.join(parent.path, name), label)


def validate_outcome_history_layout(
    state: PinnedDirectory, args
) -> set[tuple[str, str]]:
    coordinates: set[tuple[str, str]] = set()
    if "outcomes" not in scan(state, "state root"):
        return coordinates
    root = PinnedDirectory.open(
        os.path.join(state.path, "outcomes"), "signer outcome history root"
    )
    try:
        for request_id, metadata in scan(root, "signer outcome history root").items():
            if REQUEST_ID_RE.fullmatch(request_id) is None or not stat.S_ISDIR(metadata.st_mode):
                fail("signer outcome history contains an invalid request entry")
            request = PinnedDirectory.open(
                os.path.join(root.path, request_id), "signer outcome request history"
            )
            try:
                for outcome_sha, outcome_metadata in scan(
                    request, "signer outcome request history"
                ).items():
                    if HEX_RE.fullmatch(outcome_sha) is None or not stat.S_ISDIR(outcome_metadata.st_mode):
                        fail("signer outcome request history contains an invalid digest entry")
                    coordinates.add((request_id, outcome_sha))
                    history, files, identities = open_exact_tree(
                        os.path.join(request.path, outcome_sha),
                        OUTCOME_NAMES,
                        "immutable signer outcome history",
                    )
                    try:
                        outcome = parse_record(
                            files["outcome"], OUTCOME_FIELDS, "historical signer outcome"
                        )
                        if (
                            sha256(files["outcome"]) != outcome_sha
                            or outcome["request_id"] != request_id
                            or outcome["service"] != args.service
                            or outcome["target"] != args.target
                        ):
                            fail("signer outcome history coordinate binding is invalid")
                        recheck_exact_tree(
                            history,
                            OUTCOME_NAMES,
                            identities,
                            "immutable signer outcome history",
                        )
                    finally:
                        history.close()
            finally:
                request.close()
    finally:
        root.close()
    return coordinates


def publish_outcome_history(
    state: PinnedDirectory, args, files: Mapping[str, bytes], pre_publish
) -> tuple[bool, str]:
    root = ensure_outcome_directory(state, "outcomes", "signer outcome history root")
    request = ensure_outcome_directory(root, args.request_id, "signer outcome request history")
    path = os.path.join(request.path, args.outcome_sha256)
    try:
        entries = scan(request, "signer outcome request history")
        if args.outcome_sha256 in entries:
            existing, existing_files, _ = open_exact_tree(
                path, OUTCOME_NAMES, "existing signer outcome history"
            )
            existing.close()
            if existing_files != dict(files):
                fail("existing signer outcome history conflicts with imported package")
            return False, path
        stage_name = f".outcome-stage-{secrets.token_hex(16)}"
        os.mkdir(stage_name, 0o700, dir_fd=request.fd)
        stage = PinnedDirectory.open(
            os.path.join(request.path, stage_name), "signer outcome history stage"
        )
        stage_identity = dir_identity(os.fstat(stage.fd))
        published = False
        created: dict[str, tuple[int, ...]] = {}
        try:
            for name in OUTCOME_NAMES:
                created[name] = write_new_at(
                    stage, name, files[name], f"signer outcome history file {name}"
                )
            os.fsync(stage.fd)
            fault("before-outcome-history-publication")
            pre_publish()
            rename_noreplace(
                request, stage_name, args.outcome_sha256,
                "signer outcome history publication",
            )
            published = True
            os.fsync(request.fd)
            fault("after-outcome-history-publication")
        finally:
            stage.close()
            if not published:
                try:
                    actual = os.stat(stage_name, dir_fd=request.fd, follow_symlinks=False)
                    if dir_identity(actual) == stage_identity:
                        cleanup = PinnedDirectory.open(
                            os.path.join(request.path, stage_name),
                            "signer outcome history cleanup stage",
                        )
                        try:
                            for name, identity in created.items():
                                require_snapshot(cleanup, name, identity, f"signer outcome cleanup {name}")
                                os.unlink(name, dir_fd=cleanup.fd)
                        finally:
                            cleanup.close()
                        os.rmdir(stage_name, dir_fd=request.fd)
                        os.fsync(request.fd)
                except FileNotFoundError:
                    pass
        existing, existing_files, _ = open_exact_tree(
            path, OUTCOME_NAMES, "published signer outcome history"
        )
        existing.close()
        if existing_files != dict(files):
            fail("published signer outcome history bytes changed")
        return True, path
    finally:
        request.close()
        root.close()


def accepted_outcome_pointer(
    args, outcome: Mapping[str, str], decision_sha256: str
) -> bytes:
    return serialize_record(
        ACCEPTED_OUTCOME_FIELDS,
        {
            "schema": "1", "kind": "host-local-accepted-signer-outcome",
            "service": args.service, "target": args.target,
            "request_id": args.request_id,
            "artifact_manifest_sha256": args.artifact_sha256,
            "deployment_sha256": args.deployment_sha256,
            "outcome_sha256": args.outcome_sha256,
            "decision_sha256": decision_sha256,
            "action": outcome["action"], "state": outcome["state"],
            "resulting_active_request_id": outcome["resulting_active_request_id"],
        },
        "accepted signer outcome pointer",
    )


def outcome_preflight(args) -> None:
    state, lock = common_open(args, shared=True)
    try:
        entries = state_entries(state)
        if entries & {
            "activation-journal", "evidence-attempt-journal", "abandonment-journal",
            "expired-request-abandonment-journal",
            "expired-request-abandonment-journal.stage",
            "pending-request-cancellation-journal",
            "pending-request-cancellation-journal.stage", "request.journal",
            "trust-install.journal",
        }:
            fail("unresolved lifecycle state blocks signer-outcome preflight")
        history_coordinates = validate_outcome_history_layout(state, args)
        trust, policy = load_trust(state, args.trust_id, args.target)
        authenticate_active_public(state, args, trust, policy)
        expected_coordinate = (args.request_id, args.outcome_sha256)
        if history_coordinates - {expected_coordinate}:
            fail("unrelated signer outcome history blocks scalar preflight")
        decision = {
            name: "1" if name == "schema" else getattr(
                args, f"decision_{name}"
            )
            for name in DECISION_FIELDS
        }
        outcome_values = {
            name: decision[name]
            for name in OUTCOME_FIELDS
            if name in decision
        }
        outcome_values.update(
            schema="1",
            kind="csr-signer-outcome",
            decision_sha256=args.decision_sha256,
            outcome_principal=args.outcome_principal,
        )
        outcome, decision, _deployment = validate_target_outcome_package(
            state,
            args,
            trust,
            policy,
            None,
            reviewed_outcome=outcome_values,
            reviewed_decision=decision,
        )
        pointer = accepted_outcome_pointer(
            args, outcome, args.decision_sha256
        )
        existing_pointer, _ = read_optional_state(state, "accepted-outcome")
        history_path = os.path.join(
            state.path, "outcomes", args.request_id, args.outcome_sha256
        )
        history_records = None
        if os.path.lexists(history_path):
            history, history_files, _ = open_exact_tree(
                history_path, OUTCOME_NAMES, "preflight outcome history"
            )
            history.close()
            historical_outcome, historical_decision, _ = validate_target_outcome_package(
                state, args, trust, policy, history_files
            )
            if historical_outcome != outcome or historical_decision != decision:
                fail("signer outcome history conflicts with preflight")
            history_records = (historical_outcome, historical_decision)
        if existing_pointer is None:
            status_value = "would-import"
        else:
            if existing_pointer != pointer:
                fail("accepted signer outcome pointer conflicts with preflight")
            if history_records is None:
                fail("accepted signer outcome history is absent during preflight")
            status_value = "existing"
        json_output({
            "status": status_value, "request_id": args.request_id,
            "artifact_sha256": args.artifact_sha256,
            "deployment_sha256": args.deployment_sha256,
            "outcome_sha256": args.outcome_sha256,
            "action": outcome["action"], "result": _deployment["result"],
            "state": outcome["state"],
            "resulting_active_request_id": decision["resulting_active_request_id"],
            "history_path": history_path,
        })
    finally:
        os.close(lock)
        state.close()


def outcome_import(args) -> None:
    state, lock = common_open(args, shared=args.check)
    package = None
    try:
        entries = state_entries(state)
        unresolved = entries & {
            "activation-journal", "evidence-attempt-journal", "abandonment-journal",
            "expired-request-abandonment-journal", "expired-request-abandonment-journal.stage",
            "pending-request-cancellation-journal", "pending-request-cancellation-journal.stage",
            "request.journal", "trust-install.journal",
        }
        if unresolved:
            fail("unresolved lifecycle state blocks signer-outcome import")
        validate_outcome_history_layout(state, args)
        trust, policy = load_trust(state, args.trust_id, args.target)
        authenticate_active_public(state, args, trust, policy)
        package, files, package_identities = open_exact_tree(
            args.outcome_dir, OUTCOME_NAMES, "imported signer-outcome package"
        )
        outcome, decision, _deployment = validate_target_outcome_package(
            state, args, trust, policy, files
        )
        recheck_exact_tree(
            package,
            OUTCOME_NAMES,
            package_identities,
            "imported signer-outcome package",
        )
        pointer = accepted_outcome_pointer(
            args, outcome, sha256(files["decision"])
        )
        existing_pointer, _ = read_optional_state(state, "accepted-outcome")
        history_path = os.path.join(
            state.path, "outcomes", args.request_id, args.outcome_sha256
        )
        if existing_pointer is not None:
            if existing_pointer != pointer:
                fail("accepted signer outcome pointer conflicts with imported package")
            history, history_files, _ = open_exact_tree(
                history_path, OUTCOME_NAMES, "accepted signer outcome history"
            )
            history.close()
            if history_files != files:
                fail("accepted signer outcome history conflicts with imported package")
            status_value = "existing"
        elif args.check:
            status_value = "would-import"
        else:
            _created, history_path = publish_outcome_history(
                state,
                args,
                files,
                lambda: recheck_exact_tree(
                    package,
                    OUTCOME_NAMES,
                    package_identities,
                    "imported signer-outcome package",
                ),
            )
            recheck_exact_tree(
                package,
                OUTCOME_NAMES,
                package_identities,
                "imported signer-outcome package",
            )
            fault("before-accepted-outcome-publication")
            atomic_create_at(
                state, "accepted-outcome", pointer,
                "accepted signer outcome pointer",
            )
            status_value = "imported"
        json_output({
            "status": status_value, "request_id": args.request_id,
            "artifact_sha256": args.artifact_sha256,
            "deployment_sha256": args.deployment_sha256,
            "outcome_sha256": args.outcome_sha256,
            "action": outcome["action"], "result": _deployment["result"],
            "state": outcome["state"],
            "resulting_active_request_id": decision["resulting_active_request_id"],
            "history_path": history_path,
        })
    finally:
        if package is not None:
            package.close()
        os.close(lock)
        state.close()


def validate_evidence(
    state: PinnedDirectory, args, active: Mapping[str, str]
) -> tuple[str, frozenset[str]]:
    evidence_root_path = os.path.join(state.path, "evidence")
    if not os.path.lexists(evidence_root_path):
        return "none", frozenset()
    root = PinnedDirectory.open(evidence_root_path, "evidence root")
    try:
        entries = scan(root, "evidence root")
        if any(REQUEST_ID_RE.fullmatch(name) is None or not stat.S_ISDIR(metadata.st_mode) for name, metadata in entries.items()):
            fail("evidence root contains an invalid request entry")
        request_path = os.path.join(evidence_root_path, active["request_id"])
        if active["request_id"] not in entries:
            return "none", frozenset()
        request = PinnedDirectory.open(request_path, "active evidence request root")
        try:
            attempts = scan(request, "active evidence request root")
            matches: list[str] = []
            trust, _ = load_trust(state, args.trust_id, args.target)
            for digest, metadata in attempts.items():
                if HEX_RE.fullmatch(digest) is None or not stat.S_ISDIR(metadata.st_mode):
                    fail("active evidence request root contains an invalid attempt")
                directory, files, _ = open_exact_tree(os.path.join(request_path, digest), EVIDENCE_NAMES, "target evidence")
                directory.close()
                deployment = parse_record(files["deployment"], DEPLOYMENT_FIELDS, "deployment evidence")
                result = parse_record(files["validation-result"], VALIDATION_RESULT_FIELDS, "validation result")
                boundary = parse_record(files["validation-boundary"], VALIDATION_BOUNDARY_FIELDS, "evidence validation boundary")
                if sha256(files["deployment"]) != digest or result["deployment_sha256"] != digest:
                    fail("evidence coordinate does not match deployment bytes")
                verify_ssh_signature(files["deployment"], files["deployment.sig"], trust["deployers.allowed_signers"], args.target, DEPLOYMENT_NAMESPACE, "deployment")
                verify_ssh_signature(files["validation-result"], files["validation-result.sig"], trust["deployers.allowed_signers"], args.target, DEPLOYMENT_NAMESPACE, "validation result")
                if (
                    boundary["schema"] != "1"
                    or boundary["kind"] != "pki-validation-boundary"
                    or boundary["service"] != args.service
                    or boundary["target"] != args.target
                    or boundary["local_validator"] != args.target
                    or IDENTITY_RE.fullmatch(boundary["remote_validator"]) is None
                    or boundary["local_check"] != LOCAL_CHECK
                    or boundary["remote_check"] != REMOTE_CHECK
                ):
                    fail("evidence validation boundary identity is invalid")
                endpoint = urllib.parse.urlsplit(boundary["endpoint"])
                if endpoint.scheme != "https" or not endpoint.hostname or endpoint.path != "/v2/" or endpoint.query or endpoint.fragment:
                    fail("evidence validation boundary endpoint is invalid")
                boundary_sha = sha256(files["validation-boundary"])
                action_result = (deployment["action"], deployment["result"])
                if action_result != ("finalize", "activated"):
                    created = require_epoch(
                        deployment["created_epoch"],
                        "historical abandonment created epoch",
                    )
                    expires = require_epoch(
                        deployment["expires_epoch"],
                        "historical abandonment expiry epoch",
                    )
                    assert created is not None and expires is not None
                    if (
                        action_result not in {
                            ("abandon", "not-activated"),
                            ("abandon", "rolled-back"),
                        }
                        or deployment["schema"] != "1"
                        or deployment["request_id"] != active["request_id"]
                        or deployment["artifact_request_id"] != active["request_id"]
                        or deployment["artifact_manifest_sha256"]
                        != active["artifact_manifest_sha256"]
                        or deployment["response_sha256"] != active["response_sha256"]
                        or deployment["response_signature_sha256"]
                        != active["response_signature_sha256"]
                        or deployment["certificate_sha256"]
                        != active["certificate_sha256"]
                        or deployment["certificate_spki_sha256"]
                        != active["certificate_spki_sha256"]
                        or deployment["chain_sha256"] != active["chain_sha256"]
                        or deployment["fullchain_sha256"] != active["fullchain_sha256"]
                        or HEX_RE.fullmatch(deployment["nonce"]) is None
                        or deployment["operation"] not in {"issue", "migrate", "renew"}
                        or HEX_RE.fullmatch(deployment["request_sha256"]) is None
                        or HEX_RE.fullmatch(deployment["candidate_sha256"]) is None
                        or deployment["service"] != args.service
                        or deployment["target"] != args.target
                        or deployment["deployment_principal"] != args.target
                        or deployment["local_certificate_sha256"]
                        != active["certificate_sha256"]
                        or deployment["local_key_spki_sha256"]
                        != active["certificate_spki_sha256"]
                        or deployment["local_key_certificate_match"] != "true"
                        or deployment["validation_boundary_sha256"] != boundary_sha
                        or expires <= created
                        or expires - created > 86400
                        or created > lifecycle_epoch() + 300
                        or result["schema"] != "1"
                        or result["kind"] != "pki-validation-result"
                        or result["service"] != args.service
                        or result["target"] != args.target
                        or result["request_id"] != active["request_id"]
                        or result["artifact_manifest_sha256"]
                        != active["artifact_manifest_sha256"]
                        or result["validation_boundary_sha256"] != boundary_sha
                        or (result["action"], result["result"]) != action_result
                        or result["local_validator"] != boundary["local_validator"]
                        or result["remote_validator"] != boundary["remote_validator"]
                        or result["endpoint"] != boundary["endpoint"]
                        or result["served_certificate_sha256"]
                        != deployment["served_certificate_sha256"]
                        or result["served_intermediate_sha256"]
                        != deployment["served_intermediate_sha256"]
                        or result["activation_epoch"] != deployment["activation_epoch"]
                        or result["validation_epoch"] != deployment["validation_epoch"]
                        or result["deployment_sha256"] != digest
                    ):
                        fail("historical abandonment evidence binding is invalid")
                    observed_fields = (
                        "local_service_result", "local_tls_result",
                        "remote_tls_result", "remote_application_result",
                    )
                    if action_result == ("abandon", "not-activated"):
                        not_run_fields = (
                            *observed_fields, "remote_http_status",
                            "remote_api_version", "remote_auth_challenge",
                        )
                        if (
                            any(result[field] != "not-run" for field in not_run_fields)
                            or deployment["served_certificate_sha256"] != "none"
                            or deployment["served_intermediate_sha256"] != "none"
                            or deployment["validation_result"] != "not-run"
                            or deployment["activation_epoch"] != "none"
                            or deployment["validation_epoch"] != "none"
                            or deployment["rollback_state"] != "none"
                            or deployment["rollback_hold_until_epoch"] != "none"
                        ):
                            fail("historical not-activated evidence is inconsistent")
                    else:
                        activation = require_epoch(
                            deployment["activation_epoch"],
                            "historical rolled-back activation epoch",
                        )
                        validation = require_epoch(
                            deployment["validation_epoch"],
                            "historical rolled-back validation epoch",
                        )
                        hold = require_epoch(
                            deployment["rollback_hold_until_epoch"],
                            "historical rolled-back hold",
                        )
                        assert activation is not None and validation is not None and hold is not None
                        if (
                            deployment["operation"] == "issue"
                            or any(result[field] != "passed" for field in observed_fields)
                            or result["remote_api_version"] != "registry/2.0"
                            or (
                                result["remote_http_status"],
                                result["remote_auth_challenge"],
                            ) not in {("200", "not-required"), ("401", "present")}
                            or HEX_RE.fullmatch(deployment["served_certificate_sha256"])
                            is None
                            or HEX_RE.fullmatch(deployment["served_intermediate_sha256"])
                            is None
                            or deployment["validation_result"] != "passed"
                            or not activation <= validation <= created + 300
                            or deployment["rollback_state"] != "restored"
                            or hold < created + MIN_ROLLBACK_SECONDS
                        ):
                            fail("historical rolled-back evidence is inconsistent")
                    continue
                activation = require_epoch(deployment["activation_epoch"], "evidence activation epoch")
                validation = require_epoch(deployment["validation_epoch"], "evidence validation epoch")
                created = require_epoch(deployment["created_epoch"], "evidence created epoch")
                expires = require_epoch(deployment["expires_epoch"], "evidence expiry epoch")
                assert activation is not None and validation is not None and created is not None and expires is not None
                if (
                    deployment["schema"] != "1"
                    or deployment["request_id"] != active["request_id"]
                    or deployment["artifact_request_id"] != active["request_id"]
                    or deployment["artifact_manifest_sha256"] != active["artifact_manifest_sha256"]
                    or deployment["response_sha256"] != active["response_sha256"]
                    or deployment["response_signature_sha256"] != active["response_signature_sha256"]
                    or deployment["certificate_sha256"] != active["certificate_sha256"]
                    or deployment["certificate_spki_sha256"] != active["certificate_spki_sha256"]
                    or deployment["chain_sha256"] != active["chain_sha256"]
                    or deployment["fullchain_sha256"] != active["fullchain_sha256"]
                    or deployment["service"] != args.service
                    or deployment["target"] != args.target
                    or deployment["deployment_principal"] != args.target
                    or deployment["action"] != "finalize"
                    or deployment["result"] != "activated"
                    or deployment["local_certificate_sha256"] != active["certificate_sha256"]
                    or deployment["local_key_spki_sha256"] != active["certificate_spki_sha256"]
                    or deployment["local_key_certificate_match"] != "true"
                    or deployment["served_certificate_sha256"] != active["certificate_sha256"]
                    or HEX_RE.fullmatch(deployment["served_intermediate_sha256"]) is None
                    or deployment["validation_boundary_sha256"] != boundary_sha
                    or deployment["validation_result"] != "passed"
                    or deployment["activation_epoch"] != active["activation_epoch"]
                    or not activation <= validation <= created + 300
                    or expires <= created or expires - created > 86400
                ):
                    fail("deployment evidence does not authenticate the active candidate")
                if deployment["operation"] == "issue":
                    if (
                        deployment["rollback_state"] != "none"
                        or deployment["rollback_hold_until_epoch"] != "none"
                    ):
                        fail("issue evidence contains rollback state")
                else:
                    hold = require_epoch(
                        deployment["rollback_hold_until_epoch"],
                        "evidence rollback hold",
                    )
                    if (
                        deployment["rollback_state"] != "retained"
                        or hold is None
                        or hold < created + MIN_ROLLBACK_SECONDS
                    ):
                        fail("deployment evidence rollback hold is insufficient")
                expected_result = {
                    "schema": "1", "kind": "pki-validation-result",
                    "service": args.service, "target": args.target,
                    "request_id": active["request_id"],
                    "artifact_manifest_sha256": active["artifact_manifest_sha256"],
                    "validation_boundary_sha256": boundary_sha,
                    "action": "finalize", "result": "activated",
                    "local_validator": boundary["local_validator"],
                    "remote_validator": boundary["remote_validator"],
                    "endpoint": boundary["endpoint"],
                    "local_service_result": "passed", "local_tls_result": "passed",
                    "remote_tls_result": "passed", "remote_application_result": "passed",
                    "remote_http_status": result["remote_http_status"],
                    "remote_api_version": "registry/2.0",
                    "remote_auth_challenge": result["remote_auth_challenge"],
                    "served_certificate_sha256": deployment["served_certificate_sha256"],
                    "served_intermediate_sha256": deployment["served_intermediate_sha256"],
                    "activation_epoch": deployment["activation_epoch"],
                    "validation_epoch": deployment["validation_epoch"],
                    "deployment_sha256": digest,
                }
                if (
                    result != expected_result
                    or (result["remote_http_status"], result["remote_auth_challenge"])
                    not in {("200", "not-required"), ("401", "present")}
                ):
                    fail("validation result does not bind the exact deployment")
                if (
                    deployment["request_id"] == active["request_id"]
                    and deployment["artifact_manifest_sha256"] == active["artifact_manifest_sha256"]
                    and deployment["certificate_sha256"] == active["certificate_sha256"]
                    and deployment["action"] == "finalize" and deployment["result"] == "activated"
                    and result["action"] == "finalize" and result["result"] == "activated"
                    and boundary["service"] == args.service and boundary["target"] == args.target
                ):
                    matches.append(digest)
            return (
                ("target-published", frozenset(matches))
                if matches else ("none", frozenset())
            )
        finally:
            request.close()
    finally:
        root.close()


def status(args) -> None:
    state, lock = common_open(args, shared=True)
    try:
        if args.outcome_sha256 is not None:
            require_digest(args.outcome_sha256, "outcome_sha256")
        entries = state_entries(state)
        validate_outcome_history_layout(state, args)
        trust, _policy = load_trust(state, args.trust_id, args.target)
        recovery = False
        activation_checkpoint: str | None = None
        abandonment_result: str | None = None
        if "activation-journal" in entries:
            activation_checkpoint = journal_record(
                read_at(state, "activation-journal", "activation journal")[0], args
            )["checkpoint"]
            if activation_checkpoint in {"not-activated", "rolled-back"}:
                abandonment_result = activation_checkpoint
            else:
                recovery = True
        if "evidence-attempt-journal" in entries:
            evidence_journal_record(
                read_at(
                    state, "evidence-attempt-journal", "evidence attempt journal"
                )[0],
                args,
            )
            recovery = True
        if "abandonment-journal" in entries:
            abandonment_journal_record(
                read_at(
                    state, "abandonment-journal", "abandonment journal"
                )[0],
                args,
            )
            recovery = True
        if entries & {"request.journal", "trust-install.journal", "expired-request-abandonment-journal", "expired-request-abandonment-journal.stage", "pending-request-cancellation-journal", "pending-request-cancellation-journal.stage"}:
            fail("another unresolved PKI journal blocks lifecycle status")
        accepted: dict[str, str] | None = None
        pointer_data, _pointer_identity = read_optional_state(state, "accepted-outcome")
        if pointer_data is None:
            if "outcomes" in entries:
                fail("signer outcome history exists without an accepted pointer")
            if args.outcome_sha256 is not None:
                fail("exact accepted signer outcome is absent")
        else:
            pointer = parse_record(
                pointer_data, ACCEPTED_OUTCOME_FIELDS, "accepted signer outcome pointer"
            )
            if (
                pointer["schema"] != "1"
                or pointer["kind"] != "host-local-accepted-signer-outcome"
                or pointer["service"] != args.service
                or pointer["target"] != args.target
            ):
                fail("accepted signer outcome pointer identity is invalid")
            require_request_id(pointer["request_id"])
            for field in (
                "artifact_manifest_sha256", "deployment_sha256",
                "outcome_sha256", "decision_sha256",
            ):
                require_digest(pointer[field], f"accepted outcome {field}")
            synthetic = argparse.Namespace(**vars(args))
            synthetic.request_id = pointer["request_id"]
            synthetic.artifact_sha256 = pointer["artifact_manifest_sha256"]
            synthetic.deployment_sha256 = pointer["deployment_sha256"]
            synthetic.outcome_sha256 = pointer["outcome_sha256"]
            history_path = os.path.join(
                state.path, "outcomes", pointer["request_id"], pointer["outcome_sha256"]
            )
            history, history_files, _ = open_exact_tree(
                history_path, OUTCOME_NAMES, "accepted signer outcome history"
            )
            history.close()
            authenticated_outcome, _decision, _deployment = validate_target_outcome_package(
                state, synthetic, trust, _policy, history_files
            )
            if (
                pointer["decision_sha256"] != sha256(history_files["decision"])
                or pointer["action"] != authenticated_outcome["action"]
                or pointer["state"] != authenticated_outcome["state"]
                or pointer["resulting_active_request_id"]
                != authenticated_outcome["resulting_active_request_id"]
            ):
                fail("accepted signer outcome pointer does not bind authenticated history")
            if (
                args.outcome_sha256 is not None
                and pointer["outcome_sha256"] != args.outcome_sha256
            ):
                fail("accepted signer outcome differs from the exact requested coordinate")
            accepted = pointer
            if args.controller_evidence_exported and args.deployment_sha256 != pointer["deployment_sha256"]:
                fail("controller evidence coordinate conflicts with accepted signer outcome")
        pending_id = "none"
        pending_expires: int | str = "none"
        pending_state: dict[str, object] | None = None
        if os.path.lexists(args.pending_root):
            pending_root = PinnedDirectory.open(args.pending_root, "pending root")
            try:
                pending_entries = scan(pending_root, "pending root")
                if len(pending_entries) > 1:
                    fail("pending root contains multiple requests")
                if pending_entries:
                    name, metadata = next(iter(pending_entries.items()))
                    if REQUEST_ID_RE.fullmatch(name) is None or not stat.S_ISDIR(metadata.st_mode):
                        fail("pending root contains an invalid request entry")
                    pending_state = validate_pending(os.path.join(args.pending_root, name), trust)
                    pending_id = name
                    pending_expires = pending_state["expires"]
            finally:
                pending_root.close()
        active_auth = authenticate_active(
            state, args, require_config=activation_checkpoint != "records-written"
        )
        now = int(time.time())
        active_values: dict[str, object] = {
            "active_request_id": "none", "active_artifact_sha256": "none",
            "active_certificate_sha256": "none", "active_spki_sha256": "none",
            "active_not_before_epoch": "none", "active_not_after_epoch": "none",
            "remaining_lifetime_seconds": "none",
        }
        evidence_state = "none"
        evidence_digests: frozenset[str] = frozenset()
        if active_auth is not None:
            active = active_auth["record"]
            rollback_data, _ = read_optional_state(state, "rollback")
            if rollback_data is None:
                fail("active state lacks its rollback record")
            rollback = parse_rollback(rollback_data, args)
            if (
                rollback["activating_request_id"] != active["request_id"]
                or rollback["activating_artifact_manifest_sha256"] != active["artifact_manifest_sha256"]
                or rollback["activating_certificate_sha256"] != active["certificate_sha256"]
                or rollback["activating_version_path"] != active["version_path"]
                or rollback["activating_version_device"] != active["version_device"]
                or rollback["activating_version_inode"] != active["version_inode"]
                or rollback["activation_epoch"] != active["activation_epoch"]
                or rollback["rollback_deadline_epoch"] != active["rollback_deadline_epoch"]
            ):
                fail("active and rollback records do not bind one activation")
            active_values.update(
                active_request_id=active["request_id"], active_artifact_sha256=active["artifact_manifest_sha256"],
                active_certificate_sha256=active["certificate_sha256"], active_spki_sha256=active["certificate_spki_sha256"],
                active_not_before_epoch=active_auth["not_before_epoch"], active_not_after_epoch=active_auth["not_after_epoch"],
                remaining_lifetime_seconds=max(0, int(active_auth["not_after_epoch"]) - now),
            )
            evidence_state, evidence_digests = validate_evidence(state, args, active)
            if args.controller_evidence_exported:
                if evidence_state != "target-published" or args.deployment_sha256 not in evidence_digests:
                    fail("controller export claim lacks exact authenticated target evidence")
                evidence_state = "controller-exported"
        if accepted is not None:
            evidence_state = "controller-exported"
        conflict = False
        response_ready = False
        if os.path.lexists(args.versions_root):
            versions = PinnedDirectory.open(args.versions_root, "versions root")
            try:
                for name, metadata in scan(versions, "versions root").items():
                    if name.startswith(".ingress-"):
                        request_id = name.removeprefix(".ingress-")
                        if REQUEST_ID_RE.fullmatch(request_id) is None:
                            fail("versions root contains invalid ingress")
                        ingress, ingress_files, _ = open_exact_tree(os.path.join(args.versions_root, name), RESPONSE_NAMES, "response ingress")
                        ingress.close()
                        if pending_state is None or request_id != pending_id:
                            conflict = True
                        else:
                            synthetic = argparse.Namespace(**vars(args))
                            synthetic.request_id = request_id
                            synthetic.artifact_sha256 = sha256(ingress_files["artifact"])
                            validate_response_files(ingress_files, pending_state, trust, synthetic)
                            response_ready = True
                    elif REQUEST_ID_RE.fullmatch(name) is not None and stat.S_ISDIR(metadata.st_mode):
                        version, version_files, _ = validate_version(os.path.join(args.versions_root, name), name)
                        version.close()
                        if active_auth is None or name != active_auth["record"]["request_id"]:
                            if name == pending_id:
                                assert pending_state is not None
                                synthetic = argparse.Namespace(**vars(args))
                                synthetic.request_id = name
                                synthetic.artifact_sha256 = sha256(version_files["artifact"])
                                validate_response_files(
                                    {child: version_files[child] for child in RESPONSE_NAMES},
                                    pending_state,
                                    trust,
                                    synthetic,
                                )
                                response_ready = True
                            else:
                                conflict = True
                    else:
                        fail("versions root contains an unexpected entry")
            finally:
                versions.close()
        if recovery:
            selected = ("activation-recovery-required", "recover-activation")
        elif abandonment_result is not None:
            selected = (
                "abandonment-evidence-required",
                f"publish-{abandonment_result}-evidence",
            )
        elif conflict:
            selected = ("conflict", "resolve-conflict")
        elif accepted is not None and accepted["state"] == "finalized":
            selected = ("complete", "none")
        elif accepted is not None:
            selected = ("signer-outcome-abandoned", "none")
        elif active_auth is not None and evidence_state == "controller-exported":
            selected = ("evidence-exported", "await-signer-outcome")
        elif active_auth is not None:
            selected = ("activated-and-validated", "export-evidence")
        elif response_ready:
            selected = ("response-ready", "activate-response")
        elif pending_state is not None and pending_state["expired"]:
            selected = ("request-expired", "abandon-expired-request")
        elif pending_state is not None:
            selected = ("request-pending", "collect-or-await-response")
        else:
            selected = ("managed-migration-needed", "create-migration-request")
        result = {
            "schema": "1", "kind": "platform-config-host-local-certificate-status",
            "status": selected[0], "service": args.service, "target": args.target,
            **active_values, "pending_request_id": pending_id,
            "pending_expires_epoch": pending_expires, "recovery_required": recovery,
            "evidence_state": evidence_state,
            "signer_outcome_state": "unavailable" if accepted is None else accepted["state"],
            "renewal_eligible": False, "required_action": selected[1],
        }
        json_output(result)
    finally:
        os.close(lock)
        state.close()


def active_paths(args) -> None:
