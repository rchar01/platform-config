def target_activate_start(args) -> None:
    args.request_id = target_pending_request_id(args)
    args.artifact_sha256 = target_artifact_digest(args, args.request_id, ingress=False)
    current_request_id = args.request_id
    state, lock = common_open(args)
    try:
        trust, _policy = load_trust(state, args.trust_id, args.target)
        pending = validate_pending(
            os.path.join(args.pending_root, current_request_id), trust
        )
        args.operation = pending["record"]["operation"]
        if "activation-journal" in state_entries(state):
            journal_data, journal_identity = read_at(
                state, "activation-journal", "activation journal"
            )
            journal = journal_record(journal_data, args)
            if (
                journal["checkpoint"] != "local-validated"
                or journal["request_id"] != current_request_id
                or journal["artifact_manifest_sha256"] != args.artifact_sha256
            ):
                fail("unresolved lifecycle state blocks activation")
            _pending, validated = authenticate_target_candidate(state, args, trust)
            active = authenticate_active(state, args)
            if (
                active is None
                or active["record"]["request_id"] != current_request_id
                or active["record"]["artifact_manifest_sha256"]
                != args.artifact_sha256
            ):
                fail("authenticated active target candidate is absent")
            created = require_epoch(journal["created_epoch"], "activation epoch")
            deadline = require_epoch(
                journal["rollback_deadline_epoch"], "rollback deadline"
            )
            assert created is not None and deadline is not None
            if deadline != created + args.rollback_seconds:
                fail("activation journal rollback interval differs from the request")
            if lifecycle_epoch() >= deadline:
                if args.check:
                    fail("activation rollback deadline expired; recovery is required")
                terminal_state = publish_target_failure(
                    state, args, journal_data, journal_identity
                )
                json_output({
                    "status": terminal_state,
                    "request_id": current_request_id,
                    "certificate_sha256": validated["certificate_sha256"],
                })
                return
            local = strict_local_validation(
                args,
                str(validated["certificate_sha256"]),
                str(validated["intermediate_sha256"]),
            )
            json_output({
                "status": "local-validated",
                "request_id": current_request_id,
                "artifact_sha256": args.artifact_sha256,
                "certificate_sha256": validated["certificate_sha256"],
                "served_certificate_sha256": local["served_certificate_sha256"],
                "served_intermediate_sha256": local["served_intermediate_sha256"],
                "activation_epoch": created,
                "rollback_deadline_epoch": deadline,
            })
            return
        retire_current_target_terminal(
            state, args, trust, current_request_id
        )
    finally:
        os.close(lock)
        state.close()
    args.request_id = current_request_id
    fault("after-target-terminal-retirement-lock")
    activate_start(args)


def target_terminal_bytes(
    args,
    journal: Mapping[str, str],
    state_value: str,
    *,
    served_certificate_sha256: str = "none",
    served_intermediate_sha256: str = "none",
    validation_epoch: str = "none",
) -> bytes:
    values = {
        "schema": "2", "kind": "host-local-target-terminal",
        "service": args.service, "target": args.target,
        "request_id": journal["request_id"], "state": state_value,
        "artifact_manifest_sha256": journal["artifact_manifest_sha256"],
        "response_sha256": journal["target_response_sha256"],
        "response_signature_sha256": journal["target_response_signature_sha256"],
        "certificate_sha256": journal["target_certificate_sha256"],
        "served_certificate_sha256": served_certificate_sha256,
        "served_intermediate_sha256": served_intermediate_sha256,
        "activation_epoch": journal["created_epoch"],
        "validation_epoch": validation_epoch,
    }
    return serialize_record(TARGET_TERMINAL_FIELDS, values, "target-local terminal record")


def parse_target_terminal(data: bytes, args) -> dict[str, str]:
    record = parse_record(data, TARGET_TERMINAL_FIELDS, "target-local terminal record")
    if (
        record["schema"] != "2"
        or record["kind"] != "host-local-target-terminal"
        or record["service"] != args.service
        or record["target"] != args.target
        or record["state"] not in {"complete", "not-activated", "rolled-back"}
    ):
        fail("target-local terminal record identity is invalid")
    require_request_id(record["request_id"])
    for field in (
        "artifact_manifest_sha256", "response_sha256",
        "response_signature_sha256", "certificate_sha256",
    ):
        require_digest(record[field], f"target terminal {field}")
    require_epoch(record["activation_epoch"], "target terminal activation epoch")
    proof_fields = ("served_certificate_sha256", "served_intermediate_sha256")
    if record["state"] == "complete":
        for field in proof_fields:
            require_digest(record[field], f"target terminal {field}")
        require_epoch(record["validation_epoch"], "target terminal validation epoch")
    elif any(record[field] != "none" for field in (*proof_fields, "validation_epoch")):
        fail("failed target terminal record contains success validation proof")
    return record


def authenticate_target_candidate(state: PinnedDirectory, args, trust: Mapping[str, bytes]) -> tuple[dict[str, object], dict[str, object]]:
    pending = validate_pending(
        os.path.join(args.pending_root, args.request_id), trust,
        expected_request_id=args.request_id,
    )
    version, version_files, _ = validate_version(
        os.path.join(args.versions_root, args.request_id), args.request_id
    )
    try:
        args.artifact_sha256 = sha256(version_files["artifact"])
        validated = validate_response_files(
            {name: version_files[name] for name in RESPONSE_NAMES},
            pending, trust, args,
        )
        return pending, validated
    finally:
        version.close()


def validate_terminal_candidate(state: PinnedDirectory, args, trust: Mapping[str, bytes], terminal: Mapping[str, str]) -> None:
    args.request_id = terminal["request_id"]
    _pending, validated = authenticate_target_candidate(state, args, trust)
    checks = {
        "artifact_manifest_sha256": validated["artifact_sha256"],
        "response_sha256": validated["response_sha256"],
        "response_signature_sha256": validated["response_signature_sha256"],
        "certificate_sha256": validated["certificate_sha256"],
    }
    if any(terminal[name] != value for name, value in checks.items()):
        fail("target terminal record does not bind the authenticated candidate")


def validate_terminal_activation(state: PinnedDirectory, args, terminal: Mapping[str, str]) -> None:
    active = authenticate_active(state, args)
    active_is_candidate = active is not None and (
        active["record"]["request_id"] == terminal["request_id"]
        and active["record"]["certificate_sha256"] == terminal["certificate_sha256"]
    )
    if terminal["state"] == "complete" and not active_is_candidate:
        fail("complete target terminal record does not match authenticated active state")
    if terminal["state"] != "complete" and active_is_candidate:
        fail("failed target terminal record still selects the target candidate")


def archive_target_terminal(
    state: PinnedDirectory,
    args,
    terminal_data: bytes,
    terminal: Mapping[str, str],
) -> None:
    history_name = "target-terminal-history"
    if history_name not in scan(state, "state root"):
        os.mkdir(history_name, 0o700, dir_fd=state.fd)
        os.fsync(state.fd)
    history = PinnedDirectory.open(
        os.path.join(args.state_root, history_name),
        "target-local terminal history",
    )
    try:
        request_id = terminal["request_id"]
        entries = scan(history, "target-local terminal history")
        if request_id in entries:
            existing, _identity = read_at(
                history, request_id, "target-local terminal history record"
            )
            if existing != terminal_data:
                fail("target-local terminal history conflicts with current terminal")
        else:
            write_new_at(
                history,
                request_id,
                terminal_data,
                "target-local terminal history record",
            )
            os.fsync(history.fd)
        fault("after-target-terminal-history")
    finally:
        history.close()


def retire_current_target_terminal(
    state: PinnedDirectory,
    args,
    trust: Mapping[str, bytes],
    current_request_id: str,
) -> None:
    terminal_data, terminal_identity = read_optional_state(state, "target-terminal")
    if terminal_data is None:
        return
    assert terminal_identity is not None
    terminal = parse_target_terminal(terminal_data, args)
    if terminal["request_id"] == current_request_id:
        fail("target-local request is already terminal")
    archived = target_terminal_history(state, args).get(terminal["request_id"])
    saved_request_id = args.request_id
    saved_artifact_sha256 = getattr(args, "artifact_sha256", None)
    try:
        if archived is None:
            validate_terminal_candidate(state, args, trust, terminal)
            validate_terminal_activation(state, args, terminal)
            if args.check:
                return
            archive_target_terminal(state, args, terminal_data, terminal)
        elif archived[0] != terminal_data:
            fail("target-local terminal differs from retained history")
        elif args.check:
            return
        fault("after-target-terminal-history")
        require_snapshot(
            state,
            "target-terminal",
            terminal_identity,
            "target-local terminal record",
        )
        os.unlink("target-terminal", dir_fd=state.fd)
        os.fsync(state.fd)
        fault("after-target-terminal-retirement")
    finally:
        args.request_id = saved_request_id
        if saved_artifact_sha256 is not None:
            args.artifact_sha256 = saved_artifact_sha256


def validate_target_completion(
    state: PinnedDirectory,
    args,
    validated: Mapping[str, object],
) -> dict[str, str]:
    local = strict_local_validation(
        args, str(validated["certificate_sha256"]),
        str(validated["intermediate_sha256"]),
    )
    return {
        "served_certificate_sha256": local["served_certificate_sha256"],
        "served_intermediate_sha256": local["served_intermediate_sha256"],
        "validation_epoch": str(lifecycle_epoch()),
    }


def publish_target_failure(
    state: PinnedDirectory,
    args,
    journal_data: bytes,
    journal_identity: tuple[int, ...],
) -> str:
    terminal_state = restore_from_journal(
        state, journal_data, journal_identity, args
    )
    restored_data, restored_identity = read_at(
        state, "activation-journal", "restored activation journal"
    )
    restored = journal_record(restored_data, args)
    if restored["checkpoint"] != terminal_state:
        fail("restored target-local activation journal is not terminal")
    terminal_data = target_terminal_bytes(args, restored, terminal_state)
    write_new_at(state, "target-terminal", terminal_data, "target-local terminal record")
    os.fsync(state.fd)
    archive_target_terminal(
        state,
        args,
        terminal_data,
        parse_target_terminal(terminal_data, args),
    )
    require_snapshot(
        state, "activation-journal", restored_identity, "restored activation journal"
    )
    os.unlink("activation-journal", dir_fd=state.fd)
    os.fsync(state.fd)
    return terminal_state


def target_activate_complete(args) -> None:
    state, lock = common_open(args)
    try:
        entries = state_entries(state)
        if entries & {"request.journal", "trust-install.journal"}:
            fail("unrelated unresolved state blocks target-local completion")
        terminal_data, terminal_identity = read_optional_state(state, "target-terminal")
        pending_request_ids = target_pending_request_ids(args)
        if "activation-journal" in entries:
            journal = journal_record(
                read_at(state, "activation-journal", "activation journal")[0], args
            )
            args.request_id = journal["request_id"]
        elif len(pending_request_ids) == 1:
            args.request_id = pending_request_ids[0]
        elif not pending_request_ids and terminal_data is not None:
            args.request_id = parse_target_terminal(terminal_data, args)["request_id"]
        else:
            fail("target-local completion requires one exact request")
        trust, _policy = load_trust(state, args.trust_id, args.target)
        _pending, validated = authenticate_target_candidate(state, args, trust)
        args.artifact_sha256 = str(validated["artifact_sha256"])
        if terminal_data is not None:
            terminal = parse_target_terminal(terminal_data, args)
            if terminal["request_id"] != args.request_id:
                fail("target-local terminal does not match the completion request")
            validate_terminal_candidate(state, args, trust, terminal)
            validate_terminal_activation(state, args, terminal)
            if terminal["state"] != "complete":
                fail("target-local request already has a terminal failure")
            if "activation-journal" in entries and not args.check:
                journal_data, journal_identity = read_at(state, "activation-journal", "activation journal")
                journal = journal_record(journal_data, args)
                if journal["request_id"] != terminal["request_id"]:
                    fail("terminal record and activation journal differ")
                require_snapshot(state, "activation-journal", journal_identity, "activation journal")
                os.unlink("activation-journal", dir_fd=state.fd)
                os.fsync(state.fd)
            json_output({"status": "complete", "request_id": terminal["request_id"], "certificate_sha256": terminal["certificate_sha256"]})
            return
        if "activation-journal" not in entries:
            fail("target-local completion requires a local-validated activation journal")
        journal_data, journal_identity = read_at(state, "activation-journal", "activation journal")
        journal = journal_record(journal_data, args)
        if (
            journal["checkpoint"] != "local-validated"
            or journal["request_id"] != args.request_id
            or journal["artifact_manifest_sha256"] != args.artifact_sha256
        ):
            fail("activation journal is not the exact local-validated target candidate")
        active_auth = authenticate_active(state, args)
        if active_auth is None or active_auth["record"]["request_id"] != args.request_id:
            fail("authenticated active target candidate is absent")
        deadline = require_epoch(
            journal["rollback_deadline_epoch"], "rollback deadline"
        )
        assert deadline is not None
        if lifecycle_epoch() >= deadline:
            if args.check:
                fail("activation rollback deadline expired; recovery is required")
            terminal_state = publish_target_failure(
                state, args, journal_data, journal_identity
            )
            json_output({
                "status": terminal_state, "request_id": args.request_id,
                "certificate_sha256": validated["certificate_sha256"],
            })
            return
        try:
            proof = validate_target_completion(state, args, validated)
        except (LifecycleError, OSError, ValueError, UnicodeDecodeError):
            if args.check:
                raise
            terminal_state = publish_target_failure(
                state, args, journal_data, journal_identity
            )
            json_output({
                "status": terminal_state, "request_id": args.request_id,
                "certificate_sha256": validated["certificate_sha256"],
            })
            return
        if lifecycle_epoch() >= deadline:
            if args.check:
                fail("activation rollback deadline expired; recovery is required")
            terminal_state = publish_target_failure(
                state, args, journal_data, journal_identity
            )
            json_output({
                "status": terminal_state, "request_id": args.request_id,
                "certificate_sha256": validated["certificate_sha256"],
            })
            return
        terminal_data = target_terminal_bytes(
            args, journal, "complete",
            served_certificate_sha256=proof["served_certificate_sha256"],
            served_intermediate_sha256=proof["served_intermediate_sha256"],
            validation_epoch=proof["validation_epoch"],
        )
        if args.check:
            json_output({"status": "would-complete", "request_id": args.request_id, "certificate_sha256": validated["certificate_sha256"]})
            return
        write_new_at(state, "target-terminal", terminal_data, "target-local terminal record")
        os.fsync(state.fd)
        archive_target_terminal(
            state,
            args,
            terminal_data,
            parse_target_terminal(terminal_data, args),
        )
        require_snapshot(state, "activation-journal", journal_identity, "activation journal")
        os.unlink("activation-journal", dir_fd=state.fd)
        os.fsync(state.fd)
        json_output({"status": "complete", "request_id": args.request_id, "certificate_sha256": validated["certificate_sha256"]})
    finally:
        os.close(lock)
        state.close()


def target_recover(args) -> None:
    state, lock = common_open(args)
    try:
        entries = state_entries(state)
        terminal_data, _ = read_optional_state(state, "target-terminal")
        if terminal_data is not None:
            terminal = parse_target_terminal(terminal_data, args)
            trust, _policy = load_trust(state, args.trust_id, args.target)
            validate_terminal_candidate(state, args, trust, terminal)
            validate_terminal_activation(state, args, terminal)
            archive_target_terminal(state, args, terminal_data, terminal)
            if "activation-journal" in entries:
                data, identity = read_at(state, "activation-journal", "activation journal")
                journal = journal_record(data, args)
                if journal["request_id"] != terminal["request_id"]:
                    fail("terminal record and activation journal differ")
                if args.check:
                    fail("target-local terminal cleanup is required")
                require_snapshot(state, "activation-journal", identity, "activation journal")
                os.unlink("activation-journal", dir_fd=state.fd)
                os.fsync(state.fd)
            json_output({"status": "not-required", "terminal_state": terminal["state"]})
            return
        if "activation-journal" in entries:
            data, identity = read_at(state, "activation-journal", "activation journal")
            journal = journal_record(data, args)
            args.request_id = journal["request_id"]
            trust, _policy = load_trust(state, args.trust_id, args.target)
            authenticate_target_candidate(state, args, trust)
            if args.artifact_sha256 != journal["artifact_manifest_sha256"]:
                fail("target-local activation journal differs from the authenticated candidate")
            if journal["checkpoint"] in {"not-activated", "rolled-back"}:
                terminal = target_terminal_bytes(args, journal, journal["checkpoint"])
                if args.check:
                    fail("target-local terminal failure publication is required")
                write_new_at(state, "target-terminal", terminal, "target-local terminal record")
                os.fsync(state.fd)
                archive_target_terminal(
                    state,
                    args,
                    terminal,
                    parse_target_terminal(terminal, args),
                )
                require_snapshot(state, "activation-journal", identity, "activation journal")
                os.unlink("activation-journal", dir_fd=state.fd)
                os.fsync(state.fd)
                json_output({"status": journal["checkpoint"], "request_id": journal["request_id"]})
                return
            if args.check:
                fail("target-local activation recovery is required")
            terminal_state = publish_target_failure(state, args, data, identity)
            json_output({
                "status": terminal_state, "request_id": journal["request_id"]
            })
            return
        json_output({"status": "not-required"})
        return
    finally:
        os.close(lock)
        state.close()


def target_status(args) -> None:
    state, lock = common_open(args, shared=True)
    try:
        entries = state_entries(state)
        trust, _policy = load_trust(state, args.trust_id, args.target)
        terminal_data, _ = read_optional_state(state, "target-terminal")
        terminal = None
        excluded = set(target_terminal_history(state, args))
        if terminal_data is not None:
            terminal = parse_target_terminal(terminal_data, args)
            validate_terminal_candidate(state, args, trust, terminal)
            validate_terminal_activation(state, args, terminal)
            excluded.add(terminal["request_id"])
        pending_request_ids = target_pending_request_ids(args, excluded)
        if len(pending_request_ids) > 1:
            fail("target-local operation requires at most one nonterminal pending request")
        if "activation-journal" in entries:
            journal = journal_record(read_at(state, "activation-journal", "activation journal")[0], args)
            request_id = journal["request_id"]
            if journal["checkpoint"] == "local-validated":
                selected, action = "activating", "complete-local-validation"
            elif journal["checkpoint"] in {"not-activated", "rolled-back"}:
                selected, action = journal["checkpoint"], "recover"
            else:
                selected, action = "recovery-required", "recover"
        elif pending_request_ids:
            request_id = pending_request_ids[0]
            pending = validate_pending(os.path.join(args.pending_root, request_id), trust)
            if pending["expired"]:
                selected, action = "request-expired", "reset-required"
                request_id = "none"
            else:
                selected, action = "request-pending", "await-response"
                if os.path.lexists(os.path.join(args.versions_root, request_id)):
                    args.request_id = request_id
                    authenticate_target_candidate(state, args, trust)
                    selected, action = "response-ready", "activate-response"
                elif os.path.lexists(os.path.join(args.versions_root, f".ingress-{request_id}")):
                    ingress, files, _ = open_exact_tree(
                        os.path.join(args.versions_root, f".ingress-{request_id}"),
                        RESPONSE_NAMES, "target response ingress",
                    )
                    ingress.close()
                    args.artifact_sha256 = sha256(files["artifact"])
                    validate_response_files(files, pending, trust, args)
                    selected, action = "response-ready", "install-response"
        elif terminal is not None:
            selected = terminal["state"]
            action = "none"
            request_id = terminal["request_id"]
        else:
            request_id = "none"
            selected, action = "absent", "create-request"
        json_output({
            "schema": "2", "kind": "platform-config-target-local-certificate-status",
            "status": selected, "service": args.service, "target": args.target,
            "request_id": request_id, "required_action": action,
        })
    finally:
        os.close(lock)
        state.close()


def add_common(parser: argparse.ArgumentParser, *, config: bool = False) -> None:
    parser.add_argument("--state-root", required=True)
    parser.add_argument("--pending-root", required=True)
    parser.add_argument("--versions-root", required=True)
    parser.add_argument("--service", required=True)
    parser.add_argument("--target", required=True)
    if config:
        parser.add_argument("--zot-config", required=True)


def add_target_candidate(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--trust-id", required=True)
    parser.add_argument("--common-name", required=True)
    parser.add_argument("--dns-san", action="append", default=[])
    parser.add_argument("--ip-san", action="append", default=[])
    parser.add_argument("--minimum-remaining-lifetime-seconds", type=int, required=True)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    target_request = commands.add_parser(
        "target-request-export",
        help="authenticate and expose the only target-local schema-2 request",
    )
    add_common(target_request)
    target_request.add_argument("--trust-id", required=True)
    target_request.add_argument("--output-dir", required=True)
    target_request.add_argument("--output-owner-uid", required=True, type=int)
    target_request.add_argument("--check", action="store_true")
    target_request.set_defaults(function=target_request_export)

    target_prepare = commands.add_parser(
        "target-response-prepare",
        help="prepare response ingress for the only authenticated target-local request",
    )
    add_common(target_prepare)
    target_prepare.add_argument("--trust-id", required=True)
    target_prepare.add_argument("--check", action="store_true")
    target_prepare.set_defaults(function=target_response_prepare)

    target_install = commands.add_parser(
        "target-response-install",
        help="authenticate and install the target-local issued response",
    )
    add_common(target_install)
    add_target_candidate(target_install)
    target_install.add_argument("--check", action="store_true")
    target_install.set_defaults(function=target_response_install)

    target_start = commands.add_parser(
        "target-activate-start",
        help="activate and locally validate the authenticated target-local response",
    )
    add_common(target_start, config=True)
    add_target_candidate(target_start)
    target_start.add_argument("--endpoint", required=True)
    target_start.add_argument("--reviewed-ca", required=True)
    target_start.add_argument("--reviewed-ca-mode", type=lambda value: int(value, 8), default=0o600)
    target_start.add_argument("--prior-certificate-mode", type=lambda value: int(value, 8), default=0o644)
    target_start.add_argument("--rollback-seconds", type=int, required=True)
    target_start.add_argument("--check", action="store_true")
    target_start.set_defaults(function=target_activate_start)

    target_complete = commands.add_parser(
        "target-activate-complete",
        help="repeat strict local validation and publish local terminal state",
    )
    add_common(target_complete, config=True)
    add_target_candidate(target_complete)
    target_complete.add_argument("--endpoint", required=True)
    target_complete.add_argument("--reviewed-ca", required=True)
    target_complete.add_argument("--reviewed-ca-mode", type=lambda value: int(value, 8), default=0o600)
    target_complete.add_argument("--check", action="store_true")
    target_complete.set_defaults(function=target_activate_complete)

    target_recovery = commands.add_parser(
        "target-recover",
        help="recover only exact journaled target-local activation state",
    )
    add_common(target_recovery, config=True)
    add_target_candidate(target_recovery)
    target_recovery.add_argument("--check", action="store_true")
    target_recovery.set_defaults(
        function=target_recover, request_id=None,
        artifact_sha256=None,
    )

    target_status_parser = commands.add_parser(
        "target-status",
        help="authenticate and report bounded target-local lifecycle state",
    )
    add_common(target_status_parser, config=True)
    add_target_candidate(target_status_parser)
    target_status_parser.set_defaults(function=target_status)

    paths = commands.add_parser("active-paths", help="authenticate active state and emit only exact Zot paths and digests")
    add_common(paths, config=True)
    paths.set_defaults(function=active_paths)

    custody = commands.add_parser(
        "zot-custody",
        help="derive exact dormant, managed, or authenticated host-local Zot TLS custody",
    )
    add_common(custody, config=True)
    custody.add_argument("--operation", choices=("issue", "renew"), required=True)
    custody.add_argument("--managed-cert", required=True)
    custody.add_argument("--managed-key", required=True)
    custody.add_argument("--managed-config-sha256", required=True)
    custody.set_defaults(function=zot_custody)
    return parser


def validate_arguments(args) -> None:
    if hasattr(args, "request_id") and args.request_id is not None:
        require_request_id(args.request_id)
    if hasattr(args, "artifact_sha256") and args.artifact_sha256 is not None:
        require_digest(args.artifact_sha256, "artifact digest")
    if hasattr(args, "managed_config_sha256"):
        require_digest(args.managed_config_sha256, "managed configuration digest")
        args.managed_cert = canonical_path(
            args.managed_cert, "managed Zot certificate path"
        )
        args.managed_key = canonical_path(args.managed_key, "managed Zot key path")
    if hasattr(args, "minimum_remaining_lifetime_seconds") and args.minimum_remaining_lifetime_seconds <= 0:
        fail("minimum remaining lifetime must be positive")
    if hasattr(args, "rollback_seconds") and args.rollback_seconds < MIN_ROLLBACK_SECONDS:
        fail(f"rollback seconds must be at least {MIN_ROLLBACK_SECONDS}")
    if hasattr(args, "zot_config"):
        args.zot_config = canonical_path(args.zot_config, "Zot configuration")


def main() -> None:
    os.umask(0o077)
    if os.geteuid() != 0 or os.getegid() != 0:
        fail("effective uid and gid 0 are required")
    for tool in ("openssl", "ssh-keygen"):
        if shutil.which(tool) is None:
            fail(f"required tool is unavailable: {tool}")
    args = build_parser().parse_args()
    validate_arguments(args)
    args.function(args)


if __name__ == "__main__":
    try:
        main()
    except (LifecycleError, OSError, ValueError, UnicodeDecodeError) as error:
        print(f"platform-pki-host-local-lifecycle: {error}", file=sys.stderr)
        raise SystemExit(1)
