            "spki_sha256": active["certificate_spki_sha256"], "chain_sha256": active["chain_sha256"],
            "fullchain_sha256": active["fullchain_sha256"], "zot_config_sha256": active["zot_config_sha256"],
        })
    finally:
        os.close(lock)
        state.close()


def zot_custody(args) -> None:
    state, lock = common_open(args, shared=True)
    try:
        entries = state_entries(state)
        unresolved = entries & {
            "activation-journal", "evidence-attempt-journal",
            "abandonment-journal", "expired-request-abandonment-journal",
            "expired-request-abandonment-journal.stage",
            "pending-request-cancellation-journal",
            "pending-request-cancellation-journal.stage", "request.journal",
            "trust-install.journal",
        }
        if unresolved:
            fail("unresolved lifecycle state blocks Zot TLS custody selection")

        authenticated = authenticate_active(state, args)
        if authenticated is None:
            if "rollback" in entries:
                fail("rollback state exists without an authenticated active version")
            config_data, _ = read_path(
                args.zot_config, "managed Zot configuration", mode=0o644
            )
            _config, cert_path, key_path = parse_zot_config(config_data)
            if (
                cert_path != args.managed_cert
                or key_path != args.managed_key
                or sha256(config_data) != args.managed_config_sha256
            ):
                fail("current Zot configuration is not the exact managed configuration")
            json_output({
                "schema": "1",
                "kind": "platform-config-zot-tls-custody",
                "custody": "managed",
                "request_id": "none",
                "cert_path": args.managed_cert,
                "key_path": args.managed_key,
                "artifact_sha256": "none",
                "certificate_sha256": "none",
                "spki_sha256": "none",
                "chain_sha256": "none",
                "fullchain_sha256": "none",
                "zot_config_sha256": args.managed_config_sha256,
            })
            return

        active = authenticated["record"]
        rollback_data, _ = read_optional_state(state, "rollback")
        if rollback_data is None:
            fail("authenticated active state lacks its rollback record")
        rollback = parse_rollback(rollback_data, args)
        if (
            rollback["activating_request_id"] != active["request_id"]
            or rollback["activating_artifact_manifest_sha256"]
            != active["artifact_manifest_sha256"]
            or rollback["activating_certificate_sha256"]
            != active["certificate_sha256"]
            or rollback["activating_version_path"] != active["version_path"]
            or rollback["activating_version_device"] != active["version_device"]
            or rollback["activating_version_inode"] != active["version_inode"]
            or rollback["activation_epoch"] != active["activation_epoch"]
            or rollback["rollback_deadline_epoch"]
            != active["rollback_deadline_epoch"]
        ):
            fail("active and rollback records do not bind one activation")
        json_output({
            "schema": "1",
            "kind": "platform-config-zot-tls-custody",
            "custody": "host-local",
            "request_id": active["request_id"],
            "cert_path": os.path.join(active["version_path"], "fullchain.crt"),
            "key_path": os.path.join(active["version_path"], "tls.key"),
            "artifact_sha256": active["artifact_manifest_sha256"],
            "certificate_sha256": active["certificate_sha256"],
            "spki_sha256": active["certificate_spki_sha256"],
            "chain_sha256": active["chain_sha256"],
            "fullchain_sha256": active["fullchain_sha256"],
            "zot_config_sha256": active["zot_config_sha256"],
        })
    finally:
        os.close(lock)
        state.close()


def add_common(parser: argparse.ArgumentParser, *, config: bool = False) -> None:
    parser.add_argument("--state-root", required=True)
    parser.add_argument("--pending-root", required=True)
    parser.add_argument("--versions-root", required=True)
    parser.add_argument("--service", required=True)
    parser.add_argument("--target", required=True)
    if config:
        parser.add_argument("--zot-config", required=True)


def add_candidate(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--trust-id", required=True)
    parser.add_argument("--request-id", required=True)
    parser.add_argument("--artifact-sha256", required=True)
    parser.add_argument("--common-name", required=True)
    parser.add_argument("--dns-san", action="append", default=[])
    parser.add_argument("--ip-san", action="append", default=[])
    parser.add_argument("--minimum-remaining-lifetime-seconds", type=int, required=True)


def add_boundary(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--validation-boundary-sha256", required=True)
    parser.add_argument("--remote-validator", required=True)
    parser.add_argument("--endpoint", required=True)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    collection = commands.add_parser("collection-prepare", help="authenticate and expose only the three public request files")
    add_common(collection)
    collection.add_argument("--trust-id", required=True)
    collection.add_argument("--request-id", required=True)
    collection.add_argument("--output-dir", required=True)
    collection.add_argument("--output-owner-uid", required=True, type=int)
    collection.add_argument("--check", action="store_true")
    collection.set_defaults(function=collection_prepare)

    abandon_expired = commands.add_parser(
        "abandon-expired-request",
        help="remove only one exact authenticated expired pending request",
    )
    add_common(abandon_expired)
    abandon_expired.add_argument("--trust-id", required=True)
    abandon_expired.add_argument("--request-id", required=True)
    abandon_expired.add_argument("--check", action="store_true")
    abandon_expired.set_defaults(
        function=abandon_expired_request,
        removal_mode="expired",
        request_sha256=None,
    )

    cancel_pending = commands.add_parser(
        "cancel-pending-request",
        help="remove one exact authenticated pending request by ID and digest",
    )
    add_common(cancel_pending)
    cancel_pending.add_argument("--trust-id", required=True)
    cancel_pending.add_argument("--request-id", required=True)
    cancel_pending.add_argument("--request-sha256", required=True)
    cancel_pending.add_argument("--check", action="store_true")
    cancel_pending.set_defaults(
        function=abandon_expired_request,
        removal_mode="cancel",
    )

    evidence_collection = commands.add_parser(
        "evidence-collection-prepare",
        help="authenticate and expose one exact five-file evidence attempt",
    )
    add_common(evidence_collection)
    evidence_collection.add_argument("--trust-id", required=True)
    evidence_collection.add_argument("--request-id", required=True)
    evidence_collection.add_argument("--artifact-sha256", required=True)
    evidence_collection.add_argument("--deployment-sha256", required=True)
    evidence_collection.add_argument("--output-dir", required=True)
    evidence_collection.add_argument("--output-owner-uid", required=True, type=int)
    evidence_collection.add_argument("--check", action="store_true")
    evidence_collection.set_defaults(function=evidence_collection_prepare)

    preflight = commands.add_parser(
        "outcome-preflight",
        help="read-only target authentication for one controller-reviewed outcome",
    )
    add_common(preflight, config=True)
    preflight.add_argument("--trust-id", required=True)
    preflight.add_argument("--request-id", required=True)
    preflight.add_argument("--artifact-sha256", required=True)
    preflight.add_argument("--deployment-sha256", required=True)
    preflight.add_argument("--outcome-sha256", required=True)
    preflight.add_argument("--decision-sha256", required=True)
    preflight.add_argument("--outcome-principal", required=True)
    for field in DECISION_FIELDS:
        if field != "schema":
            preflight.add_argument(
                f"--decision-{field.replace('_', '-')}", required=True
            )
    preflight.set_defaults(function=outcome_preflight)

    outcome = commands.add_parser(
        "outcome-import",
        help="authenticate and publish one exact terminal signer outcome",
    )
    add_common(outcome, config=True)
    outcome.add_argument("--trust-id", required=True)
    outcome.add_argument("--request-id", required=True)
    outcome.add_argument("--artifact-sha256", required=True)
    outcome.add_argument("--deployment-sha256", required=True)
    outcome.add_argument("--outcome-sha256", required=True)
    outcome.add_argument("--outcome-dir", required=True)
    outcome.add_argument("--check", action="store_true")
    outcome.set_defaults(function=outcome_import)

    prepare = commands.add_parser("response-prepare", help="create or reuse one protected hidden response ingress")
    add_common(prepare)
    prepare.add_argument("--trust-id", required=True)
    prepare.add_argument("--request-id", required=True)
    prepare.add_argument("--check", action="store_true")
    prepare.set_defaults(function=response_prepare)

    install = commands.add_parser("response-install", help="authenticate and publish one immutable eight-file version without changing Zot")
    add_common(install)
    add_candidate(install)
    install.add_argument("--check", action="store_true")
    install.set_defaults(function=response_install)

    start = commands.add_parser("activate-start", help="journal, activate, restart, and strictly validate one exact version locally")
    add_common(start, config=True)
    add_candidate(start)
    add_boundary(start)
    start.add_argument("--validation-boundary", required=True)
    start.add_argument("--reviewed-ca", required=True)
    start.add_argument("--reviewed-ca-mode", type=lambda value: int(value, 8), default=0o600)
    start.add_argument("--prior-certificate-mode", type=lambda value: int(value, 8), default=0o644)
    start.add_argument("--rollback-seconds", type=int, required=True)
    start.add_argument("--check", action="store_true")
    start.set_defaults(function=activate_start)

    finish = commands.add_parser("activate-finish", help="consume one canonical runner observation and publish signed target evidence")
    add_common(finish, config=True)
    add_candidate(finish)
    add_boundary(finish)
    finish.add_argument("--validation-boundary", required=True)
    finish.add_argument("--observation-file")
    finish.add_argument("--served-intermediate-sha256")
    finish.add_argument("--deployment-signing-key", required=True)
    finish.add_argument("--reviewed-ca", required=True)
    finish.add_argument("--reviewed-ca-mode", type=lambda value: int(value, 8), default=0o600)
    finish.add_argument("--rollback-seconds", type=int, required=True)
    finish.add_argument("--fresh-evidence", action="store_true")
    finish.add_argument("--prepare-rolled-back-abandonment", action="store_true")
    finish.add_argument("--action", choices=("finalize", "abandon"), default="finalize")
    finish.add_argument("--result", choices=("activated", "not-activated", "rolled-back"), default="activated")
    finish.add_argument("--check", action="store_true")
    finish.set_defaults(function=activate_finish)

    recovery = commands.add_parser("recover", help="perform only the exact recovery action encoded by the activation journal")
    add_common(recovery, config=True)
    recovery.add_argument("--request-id")
    recovery.add_argument("--artifact-sha256")
    recovery.add_argument("--check", action="store_true")
    recovery.set_defaults(function=recover)

    status_parser = commands.add_parser("status", help="authenticate lifecycle state and emit the fixed schema-1 status object")
    add_common(status_parser, config=True)
    status_parser.add_argument("--trust-id", required=True)
    status_parser.add_argument("--common-name", required=True)
    status_parser.add_argument("--dns-san", action="append", default=[])
    status_parser.add_argument("--ip-san", action="append", default=[])
    status_parser.add_argument("--minimum-remaining-lifetime-seconds", type=int, default=1)
    status_parser.add_argument("--controller-evidence-exported", action="store_true", help="controller-proven exact target evidence export flag")
    status_parser.add_argument("--deployment-sha256")
    status_parser.add_argument("--outcome-sha256")
    status_parser.set_defaults(function=status)

    paths = commands.add_parser("active-paths", help="authenticate active state and emit only exact Zot paths and digests")
    add_common(paths, config=True)
    paths.set_defaults(function=active_paths)

    custody = commands.add_parser(
        "zot-custody",
        help="derive exact managed or authenticated host-local Zot TLS custody",
    )
    add_common(custody, config=True)
    custody.add_argument("--managed-cert", required=True)
    custody.add_argument("--managed-key", required=True)
    custody.add_argument("--managed-config-sha256", required=True)
    custody.set_defaults(function=zot_custody)
    return parser


def validate_arguments(args) -> None:
    if hasattr(args, "request_id") and args.request_id is not None:
        require_request_id(args.request_id)
    if hasattr(args, "artifact_sha256") and args.artifact_sha256 is not None:
        require_digest(args.artifact_sha256, "artifact digest")
    if hasattr(args, "managed_config_sha256"):
        require_digest(args.managed_config_sha256, "managed configuration digest")
        args.managed_cert = canonical_path(
            args.managed_cert, "managed Zot certificate path"
        )
        args.managed_key = canonical_path(args.managed_key, "managed Zot key path")
    if hasattr(args, "request_sha256") and args.request_sha256 is not None:
        require_digest(args.request_sha256, "request digest")
    if hasattr(args, "deployment_sha256") and args.deployment_sha256 is not None:
        require_digest(args.deployment_sha256, "deployment digest")
    if hasattr(args, "outcome_sha256") and args.outcome_sha256 is not None:
        require_digest(args.outcome_sha256, "outcome digest")
    if hasattr(args, "outcome_dir"):
        args.outcome_dir = canonical_path(args.outcome_dir, "signer outcome directory")
    if hasattr(args, "decision_sha256"):
        require_digest(args.decision_sha256, "decision digest")
        require_identity(args.outcome_principal, "outcome principal")
    if hasattr(args, "validation_boundary_sha256"):
        require_digest(args.validation_boundary_sha256, "validation boundary digest")
        require_identity(args.remote_validator, "remote validator")
    if (
        hasattr(args, "served_intermediate_sha256")
        and args.served_intermediate_sha256 is not None
    ):
        require_digest(args.served_intermediate_sha256, "served intermediate digest")
    if hasattr(args, "minimum_remaining_lifetime_seconds") and args.minimum_remaining_lifetime_seconds <= 0:
        fail("minimum remaining lifetime must be positive")
    if hasattr(args, "rollback_seconds") and args.rollback_seconds < MIN_ROLLBACK_SECONDS:
        fail(f"rollback seconds must be at least {MIN_ROLLBACK_SECONDS}")
    if hasattr(args, "controller_evidence_exported"):
        if args.controller_evidence_exported != (args.deployment_sha256 is not None):
            fail("controller evidence export flag and exact deployment digest are required together")
        if args.deployment_sha256 is not None:
            require_digest(args.deployment_sha256, "deployment digest")
    if hasattr(args, "action"):
        if (args.action, args.result) not in {
            ("finalize", "activated"),
            ("abandon", "not-activated"),
            ("abandon", "rolled-back"),
        }:
            fail("deployment action and result are inconsistent")
        if args.fresh_evidence and args.action != "finalize":
            fail("fresh evidence is available only for finalization")
        if args.prepare_rolled_back_abandonment:
            if (
                (args.action, args.result) != ("abandon", "rolled-back")
                or args.observation_file is not None
                or args.served_intermediate_sha256 is not None
                or args.fresh_evidence
                or args.check
            ):
                fail("rolled-back abandonment preparation has conflicting arguments")
        elif args.served_intermediate_sha256 is None:
            fail("served intermediate digest is required for evidence publication")
    if hasattr(args, "zot_config"):
        args.zot_config = canonical_path(args.zot_config, "Zot configuration")
    if hasattr(args, "deployment_signing_key"):
        args.deployment_signing_key = canonical_path(args.deployment_signing_key, "deployment signing key")


def main() -> None:
    os.umask(0o077)
    if os.geteuid() != 0 or os.getegid() != 0:
        fail("effective uid and gid 0 are required")
    for tool in ("openssl", "ssh-keygen"):
        if shutil.which(tool) is None:
            fail(f"required tool is unavailable: {tool}")
    args = build_parser().parse_args()
    validate_arguments(args)
    args.function(args)


if __name__ == "__main__":
    try:
        main()
    except (LifecycleError, OSError, ValueError, UnicodeDecodeError) as error:
        print(f"platform-pki-host-local-lifecycle: {error}", file=sys.stderr)
        raise SystemExit(1)
