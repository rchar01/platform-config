class LifecycleError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise LifecycleError(message)


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def canonical_path(value: str, label: str) -> str:
    if (
        not value or not value.startswith("/") or value == "/"
        or os.path.normpath(value) != value
        or any(PATH_RE.fullmatch(part) is None for part in value.split("/")[1:])
    ):
        fail(f"{label} must be an absolute canonical non-root path")
    return value


def validate_roots(state_root: str, pending_root: str, versions_root: str) -> None:
    roots = tuple(canonical_path(value, label) for value, label in (
        (state_root, "state root"), (pending_root, "pending root"),
        (versions_root, "versions root"),
    ))
    for index, left in enumerate(roots):
        for right in roots[index + 1:]:
            if os.path.commonpath((left, right)) in {left, right}:
                fail("state, pending, and versions roots must be disjoint")
    if os.path.dirname(pending_root) != os.path.dirname(versions_root):
        fail("pending and versions roots must share one canonical parent")
    if os.path.basename(pending_root) != "tls-pending" or os.path.basename(versions_root) != "tls-versions":
        fail("pending and versions roots must use the canonical layout names")


def file_identity(metadata: os.stat_result) -> tuple[int, ...]:
    return (
        metadata.st_dev, metadata.st_ino, metadata.st_uid, metadata.st_gid,
        stat.S_IFMT(metadata.st_mode), stat.S_IMODE(metadata.st_mode),
        metadata.st_nlink, metadata.st_size, metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    )


def dir_identity(metadata: os.stat_result) -> tuple[int, ...]:
    return (
        metadata.st_dev, metadata.st_ino, metadata.st_uid, metadata.st_gid,
        stat.S_IFMT(metadata.st_mode), stat.S_IMODE(metadata.st_mode),
    )


def trusted_ancestor_owners() -> set[int]:
    owners = {0}
    try:
        with open("/proc/self/uid_map", encoding="ascii") as stream:
            mapping = [line.split() for line in stream if line.strip()]
        if mapping != [["0", "0", "4294967295"]]:
            with open("/proc/sys/kernel/overflowuid", encoding="ascii") as stream:
                owners.add(int(stream.read().strip()))
    except (OSError, ValueError):
        pass
    return owners


class PinnedDirectory:
    def __init__(self, path: str, descriptors: list[int], components: list[str], identities: list[tuple[int, ...]]):
        self.path = path
        self.descriptors = descriptors
        self.components = components
        self.identities = identities
        self.fd = descriptors[-1]

    @classmethod
    def open(
        cls,
        path: str,
        label: str,
        *,
        private: bool = True,
        allowed_owner_uids: set[int] | None = None,
        final_owner_uid: int = 0,
        owner_uid_only: bool = False,
    ) -> "PinnedDirectory":
        canonical_path(path, label)
        descriptors: list[int] = []
        identities: list[tuple[int, ...]] = []
        components = path.split("/")[1:]
        try:
            descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0))
            descriptors.append(descriptor)
            identities.append(dir_identity(os.fstat(descriptor)))
            ancestor_owners = (
                trusted_ancestor_owners()
                if allowed_owner_uids is None else allowed_owner_uids
            )
            for component in components:
                descriptor = os.open(
                    component,
                    os.O_RDONLY | os.O_DIRECTORY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
                    dir_fd=descriptors[-1],
                )
                descriptors.append(descriptor)
                metadata = os.fstat(descriptor)
                mode = stat.S_IMODE(metadata.st_mode)
                if (
                    metadata.st_uid not in ancestor_owners
                    or (not owner_uid_only and metadata.st_gid not in ancestor_owners)
                    or (mode & 0o022 and not mode & stat.S_ISVTX)
                ):
                    fail(f"{label} has an unsafe ancestor")
                identities.append(dir_identity(metadata))
            final = os.fstat(descriptors[-1])
            if private and (
                stat.S_IMODE(final.st_mode) != 0o700
                or final.st_uid != final_owner_uid
                or (not owner_uid_only and final.st_gid not in ancestor_owners)
            ):
                fail(f"{label} has invalid private-directory ownership or mode")
            result = cls(path, descriptors, components, identities)
            result.recheck(label)
            return result
        except Exception:
            for descriptor in reversed(descriptors):
                os.close(descriptor)
            raise

    def recheck(self, label: str) -> None:
        for index, expected in enumerate(self.identities):
            if dir_identity(os.fstat(self.descriptors[index])) != expected:
                fail(f"{label} descriptor identity changed")
            if index:
                actual = os.stat(self.components[index - 1], dir_fd=self.descriptors[index - 1], follow_symlinks=False)
                if dir_identity(actual) != expected:
                    fail(f"{label} path binding changed")

    def close(self) -> None:
        for descriptor in reversed(self.descriptors):
            os.close(descriptor)
        self.descriptors.clear()


def create_private_directory(path: str, label: str) -> None:
    canonical_path(path, label)
    parent = PinnedDirectory.open(os.path.dirname(path), f"parent of {label}", private=False)
    try:
        os.mkdir(os.path.basename(path), 0o700, dir_fd=parent.fd)
        os.fsync(parent.fd)
    except FileExistsError:
        pass
    except OSError as error:
        fail(f"cannot create {label}: {error.strerror}")
    finally:
        parent.close()
    opened = PinnedDirectory.open(path, label)
    opened.close()


def scan(directory: PinnedDirectory, label: str) -> dict[str, os.stat_result]:
    try:
        return {entry.name: entry.stat(follow_symlinks=False) for entry in os.scandir(directory.fd)}
    except OSError as error:
        fail(f"cannot inspect {label}: {error.strerror}")


def read_at(
    directory: PinnedDirectory,
    name: str,
    label: str,
    *,
    mode: int = 0o600,
    maximum: int = MAX_SIZE,
    allow_empty: bool = False,
    keep_open: bool = False,
    owner_uid: int = 0,
    owner_gid: int = 0,
):
    try:
        descriptor = os.open(
            name,
            os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_NOATIME", 0),
            dir_fd=directory.fd,
        )
    except OSError as error:
        fail(f"cannot open {label}: {error.strerror}")
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode) or before.st_uid != owner_uid or before.st_gid != owner_gid
            or before.st_nlink != 1 or stat.S_IMODE(before.st_mode) != mode
            or (before.st_size == 0 and not allow_empty) or before.st_size > maximum
        ):
            fail(f"{label} has unsafe metadata")
        chunks: list[bytes] = []
        remaining = maximum + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        data = b"".join(chunks)
        identity = file_identity(before)
        if len(data) != before.st_size or file_identity(os.fstat(descriptor)) != identity:
            fail(f"{label} changed while being read")
        actual = os.stat(name, dir_fd=directory.fd, follow_symlinks=False)
        if file_identity(actual) != identity:
            fail(f"{label} path binding changed")
        if keep_open:
            return data, identity, descriptor
        os.close(descriptor)
        return data, identity
    except Exception:
        os.close(descriptor)
        raise


def require_snapshot(directory: PinnedDirectory, name: str, identity: tuple[int, ...], label: str) -> None:
    try:
        actual = os.stat(name, dir_fd=directory.fd, follow_symlinks=False)
    except OSError as error:
        fail(f"cannot reinspect {label}: {error.strerror}")
    if file_identity(actual) != identity:
        fail(f"{label} path binding changed")


def read_path(path: str, label: str, *, mode: int = 0o600, maximum: int = MAX_SIZE):
    canonical_path(path, label)
    parent = PinnedDirectory.open(os.path.dirname(path), f"parent of {label}", private=False)
    try:
        data, identity = read_at(parent, os.path.basename(path), label, mode=mode, maximum=maximum)
        parent.recheck(f"parent of {label}")
        require_snapshot(parent, os.path.basename(path), identity, label)
        return data, identity
    finally:
        parent.close()


def parse_record(data: bytes, fields: Sequence[str], label: str) -> dict[str, str]:
    if not data.endswith(b"\n") or data.endswith(b"\n\n") or b"\r" in data or b"\x00" in data:
        fail(f"{label} is not canonical LF-terminated text")
    try:
        lines = data.decode("ascii").splitlines()
    except UnicodeDecodeError:
        fail(f"{label} is not ASCII")
    if len(lines) != len(fields):
        fail(f"{label} has an unexpected field count")
    values: dict[str, str] = {}
    for expected, line in zip(fields, lines, strict=True):
        if "=" not in line:
            fail(f"{label} contains a malformed field")
        name, value = line.split("=", 1)
        if name != expected or not value or any(ord(character) < 0x21 or ord(character) > 0x7e for character in value):
            fail(f"{label} contains an unexpected, empty, or unsafe field")
        values[name] = value
    return values


def serialize_record(fields: Sequence[str], values: Mapping[str, str], label: str) -> bytes:
    if set(values) != set(fields):
        fail(f"cannot serialize incomplete {label}")
    result: list[str] = []
    for name in fields:
        value = values[name]
        if not value or any(ord(character) < 0x21 or ord(character) > 0x7e for character in value):
            fail(f"cannot serialize unsafe {label}")
        result.append(f"{name}={value}")
    return ("\n".join(result) + "\n").encode("ascii")


def require_digest(value: str, label: str, *, allow_none: bool = False) -> str:
    if allow_none and value == "none":
        return value
    if HEX_RE.fullmatch(value) is None:
        fail(f"{label} is not a lowercase SHA-256 digest")
    return value


def require_epoch(value: str, label: str, *, allow_none: bool = False) -> int | None:
    if allow_none and value == "none":
        return None
    if re.fullmatch(r"0|[1-9][0-9]*", value, re.ASCII) is None:
        fail(f"{label} is not a canonical decimal epoch")
    parsed = int(value)
    if parsed <= 0:
        fail(f"{label} must be positive")
    return parsed


def require_identity(value: str, label: str) -> str:
    if IDENTITY_RE.fullmatch(value) is None:
        fail(f"{label} is not canonical")
    return value


def require_service(value: str) -> str:
    if SERVICE_RE.fullmatch(value) is None:
        fail("service is not canonical")
    return value


def require_request_id(value: str) -> str:
    if REQUEST_ID_RE.fullmatch(value) is None:
        fail("request ID is not canonical")
    return value


def write_new_at(
    directory: PinnedDirectory,
    name: str,
    data: bytes,
    label: str,
    *,
    mode: int = 0o600,
    owner_uid: int = 0,
    owner_gid: int = 0,
) -> tuple[int, ...]:
    descriptor = -1
    try:
        descriptor = os.open(
            name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0),
            mode,
            dir_fd=directory.fd,
        )
        os.fchmod(descriptor, mode)
        os.fchown(descriptor, owner_uid, owner_gid)
        view = memoryview(data)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                fail(f"cannot write {label}")
            view = view[written:]
        os.fsync(descriptor)
        identity = file_identity(os.fstat(descriptor))
        os.close(descriptor)
        descriptor = -1
        os.fsync(directory.fd)
        require_snapshot(directory, name, identity, label)
        return identity
    except OSError as error:
        fail(f"cannot create {label}: {error.strerror}")
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def atomic_replace_at(directory: PinnedDirectory, name: str, data: bytes, label: str, *, mode: int = 0o600, expected: tuple[int, ...] | None = None) -> None:
    temporary = f".lifecycle-{name}-{secrets.token_hex(16)}"
    temporary_identity = write_new_at(directory, temporary, data, f"temporary {label}", mode=mode)
    try:
        if expected is None:
            try:
                os.stat(name, dir_fd=directory.fd, follow_symlinks=False)
            except FileNotFoundError:
                pass
            else:
                fail(f"{label} appeared during replacement")
        else:
            require_snapshot(directory, name, expected, label)
        os.replace(temporary, name, src_dir_fd=directory.fd, dst_dir_fd=directory.fd)
        os.fsync(directory.fd)
    except Exception:
        try:
            require_snapshot(directory, temporary, temporary_identity, f"temporary {label}")
            os.unlink(temporary, dir_fd=directory.fd)
            os.fsync(directory.fd)
        except (LifecycleError, OSError):
            pass
        raise


def rename_noreplace(parent: PinnedDirectory, source: str, destination: str, label: str) -> None:
    try:
        function = ctypes.CDLL(None, use_errno=True).renameat2
    except AttributeError:
        fail("atomic no-clobber publication is unavailable")
    function.argtypes = (ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint)
    function.restype = ctypes.c_int
    if function(parent.fd, os.fsencode(source), parent.fd, os.fsencode(destination), 1) != 0:
        error = ctypes.get_errno()
        if error == errno.EEXIST:
            raise FileExistsError(destination)
        fail(f"no-clobber {label} failed: {os.strerror(error)}")


def acquire_lock(state: PinnedDirectory, *, shared: bool = False) -> tuple[int, tuple[int, ...]]:
    data, identity, descriptor = read_at(state, "lock", "lifecycle lock", maximum=0, allow_empty=True, keep_open=True)
    if data:
        os.close(descriptor)
        fail("lifecycle lock must be empty")
    try:
        fcntl.flock(descriptor, (fcntl.LOCK_SH if shared else fcntl.LOCK_EX) | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(descriptor)
        fail("another lifecycle operation holds the state lock")
    require_snapshot(state, "lock", identity, "lifecycle lock")
    return descriptor, identity


def run(arguments: Sequence[str], label: str, *, input_data: bytes | None = None, pass_fds: Sequence[int] = (), accepted: frozenset[int] = frozenset((0,))) -> subprocess.CompletedProcess[bytes]:
    try:
        result = subprocess.run(
            tuple(arguments), input=input_data, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, pass_fds=tuple(pass_fds), timeout=30,
            check=False, env={**os.environ, "LC_ALL": "C"},
        )
    except (OSError, subprocess.TimeoutExpired):
        fail(f"cannot execute {label}")
    if result.returncode not in accepted:
        fail(f"{label} failed")
    return result


def memfd(data: bytes, label: str) -> int:
    if not hasattr(os, "memfd_create"):
        fail("anonymous validation staging is unavailable")
    descriptor = os.memfd_create(label, getattr(os, "MFD_CLOEXEC", 0))
    os.fchmod(descriptor, 0o600)
    view = memoryview(data)
    while view:
        written = os.write(descriptor, view)
        if written <= 0:
            os.close(descriptor)
            fail(f"cannot stage {label}")
        view = view[written:]
    os.lseek(descriptor, 0, os.SEEK_SET)
    return descriptor


def verify_ssh_signature(data: bytes, signature: bytes, allowed_signers: bytes, principal: str, namespace: str, label: str) -> None:
    signature_fd = memfd(signature, f"{label}-signature")
    trust_fd = memfd(allowed_signers, f"{label}-trust")
    try:
        run(
            ("ssh-keygen", "-Y", "verify", "-f", f"/proc/self/fd/{trust_fd}",
             "-I", principal, "-n", namespace, "-s", f"/proc/self/fd/{signature_fd}"),
            f"{label} signature verification", input_data=data,
            pass_fds=(signature_fd, trust_fd),
        )
    finally:
        os.close(trust_fd)
        os.close(signature_fd)


def parse_allowed_signers(data: bytes, label: str) -> dict[str, tuple[str, str]]:
    if not data.endswith(b"\n") or data.endswith(b"\n\n") or b"\r" in data:
        fail(f"{label} is not canonical")
    records: dict[str, tuple[str, str]] = {}
    try:
        lines = data.decode("ascii").splitlines()
    except UnicodeDecodeError:
        fail(f"{label} is not ASCII")
    for line in lines:
        parts = line.split(" ")
        if len(parts) != 3 or IDENTITY_RE.fullmatch(parts[0]) is None or parts[1] != "ssh-ed25519" or parts[0] in records:
            fail(f"{label} contains a noncanonical signer")
        try:
            decoded = base64.b64decode(parts[2], validate=True)
        except (binascii.Error, ValueError):
            fail(f"{label} contains invalid key data")
        if base64.b64encode(decoded).decode("ascii") != parts[2]:
            fail(f"{label} contains noncanonical key data")
        records[parts[0]] = (parts[1], parts[2])
    if not records:
        fail(f"{label} is empty")
    return records


def load_trust(state: PinnedDirectory, trust_id: str, target: str) -> tuple[dict[str, bytes], dict[str, str]]:
    if re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}", trust_id, re.ASCII) is None:
        fail("trust ID is not canonical")
    trust_root = PinnedDirectory.open(os.path.join(state.path, "trust"), "trust root")
    trust = PinnedDirectory.open(os.path.join(trust_root.path, trust_id), "frozen trust")
    try:
        if set(scan(trust, "frozen trust")) != set(TRUST_NAMES):
            fail("frozen trust does not contain the exact selected file set")
        data = {name: read_at(trust, name, f"frozen trust file {name}")[0] for name in TRUST_NAMES}
        policy = parse_record(data["policy"], POLICY_V3_FIELDS, "frozen trust policy")
        expected = {
            "schema": "3",
            "request_namespace": REQUEST_NAMESPACE_V2,
            "approval_namespace": "platform-pki-csr-approval-v2",
            "response_namespace": RESPONSE_NAMESPACE_V2,
            "request_max_age_seconds": "604800", "sole_operator_min_delay_seconds": "86400",
            "approval_max_age_seconds": "86400", "clock_skew_seconds": "300",
        }
        if any(policy[name] != value for name, value in expected.items()):
            fail("frozen trust policy differs from the target-local contract")
        requesters = parse_allowed_signers(data["requesters.allowed_signers"], "requester trust")
        approvers = parse_allowed_signers(data["approvers.allowed_signers"], "approver trust")
        responses = parse_allowed_signers(data["responses.allowed_signers"], "response trust")
        if target not in requesters:
            fail("target is absent from requester trust")
        if set(approvers) != {policy["approver_principal"]} or set(responses) != {policy["response_principal"]}:
            fail("frozen approver or response trust has an unexpected principal set")
        return data, policy
    finally:
        trust.close()
        trust_root.close()


def open_exact_tree(path: str, names: Sequence[str], label: str, modes: Mapping[str, int] | None = None) -> tuple[PinnedDirectory, dict[str, bytes], dict[str, tuple[int, ...]]]:
    directory = PinnedDirectory.open(path, label)
    actual = scan(directory, label)
    if set(actual) != set(names):
        directory.close()
        fail(f"{label} does not contain the exact fixed file set")
    contents: dict[str, bytes] = {}
    identities: dict[str, tuple[int, ...]] = {}
    try:
        for name in names:
            mode = modes[name] if modes is not None else 0o600
            contents[name], identities[name] = read_at(directory, name, f"{label} file {name}", mode=mode)
        directory.recheck(label)
        return directory, contents, identities
    except Exception:
        directory.close()
        raise


def validate_dns(value: str, label: str) -> str:
    if not value.isascii() or len(value) > 253 or value.endswith("."):
        fail(f"{label} is not a canonical DNS name")
    if any(re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", item, re.ASCII) is None for item in value.split(".")):
        fail(f"{label} is not a canonical DNS name")
    try:
        ipaddress.ip_address(value)
    except ValueError:
        return value
    fail(f"{label} must not be an IP address")


def validate_sans(common_name: str, dns_sans: Sequence[str], ip_sans: Sequence[str]):
    common = validate_dns(common_name, "common name")
    if not dns_sans or len(set(dns_sans)) != len(dns_sans) or len(set(ip_sans)) != len(ip_sans):
        fail("SAN values must be nonempty and unique")
    dns = tuple(validate_dns(value, "DNS SAN") for value in dns_sans)
    ips: list[str] = []
    for value in ip_sans:
        try:
            parsed = ipaddress.ip_address(value)
        except ValueError:
            fail("IP SAN is invalid")
        if not isinstance(parsed, ipaddress.IPv4Address) or str(parsed) != value:
            fail("IP SAN is not canonical IPv4")
        ips.append(value)
    return common, dns, tuple(ips)


def load_csr(data: bytes) -> x509.CertificateSigningRequest:
    if not data.endswith(b"\n") or b"\r" in data:
        fail("CSR is not canonical PEM")
    try:
        csr = x509.load_pem_x509_csr(data)
    except ValueError:
        fail("CSR is invalid")
    if csr.public_bytes(serialization.Encoding.PEM) != data or not csr.is_signature_valid:
        fail("CSR encoding or signature is invalid")
    return csr


def spki_digest(key) -> str:
    return sha256(key.public_bytes(serialization.Encoding.DER, serialization.PublicFormat.SubjectPublicKeyInfo))


def validate_csr(data: bytes, common_name: str | None = None, dns_sans: Sequence[str] = (), ip_sans: Sequence[str] = ()) -> tuple[x509.CertificateSigningRequest, str]:
    csr = load_csr(data)
    key = csr.public_key()
    if not isinstance(key, ec.EllipticCurvePublicKey) or not isinstance(key.curve, ec.SECP384R1) or not isinstance(csr.signature_hash_algorithm, hashes.SHA384):
        fail("CSR is not the exact P-384/SHA-384 profile")
    if common_name is not None:
        common, dns, ips = validate_sans(common_name, dns_sans, ip_sans)
        if csr.subject != x509.Name((x509.NameAttribute(NameOID.COMMON_NAME, common),)) or len(csr.extensions) != 1:
            fail("CSR subject or extension count is invalid")
        try:
            san = csr.extensions.get_extension_for_class(x509.SubjectAlternativeName)
        except x509.ExtensionNotFound:
            fail("CSR SAN extension is missing")
        expected = tuple(x509.DNSName(value) for value in dns) + tuple(x509.IPAddress(ipaddress.ip_address(value)) for value in ips)
        if san.critical or tuple(san.value) != expected:
            fail("CSR SANs differ from reviewed identities")
    return csr, spki_digest(key)


def private_key_spki(data: bytes) -> str:
    try:
        key = serialization.load_pem_private_key(data, password=None)
    except (TypeError, ValueError):
        fail("local private key is invalid")
    if not isinstance(key, ec.EllipticCurvePrivateKey) or not isinstance(key.curve, ec.SECP384R1):
        fail("local private key is not EC P-384")
    return spki_digest(key.public_key())


def pem_certificates(
    data: bytes, count: int | None, label: str
) -> tuple[x509.Certificate, ...]:
    matches = tuple(PEM_CERT_RE.finditer(data))
    if (
        not matches
        or (count is not None and len(matches) != count)
        or b"".join(match.group(0) for match in matches) != data
    ):
        fail(f"{label} does not contain the exact certificate count")
    certificates: list[x509.Certificate] = []
    for match in matches:
        try:
            certificate = x509.load_pem_x509_certificate(match.group(0))
        except ValueError:
            fail(f"{label} contains an invalid certificate")
        if certificate.public_bytes(serialization.Encoding.PEM) != match.group(0):
            fail(f"{label} contains noncanonical certificate encoding")
        certificates.append(certificate)
    return tuple(certificates)


def verify_certificate_signature(certificate: x509.Certificate, issuer: x509.Certificate, label: str) -> None:
    key = issuer.public_key()
    algorithm = certificate.signature_hash_algorithm
    try:
        if isinstance(key, ec.EllipticCurvePublicKey):
            key.verify(certificate.signature, certificate.tbs_certificate_bytes, ec.ECDSA(algorithm))
        elif isinstance(key, rsa.RSAPublicKey):
            key.verify(certificate.signature, certificate.tbs_certificate_bytes, padding.PKCS1v15(), algorithm)
        elif isinstance(key, (ed25519.Ed25519PublicKey, ed448.Ed448PublicKey)):
            key.verify(certificate.signature, certificate.tbs_certificate_bytes)
        else:
            fail(f"{label} uses an unsupported issuer key")
    except Exception as error:
        if isinstance(error, LifecycleError):
            raise
        fail(f"{label} signature verification failed")


def require_ca(certificate: x509.Certificate, path_length: int, label: str) -> None:
    try:
        basic = certificate.extensions.get_extension_for_class(x509.BasicConstraints)
        usage = certificate.extensions.get_extension_for_class(x509.KeyUsage)
    except x509.ExtensionNotFound:
        fail(f"{label} CA extensions are missing")
    if (
        not basic.critical or not basic.value.ca or basic.value.path_length != path_length
        or not usage.critical or not usage.value.key_cert_sign or not usage.value.crl_sign
        or usage.value.digital_signature or usage.value.key_encipherment or usage.value.key_agreement
    ):
        fail(f"{label} CA profile is invalid")


def request_is_expired(expires: int, current: int) -> bool:
    return current >= expires


def validate_pending(
    path: str,
    trust: Mapping[str, bytes],
    *,
    now: int | None = None,
    expected_request_id: str | None = None,
) -> dict[str, object]:
    directory, files, identities = open_exact_tree(path, PENDING_NAMES, "pending request")
    try:
        request = parse_record(files["request"], REQUEST_V2_FIELDS, "pending request record")
        current = int(time.time()) if now is None else now
        path_request_id = (
            os.path.basename(path)
            if expected_request_id is None
            else expected_request_id
        )
        if request["schema"] != "2" or request["request_id"] != path_request_id:
            fail("pending request identity is invalid")
        if request["operation"] not in {"issue", "renew"}:
            fail("target-local request operation is invalid")
        require_request_id(request["request_id"])
        require_service(request["service"])
        require_identity(request["target"], "pending target")
        if request["requester_principal"] != request["target"] or request["profile"] != PROFILE:
            fail("pending request principal or profile is invalid")
        created = require_epoch(request["created_epoch"], "pending created epoch")
        expires = require_epoch(request["expires_epoch"], "pending expiry epoch")
        assert created is not None and expires is not None
        if expires <= created or expires - created > 604800 or created > current + 300:
            fail("pending request lifetime is invalid")
        if request["csr_sha256"] != sha256(files["tls.csr"]):
            fail("pending CSR digest binding is invalid")
        _csr, csr_spki = validate_csr(files["tls.csr"])
        key_spki = private_key_spki(files["tls.key"])
        if request["csr_spki_sha256"] != csr_spki or key_spki != csr_spki:
            fail("pending key and CSR SPKI binding is invalid")
        verify_ssh_signature(
            files["request"], files["request.sig"], trust["requesters.allowed_signers"],
            request["requester_principal"], REQUEST_NAMESPACE_V2,
            "request",
        )
        for name, identity in identities.items():
            require_snapshot(directory, name, identity, f"pending request file {name}")
        return {
            "record": request,
            "files": files,
            "expires": expires,
            "expired": request_is_expired(expires, current),
        }
    finally:
        directory.close()


def validate_response_files(files: Mapping[str, bytes], pending: Mapping[str, object], trust: Mapping[str, bytes], args, *, now: int | None = None) -> dict[str, object]:
    request = pending["record"]
    request_files = pending["files"]
    assert isinstance(request, dict) and isinstance(request_files, dict)
    response = parse_record(files["response"], RESPONSE_V2_FIELDS, "response")
    artifact = parse_record(files["artifact"], ARTIFACT_FIELDS, "artifact")
    current = int(time.time()) if now is None else now
    if (
        response["schema"] != "2" or response["request_id"] != request["request_id"]
        or response["nonce"] != request["nonce"] or response["operation"] != request["operation"]
        or response["service"] != request["service"] or response["target"] != request["target"]
        or response["request_sha256"] != sha256(request_files["request"])
        or response["inventory_sha256"] != request["inventory_sha256"]
        or response["csr_sha256"] != request["csr_sha256"]
        or response["csr_spki_sha256"] != request["csr_spki_sha256"]
    ):
        fail("response does not bind the exact pending request")
    if (
        response["request_signature_sha256"] != sha256(request_files["request.sig"])
        or response["request_trust_sha256"] != sha256(trust["requesters.allowed_signers"])
        or response["approval_trust_sha256"] != sha256(trust["approvers.allowed_signers"])
        or HEX_RE.fullmatch(response["approval_sha256"]) is None
        or HEX_RE.fullmatch(response["approval_signature_sha256"]) is None
        or response["current_cert_sha256"] != request["current_cert_sha256"]
        or response["predecessor_request_id"] != request["predecessor_request_id"]
        or response["issuance_state"] != "issued"
    ):
        fail("issued response does not bind request signatures and frozen trust")
    principal = response["response_principal"]
    if principal != request["response_principal"]:
        fail("response principal differs from the pending request")
    verify_ssh_signature(
        files["response"], files["response.sig"], trust["responses.allowed_signers"], principal,
        RESPONSE_NAMESPACE_V2, "response",
    )
    response_sha = sha256(files["response"])
    signature_sha = sha256(files["response.sig"])
    certificate_sha = sha256(files["tls.crt"])
    chain_sha = sha256(files["ca-chain.crt"])
    fullchain_sha = sha256(files["fullchain.crt"])
    expected_artifact = {
        "schema": "2", "kind": "certificate-export", "service": request["service"],
        "request_id": request["request_id"], "operation": request["operation"],
        "target": request["target"], "source_kind": "csr-response",
        "source_response_sha256": response_sha,
        "source_response_signature_sha256": signature_sha,
        "certificate_sha256": certificate_sha,
        "certificate_spki_sha256": response["certificate_spki_sha256"],
        "chain_sha256": chain_sha, "fullchain_sha256": fullchain_sha,
        "issuer_root": response["issuer_root"],
        "issuer_intermediate": response["issuer_intermediate"], "serial": response["serial"],
        "not_before_epoch": response["not_before_epoch"], "not_after_epoch": response["not_after_epoch"],
        "response_principal": principal, "created_epoch": response["created_epoch"],
    }
    if artifact != expected_artifact or response["certificate_sha256"] != certificate_sha or response["chain_sha256"] != chain_sha:
        fail("artifact or response does not bind the exact certificate files")
    leaf = pem_certificates(files["tls.crt"], 1, "leaf certificate")[0]
    intermediate, root = pem_certificates(files["ca-chain.crt"], 2, "CA chain")
    if files["fullchain.crt"] != files["tls.crt"] + intermediate.public_bytes(serialization.Encoding.PEM):
        fail("full chain is not exact leaf plus intermediate")
    if leaf.issuer != intermediate.subject or intermediate.issuer != root.subject or root.issuer != root.subject:
        fail("certificate issuer names do not form the exact chain")
    verify_certificate_signature(leaf, intermediate, "leaf certificate")
    verify_certificate_signature(intermediate, root, "intermediate certificate")
    verify_certificate_signature(root, root, "root certificate")
    require_ca(intermediate, 0, "intermediate certificate")
    require_ca(root, 1, "root certificate")
    common, dns, ips = validate_sans(args.common_name, args.dns_san, args.ip_san)
    key = leaf.public_key()
    if (
        leaf.version is not x509.Version.v3 or not isinstance(key, ec.EllipticCurvePublicKey)
        or not isinstance(key.curve, ec.SECP384R1) or not isinstance(leaf.signature_hash_algorithm, hashes.SHA384)
        or leaf.subject != x509.Name((x509.NameAttribute(NameOID.COMMON_NAME, common),))
    ):
        fail("leaf certificate is not the exact P-384 server profile")
    try:
        basic = leaf.extensions.get_extension_for_class(x509.BasicConstraints)
        usage = leaf.extensions.get_extension_for_class(x509.KeyUsage)
        eku = leaf.extensions.get_extension_for_class(x509.ExtendedKeyUsage)
        san = leaf.extensions.get_extension_for_class(x509.SubjectAlternativeName)
        ski = leaf.extensions.get_extension_for_class(x509.SubjectKeyIdentifier)
        aki = leaf.extensions.get_extension_for_class(x509.AuthorityKeyIdentifier)
        issuer_ski = intermediate.extensions.get_extension_for_class(x509.SubjectKeyIdentifier)
    except x509.ExtensionNotFound:
        fail("leaf certificate is missing a required extension")
    expected_sans = tuple(x509.DNSName(value) for value in dns) + tuple(x509.IPAddress(ipaddress.ip_address(value)) for value in ips)
    if (
        len(leaf.extensions) != 6 or not basic.critical or basic.value.ca or basic.value.path_length is not None
        or not usage.critical or not usage.value.digital_signature or usage.value.content_commitment
        or usage.value.key_encipherment or usage.value.data_encipherment or usage.value.key_agreement
        or usage.value.key_cert_sign or usage.value.crl_sign or eku.critical
        or tuple(eku.value) != (ExtendedKeyUsageOID.SERVER_AUTH,) or san.critical
        or tuple(san.value) != expected_sans or ski.critical or aki.critical
        or aki.value.key_identifier != issuer_ski.value.digest
    ):
        fail("leaf certificate extensions do not match the exact server profile")
    certificate_spki = spki_digest(key)
    pending_key_spki = private_key_spki(request_files["tls.key"])
    _csr, csr_spki = validate_csr(request_files["tls.csr"], args.common_name, args.dns_san, args.ip_san)
    if certificate_spki != response["certificate_spki_sha256"] or certificate_spki != pending_key_spki or certificate_spki != csr_spki:
        fail("certificate, local key, and CSR public keys differ")
    serial = format(leaf.serial_number, "X")
    if len(serial) % 2:
        serial = "0" + serial
    not_before = int(leaf.not_valid_before_utc.timestamp())
    not_after = int(leaf.not_valid_after_utc.timestamp())
    created = require_epoch(response["created_epoch"], "response created epoch")
    response_before = require_epoch(response["not_before_epoch"], "response not-before epoch")
    response_after = require_epoch(response["not_after_epoch"], "response not-after epoch")
    if (
        serial != response["serial"] or (response_before, response_after) != (not_before, not_after)
        or not_before > current + 300 or current >= not_after
        or not_after - current < args.minimum_remaining_lifetime_seconds
        or created is None or created < not_before - 300 or created > current + 300 or created > not_after
    ):
        fail("certificate validity or signed metadata is invalid")
    return {
        "request": request, "response": response, "artifact": artifact,
        "artifact_sha256": sha256(files["artifact"]), "response_sha256": response_sha,
        "response_signature_sha256": signature_sha, "certificate_sha256": certificate_sha,
        "certificate_spki_sha256": certificate_spki, "chain_sha256": chain_sha,
        "fullchain_sha256": fullchain_sha, "intermediate_sha256": sha256(intermediate.public_bytes(serialization.Encoding.PEM)),
        "not_before_epoch": not_before, "not_after_epoch": not_after,
    }


def version_modes() -> dict[str, int]:
    return {name: (0o644 if name in CERTIFICATE_NAMES else 0o600) for name in VERSION_NAMES}


def validate_version(path: str, expected_request_id: str | None = None) -> tuple[PinnedDirectory, dict[str, bytes], dict[str, tuple[int, ...]]]:
    if expected_request_id is not None and os.path.basename(path) != expected_request_id:
        fail("version path request identity is invalid")
    return open_exact_tree(path, VERSION_NAMES, "immutable certificate version", version_modes())


def parse_active(data: bytes, args) -> dict[str, str]:
    record = parse_record(data, ACTIVE_FIELDS, "active record")
    if record["schema"] != "2" or record["kind"] != "host-local-active" or record["service"] != args.service or record["target"] != args.target:
        fail("active record identity is invalid")
    require_request_id(record["request_id"])
    for field in ("artifact_manifest_sha256", "response_sha256", "response_signature_sha256", "certificate_sha256", "certificate_spki_sha256", "chain_sha256", "fullchain_sha256", "zot_config_sha256"):
        require_digest(record[field], f"active {field}")
    canonical_path(record["version_path"], "active version path")
    require_epoch(record["activation_epoch"], "active activation epoch")
    require_epoch(record["rollback_deadline_epoch"], "active rollback deadline")
    for field in ("version_device", "version_inode"):
        if re.fullmatch(r"0|[1-9][0-9]*", record[field], re.ASCII) is None:
            fail(f"active {field} is invalid")
    return record


def parse_rollback(data: bytes, args) -> dict[str, str]:
    record = parse_record(data, ROLLBACK_FIELDS, "rollback record")
    if record["schema"] != "2" or record["kind"] != "host-local-rollback" or record["service"] != args.service or record["target"] != args.target:
        fail("rollback record identity is invalid")
    if record["predecessor_kind"] not in {"host-local", "none"}:
        fail("rollback predecessor kind is invalid")
    return record


def read_optional_state(state: PinnedDirectory, name: str) -> tuple[bytes | None, tuple[int, ...] | None]:
    if name not in scan(state, "state root"):
        return None, None
    return read_at(state, name, f"state file {name}")


def canonical_json(data: object) -> bytes:
    return (json.dumps(data, sort_keys=True, separators=(",", ":"), ensure_ascii=True) + "\n").encode("ascii")


def parse_zot_config(data: bytes) -> tuple[dict[str, object], str, str]:
    try:
        value = json.loads(data)
    except (UnicodeDecodeError, json.JSONDecodeError):
        fail("Zot configuration is not valid JSON")
    if not isinstance(value, dict) or not isinstance(value.get("http"), dict):
        fail("Zot configuration lacks an http object")
    tls = value["http"].get("tls")
    if not isinstance(tls, dict) or set(tls) != {"cert", "key"}:
        fail("Zot configuration lacks the exact TLS path object")
    cert = tls["cert"]
    key = tls["key"]
    if not isinstance(cert, str) or not isinstance(key, str):
        fail("Zot TLS paths are not strings")
    canonical_path(cert, "Zot certificate path")
    canonical_path(key, "Zot key path")
    return value, cert, key


def authenticate_active(state: PinnedDirectory, args, *, require_config: bool = True) -> dict[str, object] | None:
    active_data, _identity = read_optional_state(state, "active")
    if active_data is None:
        return None
    active = parse_active(active_data, args)
    expected_path = os.path.join(args.versions_root, active["request_id"])
    if active["version_path"] != expected_path:
        fail("active record does not use the canonical version path")
    version, files, identities = validate_version(expected_path, active["request_id"])
    try:
        metadata = os.fstat(version.fd)
        if str(metadata.st_dev) != active["version_device"] or str(metadata.st_ino) != active["version_inode"]:
            fail("active version directory identity differs from its record")
        checks = {
            "artifact_manifest_sha256": sha256(files["artifact"]),
            "response_sha256": sha256(files["response"]),
            "response_signature_sha256": sha256(files["response.sig"]),
            "certificate_sha256": sha256(files["tls.crt"]),
            "certificate_spki_sha256": private_key_spki(files["tls.key"]),
            "chain_sha256": sha256(files["ca-chain.crt"]),
            "fullchain_sha256": sha256(files["fullchain.crt"]),
        }
        if any(active[name] != value for name, value in checks.items()):
            fail("active record digest binding is invalid")
        leaf = pem_certificates(files["tls.crt"], 1, "active leaf certificate")[0]
        if spki_digest(leaf.public_key()) != active["certificate_spki_sha256"]:
            fail("active certificate and key SPKI differ")
        if require_config:
            config_data, _ = read_path(args.zot_config, "Zot configuration", mode=0o644)
            _config, cert_path, key_path = parse_zot_config(config_data)
            if cert_path != os.path.join(expected_path, "fullchain.crt") or key_path != os.path.join(expected_path, "tls.key") or sha256(config_data) != active["zot_config_sha256"]:
                fail("Zot configuration does not select the authenticated active version")
        return {
            "record": active, "record_bytes": active_data, "files": files,
            "not_before_epoch": int(leaf.not_valid_before_utc.timestamp()),
            "not_after_epoch": int(leaf.not_valid_after_utc.timestamp()),
        }
    finally:
        version.close()


def state_entries(state: PinnedDirectory) -> set[str]:
    entries = set(scan(state, "state root"))
    allowed = {
        "lock", "trust", "active", "rollback",
        "target-terminal", "target-terminal-history", "activation-journal",
        "request.journal", "trust-install.journal",
    }
    if not entries.issubset(allowed):
        fail("state root contains unexpected entries")
    return entries


def common_open(args, *, shared: bool = False):
    validate_roots(args.state_root, args.pending_root, args.versions_root)
    require_service(args.service)
    require_identity(args.target, "target")
    state = PinnedDirectory.open(args.state_root, "state root")
    lock, lock_identity = acquire_lock(state, shared=shared)
    state.recheck("state root")
    require_snapshot(state, "lock", lock_identity, "lifecycle lock")
    return state, lock


def json_output(value: Mapping[str, object]) -> None:
    print(json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def prepare_collection_output(
    args,
    names: Sequence[str],
    files: Mapping[str, bytes],
    label: str,
    revalidate,
) -> str:
    if args.output_owner_uid < 0:
        fail("output owner UID is invalid")
    canonical_path(args.output_dir, f"{label} output directory")
    output = PinnedDirectory.open(
        args.output_dir,
        f"{label} output directory",
        allowed_owner_uids=trusted_ancestor_owners() | {args.output_owner_uid},
        final_owner_uid=args.output_owner_uid,
        owner_uid_only=True,
    )
    try:
        entries = scan(output, f"{label} output directory")
        if entries and set(entries) != set(names):
            fail(f"{label} output is partial or contains unexpected entries")
        if entries:
            for name in names:
                data, _ = read_at(
                    output, name, f"existing {label} file {name}",
                    owner_uid=args.output_owner_uid,
                )
                if data != files[name]:
                    fail(f"existing {label} output conflicts with authenticated source")
            revalidate()
            output.recheck(f"{label} output directory")
            return "existing"
        if args.check:
            revalidate()
            output.recheck(f"{label} output directory")
            return "would-collect"
        created: dict[str, tuple[int, ...]] = {}
        try:
            for name in names:
                created[name] = write_new_at(
                    output, name, files[name], f"{label} file {name}",
                    owner_uid=args.output_owner_uid,
                )
            os.fsync(output.fd)
            revalidate()
            if set(scan(output, f"{label} output directory")) != set(created):
                fail(f"{label} output changed during publication")
            for name in names:
                data, identity = read_at(
                    output, name, f"published {label} file {name}",
                    owner_uid=args.output_owner_uid,
                )
                if data != files[name] or identity != created[name]:
                    fail(f"published {label} bytes changed")
        except Exception:
            for name, identity in created.items():
                try:
                    require_snapshot(output, name, identity, f"{label} file {name}")
                    os.unlink(name, dir_fd=output.fd)
                except (LifecycleError, OSError):
                    pass
            os.fsync(output.fd)
            raise
        return "collected"
    finally:
        output.close()


def collection_prepare(args) -> None:
    state, lock = common_open(args)
    try:
        entries = state_entries(state)
        if entries & {"activation-journal", "request.journal", "trust-install.journal"}:
            fail("unresolved lifecycle state blocks request collection")
        trust, policy = load_trust(state, args.trust_id, args.target)
        pending_path = os.path.join(args.pending_root, require_request_id(args.request_id))
        pending = validate_pending(pending_path, trust)
        if pending["expired"]:
            fail("expired pending request cannot be collected")
        request = pending["record"]
        assert isinstance(request, dict)
        if request["service"] != args.service or request["target"] != args.target or request["response_principal"] != policy["response_principal"]:
            fail("pending request differs from collection bindings")
        names = ("tls.csr", "request", "request.sig")
        status_value = prepare_collection_output(
            args,
            names,
            {name: pending["files"][name] for name in names},
            "collection",
            lambda: validate_pending(pending_path, trust),
        )
        json_output({"status": status_value, "request_id": args.request_id, "request_sha256": sha256(pending["files"]["request"]), "csr_sha256": sha256(pending["files"]["tls.csr"]), "request_signature_sha256": sha256(pending["files"]["request.sig"])})
    finally:
        os.close(lock)
        state.close()


def response_prepare(args) -> None:
    state, lock = common_open(args)
    versions: PinnedDirectory | None = None
    ingress: PinnedDirectory | None = None
    try:
        if state_entries(state) & {"activation-journal"}:
            fail("lifecycle recovery is required before response preparation")
        request_id = require_request_id(args.request_id)
        if not os.path.lexists(args.versions_root):
            if args.check:
                fail("versions root is absent in check mode")
            create_private_directory(args.versions_root, "versions root")
        versions = PinnedDirectory.open(args.versions_root, "versions root")
        ingress_name = f".ingress-{request_id}"
        entries = scan(versions, "versions root")
        if request_id in entries:
            validate_version(os.path.join(args.versions_root, request_id), request_id)[0].close()
            json_output({"status": "installed", "request_id": request_id, "ingress_dir": "none"})
            return
        trust, _policy = load_trust(state, args.trust_id, args.target)
        pending = validate_pending(
            os.path.join(args.pending_root, request_id),
            trust,
            expected_request_id=request_id,
        )
        if pending["expired"]:
            fail("expired pending request cannot receive a response")
        if (
            pending["record"]["service"] != args.service
            or pending["record"]["target"] != args.target
        ):
            fail("pending request differs from response preparation bindings")
        if ingress_name not in entries:
            if args.check:
                json_output({"status": "would-prepare", "request_id": request_id, "ingress_dir": os.path.join(args.versions_root, ingress_name)})
                return
            os.mkdir(ingress_name, 0o700, dir_fd=versions.fd)
            os.fsync(versions.fd)
            status = "prepared"
        else:
            status = "existing"
        ingress = PinnedDirectory.open(os.path.join(args.versions_root, ingress_name), "response ingress")
        actual = scan(ingress, "response ingress")
        if not set(actual).issubset(set(RESPONSE_NAMES)):
            fail("response ingress contains unexpected entries")
        for name in actual:
            read_at(ingress, name, f"response ingress file {name}")
        metadata = os.fstat(ingress.fd)
        json_output({"status": status, "request_id": request_id, "ingress_dir": ingress.path, "ingress_device": metadata.st_dev, "ingress_inode": metadata.st_ino})
    finally:
        if ingress is not None:
            ingress.close()
        if versions is not None:
            versions.close()
        os.close(lock)
        state.close()


def remove_exact_tree(parent: PinnedDirectory, name: str, directory: PinnedDirectory, identities: Mapping[str, tuple[int, ...]], label: str) -> None:
    directory.recheck(label)
    for child, identity in identities.items():
        require_snapshot(directory, child, identity, f"{label} file {child}")
        os.unlink(child, dir_fd=directory.fd)
    os.fsync(directory.fd)
    expected = dir_identity(os.fstat(directory.fd))
    actual = os.stat(name, dir_fd=parent.fd, follow_symlinks=False)
    if dir_identity(actual) != expected:
        fail(f"{label} path binding changed")
    os.rmdir(name, dir_fd=parent.fd)
    os.fsync(parent.fd)


def response_install(args) -> None:
    state, lock = common_open(args)
    versions: PinnedDirectory | None = None
    ingress: PinnedDirectory | None = None
    stage: PinnedDirectory | None = None
    pending_directory: PinnedDirectory | None = None
    try:
        if state_entries(state) & {"activation-journal", "request.journal", "trust-install.journal"}:
            fail("unresolved lifecycle state blocks response installation")
        trust, _policy = load_trust(state, args.trust_id, args.target)
        request_id = require_request_id(args.request_id)
        require_digest(args.artifact_sha256, "artifact pin")
        pending_path = os.path.join(args.pending_root, request_id)
        pending = validate_pending(pending_path, trust)
        if pending["expired"]:
            fail("expired pending request cannot consume a response")
        if pending["record"]["service"] != args.service or pending["record"]["target"] != args.target:
            fail("pending request differs from response installation bindings")
        versions = PinnedDirectory.open(args.versions_root, "versions root")
        if os.fstat(versions.fd).st_dev != os.lstat(args.pending_root).st_dev:
            fail("pending and versions roots are not on one filesystem")
        ingress_name = f".ingress-{request_id}"
        ingress_path = os.path.join(args.versions_root, ingress_name)
        ingress, response_files, ingress_identities = open_exact_tree(ingress_path, RESPONSE_NAMES, "response ingress")
        validated = validate_response_files(response_files, pending, trust, args)
        destination = os.path.join(args.versions_root, request_id)
        if request_id in scan(versions, "versions root"):
            existing, existing_files, _ = validate_version(destination, request_id)
            try:
                expected = {"tls.key": pending["files"]["tls.key"], "tls.csr": pending["files"]["tls.csr"], **response_files}
                if existing_files != expected:
                    fail("existing immutable version conflicts with the exact response")
            finally:
                existing.close()
            if not args.check:
                remove_exact_tree(versions, ingress_name, ingress, ingress_identities, "response ingress")
                ingress.close()
                ingress = None
            json_output({"status": "existing", "request_id": request_id, "version_path": destination, "artifact_sha256": validated["artifact_sha256"], "certificate_sha256": validated["certificate_sha256"], "certificate_spki_sha256": validated["certificate_spki_sha256"]})
            return
        if args.check:
            json_output({"status": "would-install", "request_id": request_id, "version_path": destination, "artifact_sha256": validated["artifact_sha256"], "certificate_sha256": validated["certificate_sha256"], "certificate_spki_sha256": validated["certificate_spki_sha256"]})
            return
        stage_name = f".stage-{request_id}-{secrets.token_hex(16)}"
        os.mkdir(stage_name, 0o700, dir_fd=versions.fd)
        os.fsync(versions.fd)
        stage = PinnedDirectory.open(os.path.join(args.versions_root, stage_name), "version stage")
        stage_identity = dir_identity(os.fstat(stage.fd))
        publication = {"tls.key": pending["files"]["tls.key"], "tls.csr": pending["files"]["tls.csr"], **response_files}
        for name in VERSION_NAMES:
            write_new_at(stage, name, publication[name], f"version file {name}", mode=version_modes()[name])
        staged, staged_files, _ = validate_version(stage.path)
        staged.close()
        if staged_files != publication:
            fail("staged version bytes changed")
        validate_pending(pending_path, trust)
        for name, identity in ingress_identities.items():
            require_snapshot(ingress, name, identity, f"response ingress file {name}")
        fault("before-version-publication")
        rename_noreplace(versions, stage_name, request_id, "version publication")
        os.fsync(versions.fd)
        stage.path = destination
        if dir_identity(os.stat(request_id, dir_fd=versions.fd, follow_symlinks=False)) != stage_identity:
            fail("published version identity changed")
        validate_version(destination, request_id)[0].close()
        remove_exact_tree(versions, ingress_name, ingress, ingress_identities, "response ingress")
        ingress.close()
        ingress = None
        json_output({"status": "installed", "request_id": request_id, "version_path": destination, "artifact_sha256": validated["artifact_sha256"], "certificate_sha256": validated["certificate_sha256"], "certificate_spki_sha256": validated["certificate_spki_sha256"]})
    finally:
        if pending_directory is not None:
            pending_directory.close()
        if stage is not None:
            stage.close()
        if ingress is not None:
            ingress.close()
        if versions is not None:
            versions.close()
        os.close(lock)
        state.close()


def b64_value(data: bytes | None) -> str:
    return "none" if data is None else base64.b64encode(data).decode("ascii")


def b64_digest(data: bytes | None) -> str:
    return "none" if data is None else sha256(data)


def decode_bound_bytes(value: str, digest: str, label: str, *, allow_none: bool = False) -> bytes | None:
    if allow_none and value == "none" and digest == "none":
        return None
    require_digest(digest, f"{label} digest")
    try:
        data = base64.b64decode(value, validate=True)
    except (binascii.Error, ValueError):
        fail(f"{label} is not canonical base64")
    if base64.b64encode(data).decode("ascii") != value or sha256(data) != digest:
        fail(f"{label} bytes do not match their digest")
    return data


def fault(point: str) -> None:
    if os.environ.get("PLATFORM_PKI_LIFECYCLE_PAUSE_AT") == point:
        time.sleep(2)
    if os.environ.get("PLATFORM_PKI_LIFECYCLE_CRASH_AT") == point:
        os.kill(os.getpid(), signal.SIGKILL)
    if os.environ.get("PLATFORM_PKI_LIFECYCLE_FAIL_AT") == point:
        fail(f"injected lifecycle failure at {point}")


def lifecycle_epoch() -> int:
    sequence_name = "PLATFORM_PKI_LIFECYCLE_TEST_EPOCH_SEQUENCE"
    sequence = os.environ.pop(sequence_name, None)
    if sequence is not None:
        values = sequence.split(",")
        if len(values) != 2:
            fail("epoch sequence test seam requires exactly two epochs")
        override = values[0]
        os.environ["PLATFORM_PKI_LIFECYCLE_TEST_EPOCH"] = values[1]
    else:
        override = os.environ.get("PLATFORM_PKI_LIFECYCLE_TEST_EPOCH")
    if override is None:
        return int(time.time())
    if os.environ.get("PLATFORM_PKI_LIFECYCLE_TESTING") != "1":
        fail("epoch test seam requires explicit synthetic-test mode")
    parsed = require_epoch(override, "epoch test seam")
    assert parsed is not None
    return parsed


def systemctl_path() -> str:
    testing = os.environ.get("PLATFORM_PKI_LIFECYCLE_TESTING") == "1"
    override = os.environ.get("PLATFORM_PKI_LIFECYCLE_TEST_SYSTEMCTL")
    if override is not None:
        if not testing:
            fail("systemctl test seam requires explicit synthetic-test mode")
        canonical_path(override, "systemctl test seam")
        return override
    return "/usr/bin/systemctl"


def service_state() -> str:
    result = run((systemctl_path(), "is-active", "zot.service"), "Zot service-state query", accepted=frozenset((0, 3)))
    try:
        value = result.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        fail("Zot service state is not ASCII")
    if value not in {"active", "inactive"}:
        fail("Zot service state is not canonical active/inactive")
    return value


def service_enabled_state() -> str:
    result = run((systemctl_path(), "is-enabled", "zot.service"), "Zot service enablement query", accepted=frozenset((0, 1)))
    try:
        value = result.stdout.decode("ascii").strip()
    except UnicodeDecodeError:
        fail("Zot service enablement state is not ASCII")
    if value not in {"enabled", "disabled", "generated", "masked"}:
        fail("Zot service enablement state is not canonical")
    return value


def service_action(action: str) -> None:
    if action not in {"restart", "stop", "enable-start", "disable-stop"}:
        fail("service recovery action is invalid")
    commands = {
        "restart": (("restart", "zot.service"),),
        "stop": (("stop", "zot.service"),),
        "enable-start": (("unmask", "zot.service"), ("start", "zot.service")),
        "disable-stop": (("stop", "zot.service"), ("mask", "zot.service")),
    }[action]
    for command in commands:
        run((systemctl_path(), *command), f"systemctl {' '.join(command)}")


def wait_for_tls_listener(
    host: str,
    port: int,
    *,
    timeout_seconds: float = LOCAL_READY_SECONDS,
    interval_seconds: float = 0.25,
) -> None:
    deadline = time.monotonic() + timeout_seconds
    while True:
        try:
            connection = socket.create_connection(
                (host, port), timeout=min(1.0, max(0.1, deadline - time.monotonic()))
            )
        except OSError:
            if time.monotonic() >= deadline:
                fail("Zot TLS listener did not become ready after restart")
            time.sleep(interval_seconds)
            continue
        connection.close()
        return


def strict_local_validation(args, expected_certificate: str, expected_intermediate: str) -> dict[str, str]:
    seam = os.environ.get("PLATFORM_PKI_LIFECYCLE_TEST_LOCAL_VALIDATION")
    if seam is not None:
        if os.environ.get("PLATFORM_PKI_LIFECYCLE_TESTING") != "1":
            fail("local validation test seam requires explicit synthetic-test mode")
        data, _ = read_path(seam, "local validation test seam")
        record = parse_record(data, ("schema", "service_result", "tls_result", "served_certificate_sha256", "served_intermediate_sha256"), "local validation test seam")
        if record != {"schema": "2", "service_result": "passed", "tls_result": "passed", "served_certificate_sha256": expected_certificate, "served_intermediate_sha256": expected_intermediate}:
            fail("local validation test observation does not match the active candidate")
        return record
    ca_data, _ = read_path(args.reviewed_ca, "reviewed validation CA", mode=args.reviewed_ca_mode)
    certificates = pem_certificates(ca_data, 2, "reviewed validation CA")
    if sha256(certificates[0].public_bytes(serialization.Encoding.PEM)) != expected_intermediate:
        fail("reviewed validation CA does not begin with the expected intermediate")
    parsed = urllib.parse.urlsplit(args.endpoint)
    if parsed.scheme != "https" or not parsed.hostname or parsed.path != "/v2/" or parsed.query or parsed.fragment:
        fail("validation endpoint must be exact HTTPS /v2/")
    host = validate_dns(parsed.hostname, "validation endpoint host")
    port = parsed.port or 443
    wait_for_tls_listener(host, port)
    ca_descriptor = memfd(ca_data, "reviewed-validation-ca")
    try:
        handshake = run(
            (
                "openssl", "s_client", "-connect", f"{host}:{port}",
                "-servername", host, "-verify_hostname", host,
                "-verify_return_error", "-CAfile", f"/proc/self/fd/{ca_descriptor}",
                "-showcerts",
            ),
            "strict local TLS chain validation",
            input_data=b"",
            pass_fds=(ca_descriptor,),
        )
    finally:
        os.close(ca_descriptor)
    served_matches = tuple(PEM_CERT_RE.finditer(handshake.stdout))
    if len(served_matches) < 2:
        fail("strict local TLS validation did not return a leaf and intermediate")
    served_leaf = served_matches[0].group(0)
    served_intermediate = served_matches[1].group(0)
    if sha256(served_leaf) != expected_certificate or sha256(served_intermediate) != expected_intermediate:
        fail("strict local TLS chain does not match the active candidate")
    context = ssl.create_default_context(cadata=ca_data.decode("ascii"))
    connection = http.client.HTTPSConnection(host, port, context=context, timeout=10)
    try:
        connection.request("GET", "/v2/", headers={"Host": host})
        response = connection.getresponse()
        response.read(65536)
        sock = connection.sock
        if sock is None:
            fail("local TLS socket is unavailable")
        served = sha256(ssl.DER_cert_to_PEM_cert(sock.getpeercert(binary_form=True)).encode("ascii"))
    except (OSError, ssl.SSLError, http.client.HTTPException):
        fail("strict local Zot validation failed")
    finally:
        connection.close()
    if response.status not in {200, 401}:
        fail("local Zot response returned a disallowed HTTP status")
    api_header = response.getheader("Docker-Distribution-Api-Version")
    if api_header is None:
        fail("local Zot response omits the OCI distribution API header")
    if api_header != "registry/2.0":
        fail("local Zot response has an unexpected OCI distribution API header")
    if served != expected_certificate:
        fail("local Zot response served a certificate outside the candidate pin")
    return {"schema": "2", "service_result": "passed", "tls_result": "passed", "served_certificate_sha256": served, "served_intermediate_sha256": sha256(served_intermediate)}


def journal_record(data: bytes, args) -> dict[str, str]:
    record = parse_record(data, ACTIVATION_JOURNAL_FIELDS, "activation journal")
    if (
        record["schema"] != "2" or record["kind"] != "host-local-activation"
        or record["service"] != args.service or record["target"] != args.target
        or REQUEST_ID_RE.fullmatch(record["request_id"]) is None
        or REQUEST_ID_RE.fullmatch(record["transaction_id"]) is None
        or record["recovery_action"] != "restore-prior"
        or record["checkpoint"] not in {"prepared", "records-written", "config-written", "restarted", "local-validated", "not-activated", "rolled-back"}
    ):
        fail("activation journal identity or checkpoint is invalid")
    require_digest(record["artifact_manifest_sha256"], "journal artifact digest")
    for field in (
        "target_response_sha256", "target_response_signature_sha256",
        "target_certificate_sha256", "target_certificate_spki_sha256",
        "target_chain_sha256", "target_fullchain_sha256",
    ):
        require_digest(record[field], f"journal {field}")
    expected_version = os.path.join(args.versions_root, record["request_id"])
    if record["target_version_path"] != expected_version:
        fail("activation journal target version path is invalid")
    for field in ("target_version_device", "target_version_inode"):
        if re.fullmatch(r"0|[1-9][0-9]*", record[field], re.ASCII) is None:
            fail(f"activation journal {field} is invalid")
    created = require_epoch(record["created_epoch"], "journal created epoch")
    deadline = require_epoch(record["rollback_deadline_epoch"], "journal rollback deadline")
    assert created is not None and deadline is not None
    if deadline <= created:
        fail("activation journal rollback deadline is invalid")
    decoded: dict[str, bytes | None] = {}
    for prefix, allow_none in (("prior_active", True), ("new_active", False), ("prior_rollback", True), ("new_rollback", False), ("prior_zot_config", False), ("target_zot_config", False)):
        decoded[prefix] = decode_bound_bytes(
            record[f"{prefix}_b64"], record[f"{prefix}_sha256"],
            f"journal {prefix}", allow_none=allow_none,
        )
    assert decoded["new_active"] is not None
    assert decoded["new_rollback"] is not None
    assert decoded["prior_zot_config"] is not None
    assert decoded["target_zot_config"] is not None
    if record["prior_service_state"] not in {"active", "inactive"}:
        fail("activation journal prior service state is invalid")
    new_active = parse_active(decoded["new_active"], args)
    new_rollback = parse_rollback(decoded["new_rollback"], args)
    if decoded["prior_active"] is not None:
        parse_active(decoded["prior_active"], args)
    if decoded["prior_rollback"] is not None:
        parse_rollback(decoded["prior_rollback"], args)
    prior_config, _prior_cert, _prior_key = parse_zot_config(decoded["prior_zot_config"])
    del prior_config
    _target_config, target_cert, target_key = parse_zot_config(decoded["target_zot_config"])
    if (
        new_active["request_id"] != record["request_id"]
        or new_active["artifact_manifest_sha256"] != record["artifact_manifest_sha256"]
        or new_active["version_path"] != record["target_version_path"]
        or new_active["version_device"] != record["target_version_device"]
        or new_active["version_inode"] != record["target_version_inode"]
        or new_active["response_sha256"] != record["target_response_sha256"]
        or new_active["response_signature_sha256"] != record["target_response_signature_sha256"]
        or new_active["certificate_sha256"] != record["target_certificate_sha256"]
        or new_active["certificate_spki_sha256"] != record["target_certificate_spki_sha256"]
        or new_active["chain_sha256"] != record["target_chain_sha256"]
        or new_active["fullchain_sha256"] != record["target_fullchain_sha256"]
        or new_active["activation_epoch"] != record["created_epoch"]
        or new_active["rollback_deadline_epoch"] != record["rollback_deadline_epoch"]
        or new_rollback["activating_request_id"] != record["request_id"]
        or new_rollback["activating_artifact_manifest_sha256"] != record["artifact_manifest_sha256"]
        or new_rollback["activation_epoch"] != record["created_epoch"]
        or new_rollback["rollback_deadline_epoch"] != record["rollback_deadline_epoch"]
        or target_cert != os.path.join(record["target_version_path"], "fullchain.crt")
        or target_key != os.path.join(record["target_version_path"], "tls.key")
    ):
        fail("activation journal cross-binding is invalid")
    return record


def set_journal_checkpoint(
    state: PinnedDirectory,
    journal_data: bytes,
    journal_identity: tuple[int, ...],
    checkpoint: str,
    args,
) -> tuple[bytes, tuple[int, ...]]:
    values = journal_record(journal_data, args)
    values["checkpoint"] = checkpoint
    updated = serialize_record(ACTIVATION_JOURNAL_FIELDS, values, "activation journal")
    atomic_replace_at(state, "activation-journal", updated, "activation journal", expected=journal_identity)
    return read_at(state, "activation-journal", "activation journal")


def replace_state_bytes(state: PinnedDirectory, name: str, prior: bytes | None, target: bytes | None, label: str) -> None:
    current, identity = read_optional_state(state, name)
    if current == target:
        return
    if current != prior:
        fail(f"{label} identity no longer matches the journal")
    if target is None:
        assert identity is not None
        require_snapshot(state, name, identity, label)
        os.unlink(name, dir_fd=state.fd)
        os.fsync(state.fd)
    else:
        atomic_replace_at(state, name, target, label, expected=identity)


def replace_config_bytes(path: str, prior: bytes, target: bytes) -> None:
    parent = PinnedDirectory.open(os.path.dirname(path), "Zot configuration parent", private=False)
    try:
        current, identity = read_at(parent, os.path.basename(path), "Zot configuration", mode=0o644)
        if current == target:
            return
        if current != prior:
            fail("Zot configuration identity no longer matches the journal")
        atomic_replace_at(parent, os.path.basename(path), target, "Zot configuration", mode=0o644, expected=identity)
    finally:
        parent.close()


def restore_from_journal(state: PinnedDirectory, data: bytes, identity: tuple[int, ...], args, *, remove: bool = True) -> str:
    record = journal_record(data, args)
    prior_active = decode_bound_bytes(record["prior_active_b64"], record["prior_active_sha256"], "prior active", allow_none=True)
    new_active = decode_bound_bytes(record["new_active_b64"], record["new_active_sha256"], "new active")
    prior_rollback = decode_bound_bytes(record["prior_rollback_b64"], record["prior_rollback_sha256"], "prior rollback", allow_none=True)
    new_rollback = decode_bound_bytes(record["new_rollback_b64"], record["new_rollback_sha256"], "new rollback")
    prior_config = decode_bound_bytes(record["prior_zot_config_b64"], record["prior_zot_config_sha256"], "prior Zot config")
    target_config = decode_bound_bytes(record["target_zot_config_b64"], record["target_zot_config_sha256"], "target Zot config")
    assert new_active is not None and new_rollback is not None and prior_config is not None and target_config is not None
    current_config, _ = read_path(args.zot_config, "Zot configuration", mode=0o644)
    current_active, _ = read_optional_state(state, "active")
    current_rollback, _ = read_optional_state(state, "rollback")
    if current_config not in {prior_config, target_config}:
        fail("Zot configuration identity no longer matches the journal")
    if current_active not in {prior_active, new_active}:
        fail("active record identity no longer matches the journal")
    if current_rollback not in {prior_rollback, new_rollback}:
        fail("rollback record identity no longer matches the journal")
    replace_config_bytes(args.zot_config, target_config, prior_config)
    replace_state_bytes(state, "active", new_active, prior_active, "active record")
    replace_state_bytes(state, "rollback", new_rollback, prior_rollback, "rollback record")
    rollback = parse_rollback(new_rollback, args)
    predecessor_free = rollback["predecessor_kind"] == "none"
    if record["prior_service_state"] == "active":
        service_action("restart")
    elif predecessor_free:
        service_action("disable-stop")
    else:
        service_action("stop")
    if remove:
        current, current_identity = read_at(state, "activation-journal", "activation journal")
        current_record = journal_record(current, args)
        if current != data and current_record["transaction_id"] != record["transaction_id"]:
            fail("activation journal changed before recovery completion")
        terminal = "not-activated" if predecessor_free else (
            "not-activated"
            if record["checkpoint"] in {"prepared", "records-written", "not-activated"}
            else "rolled-back"
        )
        current_record["checkpoint"] = terminal
        terminal_data = serialize_record(
            ACTIVATION_JOURNAL_FIELDS, current_record, "activation journal"
        )
        atomic_replace_at(
            state, "activation-journal", terminal_data, "activation journal",
            expected=current_identity,
        )
        return terminal
    return record["checkpoint"]


def activation_records(args, validated: Mapping[str, object], version: PinnedDirectory, prior_active: bytes | None, prior_config: bytes, prior_cert: str, prior_key: str, created: int, deadline: int, target_config: bytes) -> tuple[bytes, bytes]:
    metadata = os.fstat(version.fd)
    active_values = {
        "schema": "2", "kind": "host-local-active", "service": args.service,
        "target": args.target, "request_id": args.request_id,
        "artifact_manifest_sha256": args.artifact_sha256,
        "response_sha256": str(validated["response_sha256"]),
        "response_signature_sha256": str(validated["response_signature_sha256"]),
        "certificate_sha256": str(validated["certificate_sha256"]),
        "certificate_spki_sha256": str(validated["certificate_spki_sha256"]),
        "chain_sha256": str(validated["chain_sha256"]),
        "fullchain_sha256": str(validated["fullchain_sha256"]),
        "version_path": version.path, "version_device": str(metadata.st_dev),
        "version_inode": str(metadata.st_ino), "zot_config_sha256": sha256(target_config),
        "activation_epoch": str(created), "rollback_deadline_epoch": str(deadline),
    }
    active_data = serialize_record(ACTIVE_FIELDS, active_values, "active record")
    predecessor = {
        "kind": "none", "request_id": "none", "artifact_manifest_sha256": "none",
        "certificate_sha256": "none", "certificate_spki_sha256": "none",
        "chain_sha256": "none", "fullchain_sha256": "none", "version_path": "none",
        "version_device": "none", "version_inode": "none",
    }
    if prior_active is not None:
        old = parse_active(prior_active, args)
        predecessor.update(
            kind="host-local", request_id=old["request_id"],
            artifact_manifest_sha256=old["artifact_manifest_sha256"],
            certificate_sha256=old["certificate_sha256"],
            certificate_spki_sha256=old["certificate_spki_sha256"],
            chain_sha256=old["chain_sha256"], fullchain_sha256=old["fullchain_sha256"],
            version_path=old["version_path"], version_device=old["version_device"],
            version_inode=old["version_inode"],
        )
    rollback_values = {
        "schema": "2", "kind": "host-local-rollback", "service": args.service,
        "target": args.target, "activating_request_id": args.request_id,
        "activating_artifact_manifest_sha256": args.artifact_sha256,
        "activating_certificate_sha256": str(validated["certificate_sha256"]),
        "activating_version_path": version.path,
        "activating_version_device": str(metadata.st_dev), "activating_version_inode": str(metadata.st_ino),
        "predecessor_kind": predecessor["kind"], "predecessor_request_id": predecessor["request_id"],
        "predecessor_artifact_manifest_sha256": predecessor["artifact_manifest_sha256"],
        "predecessor_certificate_sha256": predecessor["certificate_sha256"],
        "predecessor_certificate_spki_sha256": predecessor["certificate_spki_sha256"],
        "predecessor_chain_sha256": predecessor["chain_sha256"],
        "predecessor_fullchain_sha256": predecessor["fullchain_sha256"],
        "predecessor_version_path": predecessor["version_path"],
        "predecessor_version_device": predecessor["version_device"],
        "predecessor_version_inode": predecessor["version_inode"],
        "prior_zot_cert_path": prior_cert, "prior_zot_key_path": prior_key,
        "prior_zot_config_sha256": sha256(prior_config), "activation_epoch": str(created),
        "rollback_deadline_epoch": str(deadline),
    }
    return active_data, serialize_record(ROLLBACK_FIELDS, rollback_values, "rollback record")


def activate_start(args) -> None:
    state, lock = common_open(args)
    version: PinnedDirectory | None = None
    try:
        entries = state_entries(state)
        if entries & {"activation-journal", "request.journal", "trust-install.journal"}:
            fail("unresolved lifecycle state blocks activation")
        trust, _policy = load_trust(state, args.trust_id, args.target)
        request_id = require_request_id(args.request_id)
        require_digest(args.artifact_sha256, "artifact pin")
        pending = validate_pending(os.path.join(args.pending_root, request_id), trust)
        version, version_files, _ = validate_version(os.path.join(args.versions_root, request_id), request_id)
        response_files = {name: version_files[name] for name in RESPONSE_NAMES}
        validated = validate_response_files(response_files, pending, trust, args)
        if validated["request"]["operation"] != args.operation:
            fail("candidate operation differs from the requested lifecycle operation")
        if pending["record"]["service"] != args.service or pending["record"]["target"] != args.target:
            fail("candidate does not match activation service and target")
        prior_config, prior_config_identity = read_path(args.zot_config, "Zot configuration", mode=0o644)
        config, prior_cert, prior_key = parse_zot_config(prior_config)
        prior_active, _prior_active_identity = read_optional_state(state, "active")
        prior_rollback, _prior_rollback_identity = read_optional_state(state, "rollback")
        if prior_active is not None:
            prior_active_auth = authenticate_active(state, args)
            assert prior_active_auth is not None
            if (
                pending["record"]["current_cert_sha256"]
                != prior_active_auth["record"]["certificate_sha256"]
                or (
                    args.operation == "renew"
                    and pending["record"]["predecessor_request_id"]
                    != prior_active_auth["record"]["request_id"]
                )
            ):
                fail("target-local request does not bind the authenticated predecessor")
            if args.operation == "issue":
                fail("issue activation requires no authenticated active version")
        elif prior_rollback is not None:
            fail("rollback state exists without an authenticated active version")
        prior_state = service_state()
        initial_issue = prior_active is None and args.operation == "issue"
        if initial_issue:
            if prior_state != "inactive" or service_enabled_state() != "masked":
                fail("predecessor-free issue requires masked and inactive Zot")
            if os.path.lexists(prior_cert) or os.path.lexists(prior_key):
                fail("predecessor-free issue requires absent dormant TLS material")
        elif prior_state != "active":
            fail("Zot must be active before certificate activation")
        if prior_active is None and args.operation == "renew":
            fail("renew requires an authenticated active version")
        target_config_value = copy.deepcopy(config)
        target_config_value["http"]["tls"] = {"cert": os.path.join(version.path, "fullchain.crt"), "key": os.path.join(version.path, "tls.key")}
        target_config = canonical_json(target_config_value)
        created = int(time.time())
        deadline = created + args.rollback_seconds
        active_data, rollback_data = activation_records(args, validated, version, prior_active, prior_config, prior_cert, prior_key, created, deadline, target_config)
        if args.check:
            json_output({"status": "would-activate", "request_id": request_id, "artifact_sha256": args.artifact_sha256, "certificate_sha256": validated["certificate_sha256"], "activation_epoch": created, "rollback_deadline_epoch": deadline})
            return
        values = {
            "schema": "2", "kind": "host-local-activation", "transaction_id": secrets.token_hex(16),
            "service": args.service, "target": args.target, "request_id": request_id,
            "artifact_manifest_sha256": args.artifact_sha256, "checkpoint": "prepared",
            "recovery_action": "restore-prior", "target_version_path": version.path,
            "target_version_device": str(os.fstat(version.fd).st_dev), "target_version_inode": str(os.fstat(version.fd).st_ino),
            "target_response_sha256": str(validated["response_sha256"]),
            "target_response_signature_sha256": str(validated["response_signature_sha256"]),
            "target_certificate_sha256": str(validated["certificate_sha256"]),
            "target_certificate_spki_sha256": str(validated["certificate_spki_sha256"]),
            "target_chain_sha256": str(validated["chain_sha256"]),
            "target_fullchain_sha256": str(validated["fullchain_sha256"]),
            "prior_active_b64": b64_value(prior_active), "prior_active_sha256": b64_digest(prior_active),
            "new_active_b64": b64_value(active_data), "new_active_sha256": sha256(active_data),
            "prior_rollback_b64": b64_value(prior_rollback), "prior_rollback_sha256": b64_digest(prior_rollback),
            "new_rollback_b64": b64_value(rollback_data), "new_rollback_sha256": sha256(rollback_data),
            "prior_zot_config_b64": b64_value(prior_config), "prior_zot_config_sha256": sha256(prior_config),
            "target_zot_config_b64": b64_value(target_config), "target_zot_config_sha256": sha256(target_config),
            "prior_service_state": prior_state, "created_epoch": str(created), "rollback_deadline_epoch": str(deadline),
        }
        journal_data = serialize_record(ACTIVATION_JOURNAL_FIELDS, values, "activation journal")
        journal_identity = write_new_at(state, "activation-journal", journal_data, "activation journal")
        os.fsync(state.fd)
        fault("after-activation-journal")
        try:
            replace_state_bytes(state, "active", prior_active, active_data, "active record")
            replace_state_bytes(state, "rollback", prior_rollback, rollback_data, "rollback record")
            journal_data, journal_identity = set_journal_checkpoint(state, journal_data, journal_identity, "records-written", args)
            fault("after-active-records")
            replace_config_bytes(args.zot_config, prior_config, target_config)
            journal_data, journal_identity = set_journal_checkpoint(state, journal_data, journal_identity, "config-written", args)
            fault("after-config")
            service_action("enable-start" if initial_issue else "restart")
            journal_data, journal_identity = set_journal_checkpoint(state, journal_data, journal_identity, "restarted", args)
            fault("after-restart")
            local = strict_local_validation(args, str(validated["certificate_sha256"]), str(validated["intermediate_sha256"]))
            if int(time.time()) > created + 300:
                fail("local validation exceeded the activation ordering window")
            authenticate_active(state, args)
            journal_data, journal_identity = set_journal_checkpoint(state, journal_data, journal_identity, "local-validated", args)
            fault("after-local-validation")
        except Exception:
            try:
                current, current_identity = read_at(state, "activation-journal", "activation journal")
                restore_from_journal(state, current, current_identity, args)
            except Exception:
                pass
            raise
        json_output({"status": "local-validated", "request_id": request_id, "artifact_sha256": args.artifact_sha256, "certificate_sha256": validated["certificate_sha256"], "served_certificate_sha256": local["served_certificate_sha256"], "served_intermediate_sha256": local["served_intermediate_sha256"], "activation_epoch": created, "rollback_deadline_epoch": deadline})
    finally:
        if version is not None:
            version.close()
        os.close(lock)
        state.close()


def active_paths(args) -> None:
    state, lock = common_open(args, shared=True)
    try:
        if state_entries(state) & {"activation-journal", "request.journal", "trust-install.journal"}:
            fail("unresolved lifecycle state blocks active path selection")
        authenticated = authenticate_active(state, args)
        if authenticated is None:
