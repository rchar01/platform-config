        active = authenticated["record"]
        json_output({
            "request_id": active["request_id"], "cert_path": os.path.join(active["version_path"], "fullchain.crt"),
            "key_path": os.path.join(active["version_path"], "tls.key"),
            "artifact_sha256": active["artifact_manifest_sha256"], "certificate_sha256": active["certificate_sha256"],
            "spki_sha256": active["certificate_spki_sha256"], "chain_sha256": active["chain_sha256"],
            "fullchain_sha256": active["fullchain_sha256"], "zot_config_sha256": active["zot_config_sha256"],
        })
    finally:
        os.close(lock)
        state.close()


def zot_custody(args) -> None:
    state, lock = common_open(args, shared=True)
    try:
        entries = state_entries(state)
        unresolved = entries & {
            "activation-journal", "request.journal", "trust-install.journal",
        }
        if unresolved:
            fail("unresolved lifecycle state blocks Zot TLS custody selection")

        authenticated = authenticate_active(state, args)
        if authenticated is None:
            if "rollback" in entries:
                fail("rollback state exists without an authenticated active version")
            config_data, _ = read_path(
                args.zot_config, "managed Zot configuration", mode=0o644
            )
            _config, cert_path, key_path = parse_zot_config(config_data)
            if (
                cert_path != args.managed_cert
                or key_path != args.managed_key
                or sha256(config_data) != args.managed_config_sha256
            ):
                fail("current Zot configuration is not the exact managed configuration")
            if args.operation == "renew":
                fail("renew requires an authenticated active version")
            custody = "dormant" if args.operation == "issue" else "managed"
            if custody == "dormant" and (
                os.path.lexists(args.managed_cert) or os.path.lexists(args.managed_key)
            ):
                fail("dormant Zot TLS destination material must be absent")
            json_output({
                "schema": "2",
                "kind": "platform-config-zot-tls-custody",
                "custody": custody,
                "request_id": "none",
                "cert_path": args.managed_cert,
                "key_path": args.managed_key,
                "artifact_sha256": "none",
                "certificate_sha256": "none",
                "spki_sha256": "none",
                "chain_sha256": "none",
                "fullchain_sha256": "none",
                "zot_config_sha256": args.managed_config_sha256,
            })
            return

        active = authenticated["record"]
        rollback_data, _ = read_optional_state(state, "rollback")
        if rollback_data is None:
            fail("authenticated active state lacks its rollback record")
        rollback = parse_rollback(rollback_data, args)
        if (
            rollback["activating_request_id"] != active["request_id"]
            or rollback["activating_artifact_manifest_sha256"]
            != active["artifact_manifest_sha256"]
            or rollback["activating_certificate_sha256"]
            != active["certificate_sha256"]
            or rollback["activating_version_path"] != active["version_path"]
            or rollback["activating_version_device"] != active["version_device"]
            or rollback["activating_version_inode"] != active["version_inode"]
            or rollback["activation_epoch"] != active["activation_epoch"]
            or rollback["rollback_deadline_epoch"]
            != active["rollback_deadline_epoch"]
        ):
            fail("active and rollback records do not bind one activation")
        json_output({
            "schema": "2",
            "kind": "platform-config-zot-tls-custody",
            "custody": "host-local",
            "request_id": active["request_id"],
            "cert_path": os.path.join(active["version_path"], "fullchain.crt"),
            "key_path": os.path.join(active["version_path"], "tls.key"),
            "artifact_sha256": active["artifact_manifest_sha256"],
            "certificate_sha256": active["certificate_sha256"],
            "spki_sha256": active["certificate_spki_sha256"],
            "chain_sha256": active["chain_sha256"],
            "fullchain_sha256": active["fullchain_sha256"],
            "zot_config_sha256": active["zot_config_sha256"],
        })
    finally:
        os.close(lock)
        state.close()


def target_terminal_history(
    state: PinnedDirectory, args
) -> dict[str, tuple[bytes, dict[str, str]]]:
    if "target-terminal-history" not in scan(state, "state root"):
        return {}
    history = PinnedDirectory.open(
        os.path.join(args.state_root, "target-terminal-history"),
        "target-local terminal history",
    )
    result: dict[str, tuple[bytes, dict[str, str]]] = {}
    try:
        for request_id, metadata in scan(
            history, "target-local terminal history"
        ).items():
            if (
                REQUEST_ID_RE.fullmatch(request_id) is None
                or not stat.S_ISREG(metadata.st_mode)
            ):
                fail("target-local terminal history contains an invalid entry")
            data, _identity = read_at(
                history, request_id, "target-local terminal history record"
            )
            terminal = parse_target_terminal(data, args)
            if terminal["request_id"] != request_id:
                fail("target-local terminal history identity is invalid")
            result[request_id] = (data, terminal)
        return result
    finally:
        history.close()


def target_excluded_request_ids(args) -> set[str]:
    state = PinnedDirectory.open(args.state_root, "state root")
    try:
        excluded = set(target_terminal_history(state, args))
        terminal_data, _identity = read_optional_state(state, "target-terminal")
        if terminal_data is not None:
            excluded.add(parse_target_terminal(terminal_data, args)["request_id"])
        return excluded
    finally:
        state.close()


def target_pending_request_ids(args, excluded: set[str] | None = None) -> tuple[str, ...]:
    excluded_ids = target_excluded_request_ids(args) if excluded is None else excluded
    root = PinnedDirectory.open(args.pending_root, "target-local pending root")
    try:
        entries = scan(root, "target-local pending root")
        for request_id, metadata in entries.items():
            if REQUEST_ID_RE.fullmatch(request_id) is None or not stat.S_ISDIR(metadata.st_mode):
                fail("target-local pending request entry is invalid")
        return tuple(sorted(set(entries) - excluded_ids))
    finally:
        root.close()


def target_pending_request_id(args) -> str:
    request_ids = target_pending_request_ids(args)
    if len(request_ids) != 1:
        fail("target-local operation requires exactly one nonterminal pending request")
    return request_ids[0]


def target_artifact_digest(args, request_id: str, *, ingress: bool) -> str:
    name = f".ingress-{request_id}" if ingress else request_id
    directory = PinnedDirectory.open(
        os.path.join(args.versions_root, name),
        "target-local response ingress" if ingress else "target-local immutable version",
    )
    try:
        artifact, _ = read_at(directory, "artifact", "target-local artifact")
        return sha256(artifact)
    finally:
        directory.close()


def target_request_export(args) -> None:
