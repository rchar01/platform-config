global:
  scrape_interval: {{ monitoring_stack_prometheus_scrape_interval }}
  evaluation_interval: {{ monitoring_stack_prometheus_evaluation_interval }}

scrape_configs:
  - job_name: {{ monitoring_stack_prometheus_node_exporter_job_name | to_json }}
    static_configs:
{% for target in monitoring_stack_prometheus_targets %}
      - targets:
          - {{ (target.target | default(target)) | to_json }}
{% if target is mapping %}
        labels:
{% for label_key, label_value in (target.labels | default({})).items() %}
          {{ label_key }}: {{ label_value | to_json }}
{% endfor %}
{% if target.vm_name is defined %}
          vm_name: {{ target.vm_name | to_json }}
{% endif %}
{% if target.ip is defined %}
          ip: {{ target.ip | to_json }}
{% endif %}
{% if target.platform_role is defined %}
          platform_role: {{ target.platform_role | to_json }}
{% endif %}
{% if target.environment is defined %}
          environment: {{ target.environment | to_json }}
{% endif %}
{% endif %}
{% endfor %}
