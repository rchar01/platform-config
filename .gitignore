*.vault
.vault_pass
.vault-pass
secrets.yml
secret.yml
private.yml
*.private.yml
*.secret.yml
*.ansible.env
**/access-policy.yaml

# Private working plans
docs/*-plan.md

# Kubeconfigs and certificate material
*kubeconfig*
*.kubeconfig
*.pem
*.key
*.crt
*.p12
*.pfx

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
