# Local/private inventory copies
inventories/**/hosts.yml
inventories/**/hosts.yaml
inventories/**/group_vars/*.yml
inventories/**/group_vars/*.yaml
inventories/**/host_vars/*.yml
inventories/**/host_vars/*.yaml

# Keep public examples
!inventories/**/*.example
!inventories/**/README.md

# Ansible runtime
*.retry
.ansible/
ansible.log
.artifacts/

# Python
__pycache__/
*.pyc
.venv/
venv/

