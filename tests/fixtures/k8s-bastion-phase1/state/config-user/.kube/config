---
apiVersion: v1
kind: Config
clusters:
  - name: fixture-cluster
    cluster:
      server: https://api.example.invalid:6443
      certificate-authority: /nonexistent/fixture-ca.crt
contexts:
  - name: fixture
    context:
      cluster: fixture-cluster
      user: config-user
current-context: fixture
users:
  - name: config-user
    user:
      client-certificate: /nonexistent/config-user.crt
      client-key: /nonexistent/config-user.key
