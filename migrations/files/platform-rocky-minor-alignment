class AlignmentError(RuntimeError):
    pass


def transition(name: str) -> dict[str, Any]:
    try:
        return TRANSITIONS[name]
    except KeyError as error:
        raise AlignmentError(f"unsupported Rocky transition: {name}") from error


def canonical_json(value: Any) -> bytes:
    return (json.dumps(value, ensure_ascii=True, separators=(",", ":"), sort_keys=True) + "\n").encode()


def sha256_bytes(value: bytes) -> str:
    return hashlib.sha256(value).hexdigest()


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def installed_state() -> tuple[list[str], str]:
    result = subprocess.run(
        [
            "rpm",
            "-qa",
            "--qf",
            "%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\\n",
        ],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
        env={**os.environ, "LC_ALL": "C"},
    )
    rows = sorted(result.stdout.splitlines())
    payload = ("\n".join(rows) + "\n").encode()
    return rows, sha256_bytes(payload)


def decode_policy(value: str) -> dict[str, dict[str, Any]]:
    try:
        policy = json.loads(base64.b64decode(value, validate=True))
    except (ValueError, json.JSONDecodeError) as error:
        raise AlignmentError("repository policy is not valid base64 JSON") from error
    if not isinstance(policy, dict) or not policy:
        raise AlignmentError("repository policy must be a nonempty object")
    for repo_id, expected in policy.items():
        if not re.fullmatch(r"[a-z0-9][a-z0-9_-]*", repo_id):
            raise AlignmentError("repository policy contains an invalid ID")
        if set(expected) != {"baseurl", "gpgcheck", "gpgkey", "metalink", "mirrorlist", "repo_gpgcheck"}:
            raise AlignmentError(f"repository policy fields are invalid for {repo_id}")
        for key in ("baseurl", "gpgkey"):
            if not isinstance(expected[key], list) or not all(isinstance(item, str) for item in expected[key]):
                raise AlignmentError(f"repository policy {key} is invalid for {repo_id}")
        for key in ("metalink", "mirrorlist"):
            if expected[key] is not None and not isinstance(expected[key], str):
                raise AlignmentError(f"repository policy {key} is invalid for {repo_id}")
        for key in ("gpgcheck", "repo_gpgcheck"):
            if not isinstance(expected[key], bool):
                raise AlignmentError(f"repository policy {key} is invalid for {repo_id}")
    return policy


def repo_record(repo: Any) -> dict[str, Any]:
    return {
        "baseurl": sorted(str(value) for value in repo.baseurl),
        "gpgcheck": bool(repo.gpgcheck),
        "gpgkey": sorted(str(value) for value in repo.gpgkey),
        "metalink": str(repo.metalink) if repo.metalink else None,
        "mirrorlist": str(repo.mirrorlist) if repo.mirrorlist else None,
        "repo_gpgcheck": bool(repo.repo_gpgcheck),
    }


def validate_repository_url(
    repo_id: str, key: str, value: str, profile: dict[str, Any]
) -> None:
    if any(character.isspace() or ord(character) < 32 or ord(character) == 127 for character in value):
        raise AlignmentError(f"repository {repo_id} has an unapproved {key} origin")
    try:
        parsed = urllib.parse.urlsplit(value)
        parsed.port
    except ValueError as error:
        raise AlignmentError(
            f"repository {repo_id} has an unapproved {key} origin"
        ) from error
    if (
        parsed.scheme != "https"
        or not parsed.hostname
        or parsed.fragment
        or parsed.username is not None
        or parsed.password is not None
    ):
        raise AlignmentError(f"repository {repo_id} has an unapproved {key} origin")
    if profile["repository_origins"] == "official" and parsed.hostname not in {
        "dl.rockylinux.org",
        "mirrors.rockylinux.org",
    }:
        raise AlignmentError(f"repository {repo_id} has an unapproved {key} origin")


def validate_repositories(
    base: Any,
    policy: dict[str, dict[str, Any]],
    profile: dict[str, Any] | None = None,
) -> dict[str, dict[str, Any]]:
    if profile is None:
        profile = transition(DEFAULT_TRANSITION)
    actual = {repo.id: repo_record(repo) for repo in base.repos.values() if repo.enabled}
    if actual != policy:
        raise AlignmentError("enabled repository identities or origins differ from the reviewed policy")
    for repo_id, record in actual.items():
        package_origins = canonical_json(
            {
                "baseurl": record["baseurl"],
                "metalink": record["metalink"],
                "mirrorlist": record["mirrorlist"],
                "repo_id": repo_id,
            }
        ).decode().lower()
        if re.search(r"vault|\bptb-|file:|localhost|127\.0\.0\.1|testing|devel", package_origins):
            raise AlignmentError(f"repository {repo_id} uses a prohibited origin")
        if not record["gpgcheck"]:
            raise AlignmentError(f"repository {repo_id} must enforce package signatures")
        if set(record["gpgkey"]) != {"file:///etc/pki/rpm-gpg/RPM-GPG-KEY-Rocky-10"}:
            raise AlignmentError(f"repository {repo_id} must use the qualified Rocky 10 signing key")
        for key in ("baseurl", "metalink", "mirrorlist"):
            values = record[key] if isinstance(record[key], list) else [record[key]]
            for value in values:
                if not value:
                    continue
                validate_repository_url(repo_id, key, value, profile)
    return actual


def validate_signing_key(
    profile: dict[str, Any], path: pathlib.Path = SIGNING_KEY_PATH
) -> None:
    expected_digest = profile["signing_key_sha256"]
    if expected_digest is None:
        return
    key_stat = path.lstat()
    if (
        not stat.S_ISREG(key_stat.st_mode)
        or path.is_symlink()
        or key_stat.st_uid != 0
        or key_stat.st_gid != 0
        or key_stat.st_mode & 0o022
    ):
        raise AlignmentError("Rocky signing key ownership or mode is invalid")
    if sha256_file(path) != expected_digest:
        raise AlignmentError("Rocky signing key digest differs from the qualified key")


def qualified_dnf_packages(
    current_release: str, profile: dict[str, Any]
) -> frozenset[str]:
    result = subprocess.run(
        [
            "rpm",
            "-q",
            "--qf",
            "%{NAME}-%{EPOCHNUM}:%{VERSION}-%{RELEASE}.%{ARCH}\n",
            "dnf",
            "python3-dnf",
            "libdnf",
        ],
        check=True,
        stdout=subprocess.PIPE,
        text=True,
        env={**os.environ, "LC_ALL": "C"},
    )
    rows = result.stdout.splitlines()
    packages = frozenset(rows)
    if len(rows) != 3 or len(packages) != 3:
        raise AlignmentError("qualified DNF packages must have exactly one installed build each")
    qualification = DNF_QUALIFICATIONS.get(packages)
    if qualification is None:
        raise AlignmentError("DNF package builds differ from the qualified Rocky builds")
    allowed_package_releases = {current_release}
    if current_release == profile["target"]:
        allowed_package_releases.add(profile["source"])
    if qualification["releases"].isdisjoint(allowed_package_releases):
        raise AlignmentError("DNF package builds do not match the current Rocky release")
    return packages


def load_dnf(
    current_release: str, profile: dict[str, Any]
) -> tuple[Any, Any]:
    try:
        import dnf
        import dnf.lock
        import dnf.transaction
    except ImportError as error:
        raise AlignmentError("DNF Python bindings are unavailable") from error
    packages = qualified_dnf_packages(current_release, profile)
    qualification = DNF_QUALIFICATIONS[packages]
    if dnf.VERSION != qualification["dnf_version"]:
        raise AlignmentError(f"unsupported DNF version: {dnf.VERSION}")
    source_digest = sha256_bytes(inspect.getsource(dnf.Base.do_transaction).encode())
    if source_digest != qualification["do_transaction_sha256"]:
        raise AlignmentError("DNF transaction implementation differs from the qualified Rocky build")
    return dnf, dnf.transaction


def configure_base(
    dnf: Any,
    policy: dict[str, dict[str, Any]],
    profile: dict[str, Any],
    *,
    available: bool,
) -> Any:
    base = dnf.Base()
    base.conf.read()
    base.conf.substitutions.update_from_etc("/etc/dnf/vars", "/etc/yum/vars")
    # Rocky's supported repository stream is keyed by major release. Load its
    # auxiliary substitutions first, then resolve against the major stream.
    base.conf.releasever = TARGET_MAJOR_VERSION
    base.conf.assumeyes = True
    base.conf.best = True
    base.conf.exit_on_lock = True
    base.read_all_repos()
    for repo in base.repos.values():
        if repo.id in policy:
            repo.enable()
            repo.metadata_expire = 0
        else:
            repo.disable()
    validate_repositories(base, policy, profile)
    try:
        base.fill_sack(load_system_repo=True, load_available_repos=available)
    except Exception as error:
        base.close()
        raise AlignmentError("DNF repository metadata loading failed") from error
    return base


def action_map(transaction_module: Any) -> dict[int, str]:
    return {
        transaction_module.PKG_INSTALL: "install",
        transaction_module.PKG_UPGRADE: "upgrade-in",
        transaction_module.PKG_UPGRADED: "upgrade-out",
        transaction_module.PKG_DOWNGRADE: "downgrade-in",
        transaction_module.PKG_DOWNGRADED: "downgrade-out",
        transaction_module.PKG_OBSOLETE: "obsolete-in",
        transaction_module.PKG_OBSOLETED: "obsolete-out",
        transaction_module.PKG_REMOVE: "erase",
        transaction_module.PKG_REINSTALL: "reinstall-in",
        transaction_module.PKG_REINSTALLED: "reinstall-out",
    }


def transaction_rows(transaction: Any, transaction_module: Any) -> list[dict[str, str]]:
    names = action_map(transaction_module)
    rows = []
    for item in transaction:
        if item.action not in names:
            raise AlignmentError(f"unsupported DNF transaction action: {item.action}")
        rows.append(
            {
                "action": names[item.action],
                "name": item.name,
                "nevra": item.nevra,
                "repo": item.from_repo or "",
                "version": item.version,
            }
        )
    rows.sort(key=lambda row: (row["action"], row["nevra"], row["repo"]))
    prohibited = {"downgrade-in", "downgrade-out", "erase", "obsolete-in", "obsolete-out", "reinstall-in", "reinstall-out"}
    found = sorted({row["action"] for row in rows} & prohibited)
    if found:
        raise AlignmentError(f"transaction contains prohibited actions: {', '.join(found)}")
    return rows


def require_target_release(rows: list[dict[str, str]], target: str) -> None:
    incoming = [
        row
        for row in rows
        if row["name"] == "rocky-release"
        and row["action"] in {"install", "upgrade-in"}
    ]
    if len(incoming) != 1 or incoming[0]["version"] != target:
        raise AlignmentError(f"transaction does not contain exactly Rocky release {target}")


def resolve_upgrade(
    dnf: Any,
    transaction_module: Any,
    policy: dict[str, dict[str, Any]],
    profile: dict[str, Any],
    *,
    require_changes: bool,
    target: str,
) -> tuple[Any, list[dict[str, str]]]:
    base = configure_base(dnf, policy, profile, available=True)
    base.upgrade_all()
    if not base.resolve(allow_erasing=False):
        if require_changes:
            base.close()
            raise AlignmentError("target-release transaction is empty")
        return base, []
    rows = transaction_rows(base.transaction, transaction_module)
    if require_changes:
        require_target_release(rows, target)
    return base, rows


def payload_record(base: Any, package: Any, destination: pathlib.Path) -> dict[str, Any]:
    signature_result, signature_error = base.package_signature_check(package)
    if signature_result != 0:
        raise AlignmentError(f"RPM signature validation failed for {package}: {signature_error}")
    source = pathlib.Path(package.localPkg())
    filename = source.name
    if not re.fullmatch(r"[A-Za-z0-9_.+~^-]+\.rpm", filename):
        raise AlignmentError(f"unsafe RPM filename: {filename}")
    target = destination / filename
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with source.open("rb") as input_stream, os.fdopen(fd, "wb", closefd=False) as output_stream:
            shutil.copyfileobj(input_stream, output_stream)
            output_stream.flush()
            os.fsync(output_stream.fileno())
    finally:
        os.close(fd)
    return {
        "filename": filename,
        "nevra": str(package),
        "sha256": sha256_file(target),
        "size": target.stat().st_size,
    }


def require_safe_parent(path: pathlib.Path) -> None:
    current = pathlib.Path("/")
    for component in path.absolute().parts[1:]:
        current /= component
        if not current.exists():
            raise AlignmentError(f"required root state parent does not exist: {current}")
        stat = current.lstat()
        if current.is_symlink() or stat.st_uid != 0 or stat.st_mode & 0o022:
            raise AlignmentError(f"unsafe root state path: {current}")


def create_staging(path: pathlib.Path) -> pathlib.Path:
    require_safe_parent(path.parent)
    try:
        path.mkdir(mode=0o700)
    except FileExistsError as error:
        raise AlignmentError("transaction staging path already exists") from error
    stat = path.lstat()
    if not path.is_dir() or path.is_symlink() or stat.st_uid != 0 or stat.st_mode & 0o077:
        raise AlignmentError("transaction staging path is unsafe")
    rpms = path / "rpms"
    rpms.mkdir(mode=0o700)
    return rpms


def require_download_capacity(base: Any, packages: Any, staging: pathlib.Path) -> int:
    sizes = [int(getattr(package, "downloadsize", 0)) for package in packages]
    if not sizes or any(size <= 0 for size in sizes):
        raise AlignmentError("DNF transaction download sizes are unavailable")
    download_size = sum(sizes)
    cache = pathlib.Path(base.conf.cachedir)
    cache.mkdir(parents=True, exist_ok=True)
    locations = {
        cache.stat().st_dev: {"path": cache, "required": download_size},
    }
    staging_device = staging.stat().st_dev
    if staging_device in locations:
        locations[staging_device]["required"] += download_size
    else:
        locations[staging_device] = {"path": staging, "required": download_size}
    for location in locations.values():
        filesystem = os.statvfs(location["path"])
        available = filesystem.f_bavail * filesystem.f_frsize
        if available < location["required"] + DOWNLOAD_FREE_MARGIN:
            raise AlignmentError(
                f"insufficient free space before transaction download: {location['path']}"
            )
    return download_size


def validate_staging(path: pathlib.Path) -> None:
    require_safe_parent(path.parent)
    for directory in (path, path / "rpms"):
        stat = directory.lstat()
        if (
            not directory.is_dir()
            or directory.is_symlink()
            or stat.st_uid != 0
            or stat.st_gid != 0
            or stat.st_mode & 0o077
        ):
            raise AlignmentError(f"transaction staging directory is unsafe: {directory}")


def write_exclusive(path: pathlib.Path, payload: bytes, mode: int) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        os.write(fd, payload)
        os.fsync(fd)
    finally:
        os.close(fd)
    directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def load_manifest(staging: pathlib.Path, expected_digest: str) -> dict[str, Any]:
    validate_staging(staging)
    path = staging / "manifest.json"
    if path.is_symlink() or not path.is_file():
        raise AlignmentError("transaction manifest is missing or unsafe")
    payload = path.read_bytes()
    if sha256_bytes(payload) != expected_digest:
        raise AlignmentError("transaction manifest digest changed")
    try:
        manifest = json.loads(payload)
    except json.JSONDecodeError as error:
        raise AlignmentError("transaction manifest is invalid") from error
    if canonical_json(manifest) != payload:
        raise AlignmentError("transaction manifest is not canonical JSON")
    return manifest


def validate_manifest_identity(
    manifest: dict[str, Any], profile: dict[str, Any]
) -> None:
    if (
        not isinstance(manifest, dict)
        or set(manifest) != MANIFEST_FIELDS
        or manifest.get("schema") != 1
    ):
        raise AlignmentError("transaction manifest schema is invalid")
    expected = {
        "dnf_version": DNF_VERSION,
        "migration_id": profile["migration_id"],
        "source": profile["source"],
        "target": profile["target"],
    }
    if any(manifest.get(key) != value for key, value in expected.items()):
        raise AlignmentError("transaction manifest transition identity is invalid")
    if not re.fullmatch(r"[0-9a-f]{64}", manifest.get("installed_state_sha256", "")):
        raise AlignmentError("transaction manifest installed-state digest is invalid")
    if not isinstance(manifest.get("repositories"), dict):
        raise AlignmentError("transaction manifest repository policy is invalid")
    if not isinstance(manifest.get("payloads"), list) or not isinstance(
        manifest.get("transaction"), list
    ):
        raise AlignmentError("transaction manifest payload or action set is invalid")
    for field in ("download_size", "install_size"):
        if not isinstance(manifest.get(field), int) or manifest[field] < 0:
            raise AlignmentError(f"transaction manifest {field} is invalid")
    for row in manifest["transaction"]:
        if not isinstance(row, dict) or set(row) != {
            "action",
            "name",
            "nevra",
            "repo",
            "version",
        } or not all(isinstance(value, str) for value in row.values()):
            raise AlignmentError("transaction manifest action set is invalid")


def verify_payloads(staging: pathlib.Path, payloads: list[dict[str, Any]]) -> list[pathlib.Path]:
    paths = []
    for record in payloads:
        if not isinstance(record, dict) or set(record) != {
            "filename",
            "nevra",
            "sha256",
            "size",
        }:
            raise AlignmentError("RPM payload manifest fields are invalid")
        filename = record["filename"]
        if not isinstance(filename, str) or not re.fullmatch(r"[A-Za-z0-9_.+~^-]+\.rpm", filename):
            raise AlignmentError("RPM payload filename is invalid")
        path = staging / "rpms" / filename
        if path.is_symlink() or not path.is_file():
            raise AlignmentError(f"RPM payload is missing or unsafe: {filename}")
        if path.stat().st_size != record["size"] or sha256_file(path) != record["sha256"]:
            raise AlignmentError(f"RPM payload changed: {filename}")
        paths.append(path)
    return paths


def local_transaction(dnf: Any, transaction_module: Any, paths: list[pathlib.Path]) -> tuple[Any, list[dict[str, str]]]:
    base = dnf.Base()
    base.conf.read()
    base.conf.assumeyes = True
    base.conf.best = True
    base.conf.exit_on_lock = True
    base.fill_sack(load_system_repo=True, load_available_repos=False)
    packages = base.add_remote_rpms([str(path) for path in paths], strict=True)
    installed = base.sack.query().installed()
    for package in packages:
        matches = installed.filter(name=package.name, arch=[package.arch, "noarch"])
        if list(matches):
            base.package_upgrade(package)
        else:
            base.package_install(package, strict=True)
    if not base.resolve(allow_erasing=False):
        base.close()
        raise AlignmentError("local-only transaction is empty")
    rows = transaction_rows(base.transaction, transaction_module)
    for row in rows:
        if row["action"].endswith("-in") or row["action"] == "install":
            row["repo"] = "@approved-local"
        elif row["repo"] == "@System":
            row["repo"] = "@System"
    return base, rows


@contextlib.contextmanager
def qualified_rpmdb_lock(dnf: Any, base: Any) -> Iterator[None]:
    lock = dnf.lock.build_rpmdb_lock(base.conf.persistdir, True)
    original = dnf.lock.build_rpmdb_lock
    with lock:
        dnf.lock.build_rpmdb_lock = lambda persistdir, exit_on_lock: lock
        try:
            yield
        finally:
            dnf.lock.build_rpmdb_lock = original


def command_inspect(args: argparse.Namespace) -> dict[str, Any]:
    profile = transition(args.transition)
    policy = decode_policy(args.policy_b64)
    validate_signing_key(profile)
    current_release = os_release_version(profile)
    dnf, transaction_module = load_dnf(current_release, profile)
    base, rows = resolve_upgrade(
        dnf,
        transaction_module,
        policy,
        profile,
        require_changes=current_release == profile["source"],
        target=profile["target"],
    )
    try:
        _, installed_digest = installed_state()
        return {
            "installed_state_sha256": installed_digest,
            "repositories": validate_repositories(base, policy, profile),
            "transaction": rows,
            "transaction_sha256": sha256_bytes(canonical_json(rows)),
        }
    finally:
        base.close()


def command_prepare(args: argparse.Namespace) -> dict[str, Any]:
    profile = transition(args.transition)
    policy = decode_policy(args.policy_b64)
    validate_signing_key(profile)
    current_release = os_release_version(profile)
    if current_release != profile["source"]:
        raise AlignmentError(
            f"transaction preparation requires Rocky Linux {profile['source']}"
        )
    dnf, transaction_module = load_dnf(current_release, profile)
    staging = pathlib.Path(args.staging)
    rpms = create_staging(staging)
    try:
        base, rows = resolve_upgrade(
            dnf,
            transaction_module,
            policy,
            profile,
            require_changes=True,
            target=profile["target"],
        )
        try:
            expected_download_size = require_download_capacity(
                base, base.transaction.install_set, staging
            )
            base.download_packages(base.transaction.install_set)
            payloads = [payload_record(base, package, rpms) for package in sorted(base.transaction.install_set, key=str)]
            actual_download_size = sum(record["size"] for record in payloads)
            if actual_download_size > expected_download_size:
                raise AlignmentError("downloaded RPM size exceeds the preflight capacity bound")
            _, installed_digest = installed_state()
            manifest = {
                "download_size": actual_download_size,
                "dnf_version": DNF_VERSION,
                "install_size": sum(int(getattr(package, "installsize", 0)) for package in base.transaction.install_set),
                "installed_state_sha256": installed_digest,
                "migration_id": profile["migration_id"],
                "payloads": payloads,
                "repositories": validate_repositories(base, policy, profile),
                "schema": 1,
                "source": profile["source"],
                "target": profile["target"],
                "transaction": rows,
            }
        finally:
            base.close()
        manifest_payload = canonical_json(manifest)
        write_exclusive(staging / "manifest.json", manifest_payload, 0o600)
        return {
            "installed_state_sha256": installed_digest,
            "download_size": manifest["download_size"],
            "install_size": manifest["install_size"],
            "manifest_sha256": sha256_bytes(manifest_payload),
            "payload_count": len(payloads),
            "transaction": rows,
        }
    except BaseException:
        shutil.rmtree(staging, ignore_errors=True)
        raise


def source_releasever_path(profile: dict[str, Any]) -> pathlib.Path | None:
    expected = profile["source_releasever"]
    releasever = pathlib.Path("/etc/dnf/vars/releasever")
    if expected is None:
        for path in (releasever, pathlib.Path("/etc/yum/vars/releasever")):
            if path.exists() or path.is_symlink():
                raise AlignmentError("source release override must be absent")
        return None
    releasever_stat = releasever.lstat()
    if (
        not stat.S_ISREG(releasever_stat.st_mode)
        or releasever.is_symlink()
        or releasever_stat.st_uid != 0
        or releasever_stat.st_gid != 0
        or releasever_stat.st_mode & 0o022
        or releasever.read_text().strip() != expected
    ):
        raise AlignmentError("source release override changed after approval")
    return releasever


def command_apply(args: argparse.Namespace) -> dict[str, Any]:
    profile = transition(args.transition)
    current_release = os_release_version(profile)
    if current_release != profile["source"]:
        raise AlignmentError(
            f"transaction apply requires Rocky Linux {profile['source']}"
        )
    dnf, transaction_module = load_dnf(current_release, profile)
    staging = pathlib.Path(args.staging)
    manifest = load_manifest(staging, args.manifest_sha256)
    validate_manifest_identity(manifest, profile)
    if manifest.get("installed_state_sha256") != args.installed_state_sha256:
        raise AlignmentError("approved installed-state digest differs from the manifest")
    approved_rows = []
    for row in manifest.get("transaction", []):
        normalized = dict(row)
        if normalized["action"].endswith("-in") or normalized["action"] == "install":
            normalized["repo"] = "@approved-local"
        approved_rows.append(normalized)
    phase_started = staging / "apply-started.json"
    phase_complete = staging / "transaction-complete.json"
    lock_base = dnf.Base()
    lock_base.conf.read()
    lock_base.conf.exit_on_lock = True
    with qualified_rpmdb_lock(dnf, lock_base):
        _, current_digest = installed_state()
        if current_digest != args.installed_state_sha256:
            raise AlignmentError("installed RPM state changed after approval")
        paths = verify_payloads(staging, manifest["payloads"])
        base, local_rows = local_transaction(dnf, transaction_module, paths)
        if local_rows != approved_rows:
            base.close()
            raise AlignmentError("local-only DNF action set differs from the approved transaction")
        try:
            validate_signing_key(profile)
            releasever = source_releasever_path(profile)
        except AlignmentError:
            base.close()
            raise
        write_exclusive(
            phase_started,
            canonical_json(
                {
                    "installed_state_sha256": args.installed_state_sha256,
                    "manifest_sha256": args.manifest_sha256,
                    "migration_id": profile["migration_id"],
                    "phase": "apply-started",
                    "schema": 1,
                }
            ),
            0o600,
        )
        if releasever is not None:
            releasever.unlink()
        try:
            base.do_transaction()
        finally:
            base.close()
        write_exclusive(
            phase_complete,
            canonical_json(
                {
                    "manifest_sha256": args.manifest_sha256,
                    "migration_id": profile["migration_id"],
                    "phase": "transaction-complete",
                    "schema": 1,
                }
            ),
            0o600,
        )
    lock_base.close()
    return {"applied": True, "manifest_sha256": args.manifest_sha256}


def validate_marker_identity(
    marker: dict[str, Any], profile: dict[str, Any]
) -> None:
    if (
        marker["schema"] != 1
        or marker["migration_id"] != profile["migration_id"]
        or marker["source"] != profile["source"]
        or marker["target"] != profile["target"]
    ):
        raise AlignmentError("completion marker transition identity is invalid")
    if not re.fullmatch(r"[0-9a-f]{64}", marker["manifest_sha256"]):
        raise AlignmentError("completion marker manifest digest is invalid")
    if not isinstance(marker["running_kernel"], str) or not marker["running_kernel"]:
        raise AlignmentError("completion marker running kernel is invalid")
    if not isinstance(marker["completed_at"], str) or not re.fullmatch(
        r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z",
        marker["completed_at"],
    ):
        raise AlignmentError("completion marker timestamp is invalid")


def validate_marker(path: pathlib.Path, profile: dict[str, Any]) -> dict[str, Any]:
    if path.is_symlink() or not path.is_file():
        raise AlignmentError("completion marker is missing or unsafe")
    stat = path.stat()
    if stat.st_uid != 0 or stat.st_gid != 0 or stat.st_mode & 0o777 != 0o600:
        raise AlignmentError("completion marker ownership or mode is invalid")
    try:
        marker = json.loads(path.read_bytes())
    except json.JSONDecodeError as error:
        raise AlignmentError("completion marker is invalid JSON") from error
    if (
        not isinstance(marker, dict)
        or set(marker) != MARKER_FIELDS
        or canonical_json(marker) != path.read_bytes()
    ):
        raise AlignmentError("completion marker schema or encoding is invalid")
    validate_marker_identity(marker, profile)
    return marker


def os_release_version(profile: dict[str, Any]) -> str:
    values = {}
    for line in pathlib.Path("/etc/os-release").read_text().splitlines():
        key, separator, value = line.partition("=")
        if separator:
            values[key] = value.strip().strip('"')
    accepted = {profile["source"], profile["target"]}
    if values.get("ID") != "rocky" or values.get("VERSION_ID") not in accepted:
        releases = " or ".join(f"Rocky Linux {value}" for value in sorted(accepted))
        raise AlignmentError(f"helper accepts only {releases}")
    return values["VERSION_ID"]


def command_mark(args: argparse.Namespace) -> dict[str, Any]:
    profile = transition(args.transition)
    marker = pathlib.Path(args.marker)
    require_safe_parent(marker.parent)
    if not marker.parent.is_dir():
        raise AlignmentError("completion marker directory does not exist")
    completed_at = datetime.datetime.now(datetime.UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    payload = canonical_json(
        {
            "completed_at": completed_at,
            "manifest_sha256": args.manifest_sha256,
            "migration_id": profile["migration_id"],
            "running_kernel": os.uname().release,
            "schema": 1,
            "source": profile["source"],
            "target": profile["target"],
        }
    )
    write_exclusive(marker, payload, 0o600)
    return validate_marker(marker, profile)


def command_validate_marker(args: argparse.Namespace) -> dict[str, Any]:
    return validate_marker(
        pathlib.Path(args.marker), transition(args.transition)
    )


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser()
    commands = root.add_subparsers(dest="command", required=True)
    for name in ("inspect", "prepare"):
        command = commands.add_parser(name)
        command.add_argument(
            "--transition", choices=sorted(TRANSITIONS), default=DEFAULT_TRANSITION
        )
        command.add_argument("--policy-b64", required=True)
        if name == "prepare":
            command.add_argument("--staging", required=True)
    apply = commands.add_parser("apply")
    apply.add_argument(
        "--transition", choices=sorted(TRANSITIONS), default=DEFAULT_TRANSITION
    )
    apply.add_argument("--staging", required=True)
    apply.add_argument("--manifest-sha256", required=True)
    apply.add_argument("--installed-state-sha256", required=True)
    mark = commands.add_parser("mark")
    mark.add_argument(
        "--transition", choices=sorted(TRANSITIONS), default=DEFAULT_TRANSITION
    )
    mark.add_argument("--marker", required=True)
    mark.add_argument("--manifest-sha256", required=True)
    validate = commands.add_parser("validate-marker")
    validate.add_argument(
        "--transition", choices=sorted(TRANSITIONS), default=DEFAULT_TRANSITION
    )
    validate.add_argument("--marker", required=True)
    return root


def main() -> int:
    args = parser().parse_args()
    handlers = {
        "apply": command_apply,
        "inspect": command_inspect,
        "mark": command_mark,
        "prepare": command_prepare,
        "validate-marker": command_validate_marker,
    }
    try:
        result = handlers[args.command](args)
    except (AlignmentError, OSError, subprocess.SubprocessError) as error:
        print(f"platform-rocky-minor-alignment: {error}", file=sys.stderr)
        return 2
    except Exception as error:
        print(
            f"platform-rocky-minor-alignment: unexpected {type(error).__name__}",
            file=sys.stderr,
        )
        return 2
    sys.stdout.buffer.write(canonical_json(result))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
