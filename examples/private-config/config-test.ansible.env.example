# Copy to ../platform-private/config/config-test.ansible.env.
# Source from the platform-config repository root.
export PLATFORM_PRIVATE_CONFIG_ROOT="${PLATFORM_PRIVATE_CONFIG_ROOT:-../platform-private/config}"
export PLATFORM_CONFIG_ENVIRONMENT="config-test"
export PLATFORM_CONFIG_INVENTORY="$PLATFORM_PRIVATE_CONFIG_ROOT/inventories/config-test/hosts.yml"
export ANSIBLE_HOST_KEY_CHECKING="True"
